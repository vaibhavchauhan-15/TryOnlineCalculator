---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Agentation from '../components/Agentation.astro';

import { getLocale } from '../lib/i18n/locales';
import { ogLocale } from '../lib/i18n/seo-head';

interface Props {
  title: string;
  description: string;
  path?: string; // canonical path, e.g. "/finance/mortgage-calculator"
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  keywords?: string[]; // page-level keyword hints
  ogType?: string; // Open Graph type, defaults to "website"
  ogImage?: string; // absolute or site-relative social share image
  locale?: string; // content locale (drives <html lang> + og:locale)
  alternates?: { hreflang: string; href: string }[]; // hreflang link set
}

const {
  title,
  description,
  path = '',
  noindex = false,
  jsonLd,
  keywords = [],
  ogType = 'website',
  ogImage: ogImageProp,
  locale = 'en',
  alternates = [],
} = Astro.props;
const localeDef = getLocale(locale);
const htmlLang = localeDef?.bcp47 ?? 'en';
const htmlDir = localeDef?.dir ?? 'ltr';
const ogLocaleValue = ogLocale(htmlLang, localeDef?.defaultRegion);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://tryonlinecalculator.com';
const canonical = `${site}${path}`;
const fullTitle = title.includes('Try Online Calculator') ? title : `${title} | Try Online Calculator`;
// Use a raster PNG for social previews — most platforms don't render SVG.
const ogImage = ogImageProp
  ? (ogImageProp.startsWith('http') ? ogImageProp : `${site}${ogImageProp}`)
  : `${site}/web-app-manifest-512x512.png`;
const keywordsContent = keywords.length ? keywords.join(', ') : undefined;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WKXRCW8RFV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-WKXRCW8RFV');
    </script>

    <!-- Set theme before paint to avoid a flash. Defaults to dark. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#000000' : '#ffffff');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <!-- Preload the primary font subsets so they're ready for the first
         paint. Paired with `font-display: optional` this removes the
         font-swap reflow that made text/components shake on refresh. -->
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Calculator" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    <meta name="author" content="Try Online Calculator" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Try Online Calculator" />
    <meta property="og:locale" content={ogLocaleValue} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Try Online Calculator — free online calculators" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Try Online Calculator — free online calculators" />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <Agentation />
    <script>
      // Enhance every native <select> site-wide into a theme-aware custom dropdown.
      import '../lib/dropdown';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--color-ink);
    color: var(--color-on-primary);
    border-radius: 0 0 var(--radius-sm) 0;
  }
  .skip-link:focus { left: 0; }
  main { min-height: 60vh; }
</style>
