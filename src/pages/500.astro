---
// Root 500 fallback — detects the user's preferred locale from the URL path or
// the `locale-pref` cookie, then redirects to the localized 500 page if needed.
//
// English content is rendered as the immediate fallback so there's no blank
// page flash even before the redirect fires.

import Layout from '../layouts/Layout.astro';
import { categories } from '../lib/categories';
import { to } from '../lib/i18n/paths';
import { DEFAULT_LOCALE, enabledLocaleCodes } from '../lib/i18n/locales';
---

<Layout
  title="Something went wrong"
  description="An unexpected error occurred on our end. Please try again in a moment."
  noindex
>
  <div class="container-page errpage">
    <span class="eyebrow">500</span>
    <h1>Something went wrong</h1>
    <p>
      An unexpected error occurred on our end. It's not you — it's us. Try
      reloading the page, or head back home and pick a calculator.
    </p>
    <div class="errpage-actions">
      <button type="button" id="err-retry" class="btn btn-primary">Try again</button>
      <a href={to('/', DEFAULT_LOCALE)} class="btn btn-secondary">Back to home</a>
    </div>
    <div class="errpage-cats">
      {categories.map((c) => <a href={to(c.path, DEFAULT_LOCALE)} class="errpage-pill">{c.name}</a>)}
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ enabledLocales: enabledLocaleCodes(), defaultLocale: DEFAULT_LOCALE }}>
  // Detect locale from the current URL path or from the locale-pref cookie.
  // If a non-default locale is detected, redirect to the localized 500 page.
  (function () {
    try {
      var path = window.location.pathname;
      var segments = path.split('/').filter(Boolean);
      var localeFromPath = segments.length > 0 && enabledLocales.indexOf(segments[0]) !== -1 ? segments[0] : null;

      var cookieMatch = document.cookie.match(/(?:^|;\s*)locale-pref=([^;]*)/);
      var localePref = cookieMatch ? decodeURIComponent(cookieMatch[1]) : null;

      var targetLocale = localeFromPath || localePref || defaultLocale;

      if (targetLocale !== defaultLocale && !localeFromPath) {
        window.location.replace('/' + targetLocale + '/500');
      }
    } catch (e) {
      // Silently fail — the English 500 content is already rendered.
    }
  })();

  // Retry button
  document.getElementById('err-retry')?.addEventListener('click', function () {
    window.location.reload();
  });
</script>

<style>
  .errpage { max-width: 560px; margin: 0 auto; text-align: center; padding: 5rem 0; }
  .errpage h1 { margin: 0.75rem 0 0; font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em; }
  .errpage p { margin: 0.75rem 0 0; color: var(--color-body); font-size: 16px; }
  .errpage-actions { display: flex; flex-wrap: wrap; gap: 0.625rem; justify-content: center; margin: 1.75rem 0 1.5rem; }
  .errpage-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .errpage-pill { padding: 0.375rem 0.75rem; font-size: 13px; border: 1px solid var(--color-hairline); border-radius: var(--radius-pill); color: var(--color-body); }
  .errpage-pill:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); }
</style>
