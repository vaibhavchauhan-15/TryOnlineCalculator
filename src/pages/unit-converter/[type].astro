---
import Layout from '../../layouts/Layout.astro';
import UnitConverter from '../../components/UnitConverter.astro';
import { converters, getConverter, converterPageSchemas } from '../../lib/converters';

export function getStaticPaths() {
  return converters.map((c) => ({ params: { type: c.slug }, props: { cfg: c } }));
}

const { cfg } = Astro.props;
const path = `/unit-converter/${cfg.slug}`;
const schemas = converterPageSchemas(cfg);

// Sibling converters for cross-linking (everything except the current one).
const others = converters.filter((c) => c.slug !== cfg.slug);
---

<Layout
  title={cfg.metaTitle}
  description={cfg.metaDescription}
  path={path}
  keywords={cfg.keywords}
  jsonLd={schemas}
>
  <div class="container-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/unit-converter">Unit Converter</a><span aria-hidden="true">/</span>
      <span>{cfg.title}</span>
    </nav>

    <div class="conv-stage">
      <div class="conv-hero-text">
        <span class="eyebrow">Unit converter</span>
        <h1 class="conv-title">{cfg.title}</h1>
        <p class="conv-desc">{cfg.description}</p>
        <p class="conv-intro">{cfg.intro}</p>
      </div>

      <div class="conv-tool">
        <UnitConverter converter={cfg} />
        {cfg.note && <p class="conv-note">{cfg.note}</p>}
      </div>
    </div>

    <div class="conv-body">
      <div class="conv-content">
        <!-- About -->
        <section class="prose-section">
          <h2>About the {cfg.name.toLowerCase()} converter</h2>
          {cfg.about.map((p) => <p>{p}</p>)}
        </section>

        <!-- How to -->
        <section class="prose-section">
          <h2>How to use this {cfg.name.toLowerCase()} converter</h2>
          <ol class="howto">
            {cfg.howto.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        <!-- Conversion factor table -->
        <section class="prose-section">
          <h2>{cfg.name} conversion factors</h2>
          <p>Exact reference factors used by this converter:</p>
          <div class="factor-table">
            {cfg.factorRows.map((row) => (
              <div class="factor-row">
                <span class="factor-key">{row.label}</span>
                <span class="factor-val">{row.value}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Supported units -->
        <section class="prose-section">
          <h2>Supported {cfg.name.toLowerCase()} units</h2>
          <ul class="unit-list">
            {cfg.units.map((u) => (
              <li><span class="unit-sym">{u.symbol}</span>{u.name}</li>
            ))}
          </ul>
        </section>

        <!-- FAQ -->
        <section class="prose-section">
          <h2>Frequently asked questions</h2>
          <div class="faq">
            {cfg.faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="conv-aside">
        <div class="aside-block">
          <span class="eyebrow">Other converters</span>
          <ul class="related-list">
            {others.map((c) => (
              <li><a href={`/unit-converter/${c.slug}`}>{c.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="aside-block">
          <span class="eyebrow">All tools</span>
          <a href="/unit-converter" class="btn btn-secondary btn-sm aside-cta">Unit converter hub</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .breadcrumb { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 1.5rem; font-size: 13px; color: var(--color-mute); }
  .breadcrumb a { color: var(--color-body); }
  .breadcrumb a:hover { color: var(--color-ink); }

  /* Hero: text left, tool right on desktop; tool first on mobile so it's usable
     immediately without scrolling. */
  .conv-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding: 1.5rem 0 0;
  }
  .conv-hero-text { max-width: 52ch; }
  .conv-title { margin: 0.5rem 0 0; font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; }
  .conv-desc { margin: 1rem 0 0; font-size: clamp(15px, 2vw, 18px); line-height: 1.6; color: var(--color-body); }
  .conv-intro { margin: 1rem 0 0; font-size: 15px; line-height: 1.7; color: var(--color-mute); }

  .conv-tool { min-width: 0; position: sticky; top: 80px; }
  .conv-note {
    margin: 0.875rem 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-mute);
    padding: 0.75rem 0.875rem;
    background-color: var(--color-canvas-soft);
    border: 1px dashed var(--color-hairline-strong);
    border-radius: var(--radius-md);
  }

  @media (max-width: 900px) {
    .conv-stage { grid-template-columns: 1fr; gap: 1.5rem; }
    .conv-tool { position: static; order: -1; }
    .conv-hero-text { max-width: none; }
    .conv-intro { display: none; }
  }

  /* Body: content + sidebar */
  .conv-body { display: grid; grid-template-columns: 1fr 280px; gap: 2.5rem; margin-top: 3rem; }
  .conv-content { min-width: 0; }
  .prose-section { margin-bottom: 2.5rem; }
  .prose-section h2 { font-size: 1.375rem; letter-spacing: -0.02em; margin: 0 0 1rem; }
  .prose-section p { font-size: 15px; line-height: 1.7; color: var(--color-body); margin: 0 0 0.75rem; }

  .howto { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .howto li { font-size: 15px; line-height: 1.6; color: var(--color-body); }

  /* Factor table */
  .factor-table {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .factor-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--color-canvas);
  }
  .factor-row + .factor-row { border-top: 1px solid var(--color-hairline); }
  .factor-key { font-size: 14px; font-weight: 500; color: var(--color-ink); }
  .factor-val { font-family: var(--font-mono); font-size: 13px; color: var(--color-body); text-align: right; }

  /* Supported units */
  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.5rem;
  }
  .unit-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 14px;
    color: var(--color-body);
    padding: 0.5rem 0.75rem;
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .unit-sym {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
    background-color: var(--color-canvas);
    border-radius: var(--radius-xs);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }

  /* FAQ (mirrors the calculator page treatment) */
  .faq { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer;
    padding: 0.875rem 1rem;
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--color-mute); font-size: 18px; flex: 0 0 auto; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { margin: 0; padding: 0 1rem 1rem; font-size: 14px; line-height: 1.65; color: var(--color-body); }

  /* Sidebar */
  .conv-aside { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 80px; align-self: start; }
  .aside-block { display: flex; flex-direction: column; }
  .related-list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .related-list a { font-size: 14px; color: var(--color-link); }
  .related-list a:hover { text-decoration: underline; }
  .aside-cta { margin-top: 0.75rem; width: 100%; }

  @media (max-width: 900px) {
    .conv-body { grid-template-columns: 1fr; gap: 1.5rem; }
    .conv-aside { position: static; }
  }
</style>
