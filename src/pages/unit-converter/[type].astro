---
// Legacy unit-converter page — permanently redirects to /en/unit-converter/[type].
import { converters } from '../../lib/converters';

export function getStaticPaths() {
  return converters.map((c) => ({ params: { type: c.slug } }));
}

const { type } = Astro.params;
return Astro.redirect(`/en/unit-converter/${type}`, 301);
---
