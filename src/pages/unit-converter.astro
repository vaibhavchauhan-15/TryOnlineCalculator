---
import Layout from '../layouts/Layout.astro';
import UnitConverter from '../components/UnitConverter.astro';
import { breadcrumbSchema } from '../lib/seo';

const SITE = 'https://tryonlinecalculator.com';
const path = '/unit-converter';

const title = 'Unit Converter — Free Online Conversion Calculator';
const description =
  'Free online unit converter and conversion calculator. Instantly convert length, weight, temperature, speed, volume, area, currency and BMI — fast, accurate and no sign-up.';

const keywords = [
  'unit converter',
  'conversion calculator',
  'unit conversion',
  'length converter',
  'weight converter',
  'temperature converter',
  'speed converter',
  'volume converter',
  'area converter',
  'currency converter',
  'bmi converter',
  'metric conversion',
  'measurement converter',
];

const faqs = [
  {
    q: 'What is a unit converter?',
    a: 'A unit converter is a tool that changes a measurement from one unit into another — for example metres to feet, kilograms to pounds, or Celsius to Fahrenheit. This converter handles length, weight, temperature, speed, volume, area, currency and BMI in one place, updating the result instantly as you type.',
  },
  {
    q: 'How accurate are the conversions?',
    a: 'Physical conversions (length, weight, temperature, speed, volume and area) use the internationally defined exact factors, so results are accurate to the precision shown. Currency uses live mid-market reference rates when your connection allows, falling back to recent indicative rates otherwise; treat currency figures as approximate and for information only.',
  },
  {
    q: 'How do I convert between metric and imperial units?',
    a: 'Pick your category (such as Length or Weight), choose the unit you have on the left and the unit you want on the right, then type a value. The result appears immediately, and you can press the swap button to reverse the direction.',
  },
  {
    q: 'Is my data private?',
    a: 'Yes. Every conversion runs entirely in your browser. Your inputs are never sent to a server, there is no account, and nothing is tracked. Your most recent units and values are saved locally on your device so the tool remembers them next time.',
  },
  {
    q: 'Which currencies and exchange rates are used?',
    a: 'The currency converter supports major world currencies including USD, EUR, GBP, INR, JPY, CNY, AUD and CAD. Rates refresh from a public exchange-rate source when available; when offline, indicative rates are shown. It is meant for quick estimates, not financial transactions.',
  },
  {
    q: 'What counts as a healthy BMI?',
    a: 'The BMI tab uses the standard adult categories: below 18.5 is underweight, 18.5 to 24.9 is a normal weight, 25 to 29.9 is overweight, and 30 or above is obese. BMI is a general screening figure and does not account for muscle mass, so use it as a guide alongside other measures.',
  },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Unit Converter', path },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Unit Converter',
  url: `${SITE}${path}`,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  description,
  featureList: [
    'Length converter',
    'Weight converter',
    'Temperature converter',
    'Speed converter',
    'Volume converter',
    'Area converter',
    'Currency converter',
    'BMI calculator',
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'Try Online Calculator', url: SITE },
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Popular conversion pairs used to seed internal search intent in the copy.
const relatedTools = [
  { title: 'Percentage Calculator', href: '/math/percentage-calculator' },
  { title: 'BMI Calculator', href: '/health/bmi-calculator' },
  { title: 'Fuel Cost Calculator', href: '/travel/fuel-cost-calculator' },
  { title: 'Scientific Calculator', href: '/math/scientific-calculator' },
];
---

<Layout
  title={title}
  description={description}
  path={path}
  keywords={keywords}
  jsonLd={[breadcrumbSchema(crumbs), webAppSchema, faqPageSchema]}
>
  <div class="container-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><span>Unit Converter</span>
    </nav>

    <header class="uc-page-head">
      <span class="eyebrow">Conversion calculator</span>
      <h1 class="uc-page-title">Unit Converter</h1>
      <p class="uc-page-desc">
        Convert length, weight, temperature, speed, volume, area, currency and BMI in one fast,
        clutter-free tool. Pick a category, type a value, and see the answer instantly.
      </p>
    </header>

    <UnitConverter />

    <div class="uc-page-body">
      <div class="uc-page-content">
        <section class="prose-section">
          <h2>An all-in-one conversion calculator</h2>
          <p>
            This free online unit converter brings the eight conversions people search for most into
            a single place. Instead of opening a separate length converter, weight converter or
            currency converter each time, you switch categories with one tap and keep working. Every
            calculation happens instantly in your browser, so results update the moment you type —
            there is no button to press, no page reload and no sign-up.
          </p>
        </section>

        <section class="prose-section">
          <h2>What you can convert</h2>
          <ul class="uc-feature-list">
            <li><strong>Length converter</strong> — millimetres, centimetres, metres, kilometres, inches, feet, yards, miles and nautical miles.</li>
            <li><strong>Weight converter</strong> — milligrams, grams, kilograms, tonnes, ounces, pounds, stone and US/UK tons.</li>
            <li><strong>Temperature converter</strong> — Celsius, Fahrenheit and Kelvin, with the correct offset handling.</li>
            <li><strong>Speed converter</strong> — metres per second, kilometres per hour, miles per hour, feet per second and knots.</li>
            <li><strong>Volume converter</strong> — millilitres, litres, cubic metres, US cups, pints, quarts and both US and UK gallons.</li>
            <li><strong>Area converter</strong> — square metres, hectares, square kilometres, square feet, acres and square miles.</li>
            <li><strong>Currency converter</strong> — major world currencies using live reference rates when available.</li>
            <li><strong>BMI</strong> — body mass index from metric or imperial height and weight, with the standard health category.</li>
          </ul>
        </section>

        <section class="prose-section">
          <h2>How to use the unit converter</h2>
          <ol class="howto">
            <li>Choose a conversion type from the tabs at the top — Length, Weight, Temperature and so on.</li>
            <li>Select the unit you are converting <em>from</em> on the left and the unit you want <em>to</em> on the right.</li>
            <li>Type a number into either field. The other side updates instantly, and you can edit either one.</li>
            <li>Use the swap button to flip the direction, or the copy button to grab the result.</li>
            <li>Check the quick-conversion chips to see the same value across several other units at a glance.</li>
          </ol>
        </section>

        <section class="prose-section">
          <h2>Common conversion factors</h2>
          <p>These are the exact relationships this tool uses for the most-searched conversions:</p>
          <div class="uc-factor-grid">
            <div class="uc-factor"><span>1 inch</span><code>= 2.54 cm</code></div>
            <div class="uc-factor"><span>1 foot</span><code>= 0.3048 m</code></div>
            <div class="uc-factor"><span>1 mile</span><code>= 1.609344 km</code></div>
            <div class="uc-factor"><span>1 pound</span><code>= 0.453592 kg</code></div>
            <div class="uc-factor"><span>1 ounce</span><code>= 28.3495 g</code></div>
            <div class="uc-factor"><span>1 US gallon</span><code>= 3.785412 L</code></div>
            <div class="uc-factor"><span>1 mph</span><code>= 1.609344 km/h</code></div>
            <div class="uc-factor"><span>°F → °C</span><code>= (°F − 32) × 5/9</code></div>
            <div class="uc-factor"><span>1 acre</span><code>= 4046.86 m²</code></div>
          </div>
        </section>

        <section class="prose-section">
          <h2>Frequently asked questions</h2>
          <div class="faq">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="uc-page-aside">
        <div class="aside-block">
          <span class="eyebrow">Related tools</span>
          <ul class="related-list">
            {relatedTools.map((r) => (
              <li><a href={r.href}>{r.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="aside-block">
          <span class="eyebrow">Browse</span>
          <a href="/" class="btn btn-secondary btn-sm aside-cta">All calculators</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .breadcrumb { display: flex; gap: 0.5rem; align-items: center; margin-top: 1.5rem; font-size: 13px; color: var(--color-mute); }
  .breadcrumb a { color: var(--color-body); }
  .breadcrumb a:hover { color: var(--color-ink); }

  .uc-page-head { padding: 1.5rem 0 1.75rem; max-width: 64ch; }
  .uc-page-title { margin: 0.5rem 0 0; font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em; }
  .uc-page-desc { margin: 0.75rem 0 0; font-size: 17px; line-height: 1.6; color: var(--color-body); }

  .uc-page-body { display: grid; grid-template-columns: 1fr 280px; gap: 2.5rem; margin-top: 3rem; }
  .uc-page-content { min-width: 0; }

  .prose-section { margin-bottom: 2.5rem; }
  .prose-section h2 { font-size: 1.375rem; letter-spacing: -0.02em; margin: 0 0 1rem; }
  .prose-section p { font-size: 15px; line-height: 1.7; color: var(--color-body); }

  .uc-feature-list { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .uc-feature-list li { font-size: 15px; line-height: 1.6; color: var(--color-body); }
  .uc-feature-list strong { color: var(--color-ink); font-weight: 600; }

  .howto { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .howto li { font-size: 15px; line-height: 1.6; color: var(--color-body); }

  .uc-factor-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .uc-factor {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0.875rem;
    background-color: var(--color-canvas);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }
  .uc-factor span { font-size: 13px; font-weight: 600; color: var(--color-ink); }
  .uc-factor code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-body);
  }

  .faq { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer;
    padding: 0.875rem 1rem;
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--color-mute); font-size: 18px; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { margin: 0; padding: 0 1rem 1rem; font-size: 14px; line-height: 1.65; color: var(--color-body); }

  .uc-page-aside { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 80px; align-self: start; }
  .aside-block { display: flex; flex-direction: column; }
  .related-list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .related-list a { font-size: 14px; color: var(--color-link); }
  .related-list a:hover { text-decoration: underline; }
  .aside-cta { margin-top: 0.75rem; width: 100%; }

  @media (max-width: 900px) {
    .uc-page-body { grid-template-columns: 1fr; gap: 1.5rem; }
    .uc-page-aside { position: static; }
  }
  @media (max-width: 560px) {
    .uc-factor-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
