---
// Root homepage — client-side locale redirect for local dev.
//
// In production, the Cloudflare Pages Function (functions/index.ts) handles the
// "/" route at the edge using Accept-Language + locale-pref cookie. This page
// exists as a fallback for local `astro dev` where Pages Functions don't run.
//
// The inline script mirrors the same priority order:
//   1. locale-pref cookie (user previously chose a language)
//   2. navigator.languages (browser language preference)
//   3. fallback to /en/
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="description" content="Redirecting to your preferred language." />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://tryonlinecalculator.com/en/" />
    <script is:inline>
      (function () {
        var ENABLED = ['en', 'de', 'hi', 'es'];
        var DEFAULT = 'en';

        function getCookie(name) {
          var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
          return m ? decodeURIComponent(m[1]) : null;
        }

        // 1. Saved preference cookie
        var saved = getCookie('locale-pref');
        if (saved && ENABLED.indexOf(saved) !== -1) {
          location.replace('/' + saved + '/');
          return;
        }

        // 2. Browser language
        var langs = navigator.languages || [navigator.language];
        for (var i = 0; i < langs.length; i++) {
          var base = (langs[i] || '').toLowerCase().split('-')[0];
          if (ENABLED.indexOf(base) !== -1) {
            location.replace('/' + base + '/');
            return;
          }
        }

        // 3. Fallback
        location.replace('/' + DEFAULT + '/');
      })();
    </script>
  </head>
  <body></body>
</html>
