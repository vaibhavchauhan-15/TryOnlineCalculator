---
import Layout from '../layouts/Layout.astro';
import Search from '../components/Search.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import { categories } from '../lib/categories';
import { allCalculators, popularCalculators, calculatorsByCategory } from '../lib/calculators';
import { websiteSchema, organizationSchema, itemListSchema, faqPageSchema } from '../lib/seo';
import HomeFaq from '../components/HomeFaq.astro';
import { homeFaqItems } from '../lib/faq';

const popular = popularCalculators(8);
const total = allCalculators.length;
const featured = ['finance', 'health', 'math'] as const;

const homeKeywords = [
  'calculator',
  'online calculator',
  'calculator online',
  'free calculator',
  'calculator app',
  'scientific calculator',
  'loan calculator',
  'emi calculator',
  'mortgage calculator',
  'bmi calculator',
  'age calculator',
  'percentage calculator',
  'investment calculator',
  'sip calculator',
  'compound interest calculator',
  'interest calculator',
  'gpa calculator',
  'grade calculator',
  'calorie calculator',
  'salary calculator',
  'date calculator',
  'math solver',
  'unit converter',
];

const popularListSchema = itemListSchema(
  popular.map((c) => ({ name: c.title, path: `/${c.category}/${c.slug}` })),
);
---

<Layout
  title="Calculator — Free Online Calculator for Finance, Health & Math"
  description={`Free online calculator hub with ${total}+ fast, accurate tools: mortgage, loan/EMI, SIP, BMI, calorie, percentage, scientific, GPA, age and compound interest calculators. No sign-up required.`}
  path="/"
  keywords={homeKeywords}
  jsonLd={[websiteSchema(), organizationSchema(), popularListSchema, faqPageSchema(homeFaqItems)]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container-page hero-inner">
      <span class="hero-badge reveal" style="--i: 0">
        <span class="hero-dot" aria-hidden="true"></span>
        {total}+ calculators · always free
      </span>
      <h1 class="hero-title reveal" style="--i: 1">Every calculation,<br /><span class="mesh-text">in one place.</span></h1>
      <p class="hero-lead reveal" style="--i: 2">
        Fast, accurate calculators for finance, health, education and everyday math.
        No sign-up, no clutter — just answers.
      </p>
      <div class="hero-search reveal" style="--i: 3">
        <Search variant="hero" placeholder="Search mortgage, BMI, percentage…" />
      </div>
      <div class="hero-pills reveal" style="--i: 4">
        <span class="hero-pills-label">Popular</span>
        {popular.slice(0, 5).map((c) => (
          <a href={`/${c.category}/${c.slug}`} class="hero-pill">{c.title.replace(' Calculator', '')}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Categories — primary navigation -->
  <section class="container-page section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Browse</span>
        <h2 class="section-title">Explore by category</h2>
      </div>
    </div>
    <div class="grid-categories">
      {categories.map((c) => (
        <CategoryCard category={c} count={calculatorsByCategory(c.id).length} />
      ))}
    </div>
  </section>

  <!-- Popular -->
  <section class="container-page section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Most used</span>
        <h2 class="section-title">Popular calculators</h2>
      </div>
    </div>
    <div class="grid-cards">
      {popular.map((c) => <CalculatorCard calculator={c} />)}
    </div>
  </section>

  <!-- Featured category sections -->
  {featured.map((id) => {
    const cat = categories.find((c) => c.id === id)!;
    const calcs = calculatorsByCategory(id).slice(0, 6);
    return (
      <section class="container-page section">
        <div class="section-head">
          <div>
            <span class="eyebrow">{cat.name}</span>
            <h2 class="section-title">{cat.tagline}</h2>
          </div>
          <a href={cat.path} class="btn btn-secondary btn-sm">View all</a>
        </div>
        <div class="grid-cards">
          {calcs.map((c) => <CalculatorCard calculator={c} />)}
        </div>
      </section>
    );
  })}

  <!-- Trust band -->
  <section class="container-page section">
    <div class="trust card-lg">
      <div class="trust-item">
        <h3>Built for speed</h3>
        <p>Static pages and instant, in-browser math. Results appear the moment you type.</p>
      </div>
      <div class="trust-item">
        <h3>Private by default</h3>
        <p>Your numbers never leave your device. There is no account and nothing to sign up for.</p>
      </div>
      <div class="trust-item">
        <h3>Verified formulas</h3>
        <p>Each tool shows the formula it uses, worked examples and clear explanations.</p>
      </div>
    </div>
  </section>

  <!-- Site pages — About, Contact, Privacy, Terms -->
  <section class="container-page section">
    <div class="section-head">
      <div>
        <span class="eyebrow">More</span>
        <h2 class="section-title">About this site</h2>
      </div>
    </div>
    <div class="grid-pages">
      <a href="/about" class="page-card">
        <span class="page-card-title">About us</span>
        <span class="page-card-desc">Who we are and how our {total}+ free calculators work.</span>
        <span class="page-card-arrow" aria-hidden="true">→</span>
      </a>
      <a href="/contact" class="page-card">
        <span class="page-card-title">Contact us</span>
        <span class="page-card-desc">Report a bug or request a calculator you need.</span>
        <span class="page-card-arrow" aria-hidden="true">→</span>
      </a>
      <a href="/privacy" class="page-card">
        <span class="page-card-title">Privacy Policy</span>
        <span class="page-card-desc">Your calculator inputs never leave your device.</span>
        <span class="page-card-arrow" aria-hidden="true">→</span>
      </a>
      <a href="/terms" class="page-card">
        <span class="page-card-title">Terms &amp; Conditions</span>
        <span class="page-card-desc">The terms for using our free online tools.</span>
        <span class="page-card-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- SEO content — long-form, keyword-rich copy about the tool -->
  <section class="container-page section">
    <div class="seo-prose">
      <h2>The free online calculator for everyday math and big decisions</h2>
      <p>
        Try Online Calculator is a free online calculator hub that brings every calculation you
        need into one fast, clutter-free place. Instead of hunting for a different website every
        time, you get {total}+ purpose-built tools — from a simple online calculator for quick
        sums to a full <a href="/math/scientific-calculator">scientific calculator</a> for
        trigonometry, logarithms and exponents. It behaves like a proper calculator app right in
        your tab: no install, no download, and no account. Every calculator runs instantly in your
        browser, works on phones and desktops, and never asks you to share your data.
      </p>

      <h3>Finance, loan and mortgage calculators</h3>
      <p>
        Planning money decisions is easier with the right numbers in front of you. Use the
        <a href="/finance/mortgage-calculator">mortgage calculator</a> to estimate a monthly home
        payment with principal, interest, tax and insurance, or check what you can afford before
        you shop. The <a href="/finance/loan-calculator">loan calculator</a> doubles as an EMI
        calculator, working out the equated monthly instalment on any personal loan, while the
        <a href="/finance/auto-loan-calculator">auto loan calculator</a> and
        <a href="/finance/car-payment-calculator">car payment calculator</a> show the true cost of
        financing a vehicle, interest included. Looking further ahead? The
        <a href="/finance/investment-calculator">investment calculator</a> and
        <a href="/finance/compound-interest-calculator">compound interest calculator</a> work as an
        SIP calculator too, projecting how regular monthly deposits and compounding grow your
        savings over time, while the
        <a href="/finance/interest-calculator">interest calculator</a> shows exactly how much
        interest you pay or earn on any balance.
      </p>

      <h3>Health, BMI and calorie calculators</h3>
      <p>
        Take charge of your wellbeing with trusted health tools. The free
        <a href="/health/bmi-calculator">BMI calculator</a> tells you where your body mass index
        sits, and the <a href="/health/calorie-calculator">calorie calculator</a> and
        <a href="/health/tdee-calculator">TDEE calculator</a> estimate the daily energy you burn so
        you can plan weight loss, maintenance or gain. Pair them with the
        <a href="/health/bmr-calculator">BMR</a> and <a href="/health/macro-calculator">macro</a>
        calculators to fine-tune nutrition. Every formula follows the same equations used by
        clinicians and coaches, and each result page explains what the numbers mean.
      </p>

      <h3>Education, GPA and grade calculators</h3>
      <p>
        Students rely on our <a href="/education/gpa-calculator">GPA calculator</a> to track college
        performance, the <a href="/education/grade-calculator">grade calculator</a> to score a test
        or assignment, and the <a href="/education/final-grade-calculator">final grade calculator</a>
        to find out exactly what they need on the final exam to hit a target. It removes the
        last-minute guesswork before results day.
      </p>

      <h3>Math, dates, salary and more</h3>
      <p>
        For homework and quick checks, use our tools as a lightweight math solver: the
        <a href="/math/percentage-calculator">percentage calculator</a>,
        <a href="/math/fraction-calculator">fraction calculator</a> and
        <a href="/math/average-calculator">average calculator</a> break every step down for you.
        Need a date answer? The
        <a href="/date-time/age-calculator">age calculator</a> gives your exact age by date of
        birth, and the <a href="/date-time/date-difference-calculator">date calculator</a> and
        working-days tools measure any span between two dates. Working
        professionals use the <a href="/salary/salary-calculator">salary calculator</a> and
        <a href="/salary/paycheck-calculator">paycheck calculator</a> to convert between hourly,
        weekly, monthly and annual pay and estimate take-home earnings, while shopping tools handle
        discounts, tips and sales tax. Need to switch units instead? The all-in-one
        <a href="/unit-converter">unit converter</a> handles length, weight, temperature, speed,
        volume, area, currency and BMI in one place.
      </p>

      <p>
        Whether you need a scientific calculator, a mortgage calculator, a percentage calculator or
        a simple free calculator for everyday sums, everything here is fast, accurate and free to
        use. Bookmark Try Online Calculator and keep the calculator you need one click away.
      </p>
    </div>
  </section>

  <!-- FAQ — SEO-friendly, JSON-LD FAQPage schema injected via Layout -->
  <HomeFaq />
</Layout>

<style>
  /* ---------- Hero band ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4rem, 9vw, 7.5rem) 0 clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft);
  }

  /* Atmospheric mesh gradient — hero scale only, faded out with a radial
     mask so it reads as light behind the type rather than a hard band.
     Slowly drifts + breathes via a single GPU-friendly transform/opacity
     animation (no layout work, no paint of new pixels). */
  .hero-glow {
    position: absolute;
    inset: -35% -20% auto -20%;
    height: 160%;
    z-index: -2;
    pointer-events: none;
    will-change: transform, opacity;
    transform: translateZ(0);
    background-image:
      radial-gradient(32% 55% at 16% 4%, color-mix(in oklab, var(--color-grad-develop-start) 55%, transparent), transparent 72%),
      radial-gradient(28% 50% at 36% 0%, color-mix(in oklab, var(--color-cyan) 48%, transparent), transparent 72%),
      radial-gradient(32% 55% at 54% 6%, color-mix(in oklab, var(--color-grad-preview-start) 46%, transparent), transparent 72%),
      radial-gradient(30% 52% at 72% 0%, color-mix(in oklab, var(--color-grad-preview-end) 48%, transparent), transparent 72%),
      radial-gradient(34% 55% at 90% 6%, color-mix(in oklab, var(--color-grad-ship-end) 46%, transparent), transparent 72%);
    -webkit-mask-image: radial-gradient(115% 90% at 50% -8%, #000 32%, transparent 76%);
    mask-image: radial-gradient(115% 90% at 50% -8%, #000 32%, transparent 76%);
    opacity: 0.85;
    animation: hero-drift 22s ease-in-out infinite alternate;
  }
  :global(html[data-theme='dark']) .hero-glow { opacity: 0.55; }

  @keyframes hero-drift {
    0%   { transform: translate3d(-3%, -1%, 0) scale(1);     opacity: var(--glow-lo, 0.75); }
    50%  { transform: translate3d(2%, 1.5%, 0) scale(1.08);  opacity: var(--glow-hi, 0.9); }
    100% { transform: translate3d(4%, -1%, 0) scale(1.04);   opacity: var(--glow-lo, 0.75); }
  }
  :global(html[data-theme='dark']) .hero { --glow-lo: 0.45; --glow-hi: 0.62; }

  /* Faint moving grid — pure CSS mask + background, animated by
     background-position only (cheap, composited). */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-hairline-strong) 45%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-hairline-strong) 45%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(120% 80% at 50% 0%, #000 0%, transparent 62%);
    mask-image: radial-gradient(120% 80% at 50% 0%, #000 0%, transparent 62%);
    opacity: 0.5;
    animation: hero-grid-pan 28s linear infinite;
  }
  :global(html[data-theme='dark']) .hero-grid { opacity: 0.35; }

  @keyframes hero-grid-pan {
    0%   { background-position: 0 0, 0 0; }
    100% { background-position: 56px 56px, 56px 56px; }
  }

  .hero-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }

  /* Staggered entrance for hero content. Falls back to fully-visible
     final state under prefers-reduced-motion (global rule zeroes the
     duration, snapping straight to the last keyframe). */
  .reveal {
    animation: hero-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(0.08s * var(--i, 0));
  }
  @keyframes hero-reveal {
    from { opacity: 0; transform: translate3d(0, 14px, 0); filter: blur(6px); }
    to   { opacity: 1; transform: translate3d(0, 0, 0); filter: blur(0); }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 4px 12px;
    font-size: 13px;
    color: var(--color-body);
    background-color: color-mix(in srgb, var(--color-canvas) 70%, transparent);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    backdrop-filter: blur(6px);
    border-radius: var(--radius-pill);
  }
  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-cyan);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-cyan) 25%, transparent);
    animation: hero-pulse 2.4s ease-in-out infinite;
  }
  @keyframes hero-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-cyan) 45%, transparent); }
    50%      { box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-cyan) 0%, transparent); }
  }

  .hero-title {
    margin: 1.5rem 0 0;
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 600;
  }
  /* Animated flowing gradient on the accent line. Widen the gradient and
     pan its position so the mesh appears to move through the letters. */
  .hero-title .mesh-text {
    display: inline-block;
    padding-bottom: 0.08em;
    background-size: 220% 100%;
    animation: mesh-flow 8s ease-in-out infinite alternate;
  }
  @keyframes mesh-flow {
    0%   { background-position: 0% 50%; }
    100% { background-position: 100% 50%; }
  }

  .hero-lead {
    margin: 1.25rem 0 0;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    line-height: 1.55;
    color: var(--color-body);
    max-width: 48ch;
  }

  .hero-search {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-top: 2.25rem;
  }
  /* Soft animated gradient halo that blooms in when the search is focused. */
  .hero-search::before {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -1;
    border-radius: calc(var(--radius-md) + 4px);
    background: linear-gradient(
      100deg,
      var(--color-grad-develop-start),
      var(--color-grad-develop-end),
      var(--color-grad-preview-start),
      var(--color-grad-preview-end),
      var(--color-grad-ship-end)
    );
    background-size: 220% 100%;
    opacity: 0;
    filter: blur(10px);
    transition: opacity 0.35s ease;
    animation: mesh-flow 8s ease-in-out infinite alternate;
  }
  .hero-search:focus-within::before { opacity: 0.55; }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .hero-pills-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-mute);
    margin-right: 0.25rem;
  }
  .hero-pill {
    padding: 0.375rem 0.875rem;
    font-size: 13px;
    color: var(--color-body);
    background-color: var(--color-canvas);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-pill);
    transition: color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hero-pill:hover { color: var(--color-ink); box-shadow: var(--shadow-soft); transform: translateY(-1px); }

  @media (max-width: 520px) {
    .hero-pills-label { width: 100%; text-align: center; margin: 0 0 0.25rem; }
  }

  .section { padding-top: 3.5rem; }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .section-title { margin: 0.375rem 0 0; font-size: clamp(1.375rem, 3vw, 1.75rem); letter-spacing: -0.02em; }

  .grid-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .grid-categories { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }

  .trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding: 2rem; }
  .trust-item h3 { font-size: 16px; margin: 0 0 0.375rem; }
  .trust-item p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--color-mute); }

  /* ---------- Site pages grid ---------- */
  .grid-pages { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .page-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem;
    background-color: var(--color-canvas);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-md);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .page-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-soft); }
  .page-card-title { font-size: 15px; font-weight: 600; color: var(--color-ink); letter-spacing: -0.01em; }
  .page-card-desc { font-size: 13px; line-height: 1.5; color: var(--color-mute); }
  .page-card-arrow {
    margin-top: 0.25rem;
    font-size: 15px;
    color: var(--color-mute);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .page-card:hover .page-card-arrow { color: var(--color-ink); transform: translateX(3px); }

  /* ---------- Long-form SEO copy ---------- */
  .seo-prose { max-width: 72ch; }
  .seo-prose h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .seo-prose h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    margin: 1.75rem 0 0.5rem;
  }
  .seo-prose p {
    margin: 0 0 1rem;
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-body);
  }
  .seo-prose a { color: var(--color-link); }
  .seo-prose a:hover { text-decoration: underline; }

  @media (max-width: 960px) {
    .grid-cards { grid-template-columns: repeat(2, 1fr); }
    .grid-categories { grid-template-columns: repeat(2, 1fr); }
    .grid-pages { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .trust { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 460px) {
    .grid-cards { grid-template-columns: 1fr; }
    .grid-categories { grid-template-columns: 1fr; }
    .grid-pages { grid-template-columns: 1fr; }
  }
</style>
