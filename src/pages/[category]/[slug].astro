---
// Legacy calculator page — permanently redirects to /en/[category]/[slug].
// In production Cloudflare Pages handles this via public/_redirects at the edge;
// this file ensures the redirect works in local dev too.
import { allCalculators } from '../../lib/calculators';

export function getStaticPaths() {
  return allCalculators.map((c) => ({
    params: { category: c.category, slug: c.slug },
  }));
}

const { category, slug } = Astro.params;
return Astro.redirect(`/en/${category}/${slug}`, 301);
---
