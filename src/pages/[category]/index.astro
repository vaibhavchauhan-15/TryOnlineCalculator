---
// Legacy category index — permanently redirects to /en/[category].
// In production Cloudflare Pages handles this via public/_redirects at the edge;
// this file ensures the redirect works in local dev too.
import { categories } from '../../lib/categories';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.id } }));
}

const { category } = Astro.params;
return Astro.redirect(`/en/${category}`, 301);
---
