---
// Localized 500 page — rendered for each enabled locale.
//
// SEO: noindex (error pages should never be indexed), proper <html lang>,
// localized meta description. Provides a retry button and a link back to
// the localized home page.

import Layout from '../../layouts/Layout.astro';
import { enabledLocaleCodes } from '../../lib/i18n/locales';
import { uiPack, categoryName } from '../../lib/i18n/ui-pack';
import { to } from '../../lib/i18n/paths';
import { categories } from '../../lib/categories';

export function getStaticPaths() {
  return enabledLocaleCodes().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: string };
const errors = uiPack(locale).errors ?? {};

const title = errors['500Title'] ?? 'Something went wrong';
const heading = errors['500Heading'] ?? 'Something went wrong';
const description = errors['500Description'] ?? 'An unexpected error occurred on our end. Please try again in a moment.';
const retry = errors['500Retry'] ?? 'Try again';
const backHome = errors['500BackHome'] ?? 'Back to home';
---

<Layout
  title={title}
  description={description}
  path={`/${locale}/500`}
  locale={locale}
  noindex
>
  <div class="container-page errpage">
    <span class="eyebrow">500</span>
    <h1>{heading}</h1>
    <p>{description}</p>
    <div class="errpage-actions">
      <button type="button" id="err-retry" class="btn btn-primary">{retry}</button>
      <a href={to('/', locale)} class="btn btn-secondary">{backHome}</a>
    </div>
    <div class="errpage-cats">
      {categories.map((c) => (
        <a href={to(c.path, locale)} class="errpage-pill">
          {categoryName(locale, c.id)}
        </a>
      ))}
    </div>
  </div>
</Layout>

<script is:inline>
  document.getElementById('err-retry')?.addEventListener('click', function () {
    window.location.reload();
  });
</script>

<style>
  .errpage { max-width: 560px; margin: 0 auto; text-align: center; padding: 5rem 0; }
  .errpage h1 { margin: 0.75rem 0 0; font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em; }
  .errpage p { margin: 0.75rem 0 0; color: var(--color-body); font-size: 16px; }
  .errpage-actions { display: flex; flex-wrap: wrap; gap: 0.625rem; justify-content: center; margin: 1.75rem 0 1.5rem; }
  .errpage-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .errpage-pill { padding: 0.375rem 0.75rem; font-size: 13px; border: 1px solid var(--color-hairline); border-radius: var(--radius-pill); color: var(--color-body); }
  .errpage-pill:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); }
</style>
