---
// Localized 404 page — rendered for each enabled locale.
//
// SEO: noindex (error pages should never be indexed), proper <html lang>,
// canonical to the locale's 404, and localized meta description so crawlers
// understand the page's language context.

import Layout from '../../layouts/Layout.astro';
import Search from '../../components/Search.astro';
import { enabledLocaleCodes } from '../../lib/i18n/locales';
import { uiPack, categoryName } from '../../lib/i18n/ui-pack';
import { to } from '../../lib/i18n/paths';
import { categories } from '../../lib/categories';

export function getStaticPaths() {
  return enabledLocaleCodes().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: string };
const errors = uiPack(locale).errors ?? {};

const title = errors['404Title'] ?? 'Page not found';
const heading = errors['404Heading'] ?? "We couldn't find that page";
const description = errors['404Description'] ?? 'The page you were looking for could not be found.';
const searchPrompt = errors['404SearchPrompt'] ?? 'Try searching for it below.';
const backHome = errors['404BackHome'] ?? 'Back to home';
---

<Layout
  title={title}
  description={description}
  path={`/${locale}/404`}
  locale={locale}
  noindex
>
  <div class="container-page notfound">
    <span class="eyebrow">404</span>
    <h1>{heading}</h1>
    <p>{description} {searchPrompt}</p>
    <div class="notfound-search"><Search variant="hero" /></div>
    <div class="notfound-cats">
      {categories.map((c) => (
        <a href={to(c.path, locale)} class="notfound-pill">
          {categoryName(locale, c.id)}
        </a>
      ))}
    </div>
    <a href={to('/', locale)} class="btn btn-primary">{backHome}</a>
  </div>
</Layout>

<style>
  .notfound { max-width: 560px; margin: 0 auto; text-align: center; padding: 5rem 0; }
  .notfound h1 { margin: 0.75rem 0 0; font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em; }
  .notfound p { margin: 0.75rem 0 0; color: var(--color-body); font-size: 16px; }
  .notfound-search { margin: 1.75rem 0 1.25rem; }
  .notfound-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 2rem; }
  .notfound-pill { padding: 0.375rem 0.75rem; font-size: 13px; border: 1px solid var(--color-hairline); border-radius: var(--radius-pill); color: var(--color-body); }
  .notfound-pill:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); }
</style>
