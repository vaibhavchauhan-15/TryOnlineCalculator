---
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import SeoInternalLinks from '../../components/SeoInternalLinks.astro';
import { faqPageSchema } from '../../lib/seo';
import { staticPageHreflang } from '../../lib/i18n/seo-head';
import type { FaqItem } from '../../lib/types';

const faqs: FaqItem[] = [
  {
    q: 'Does Try Online Calculator store the numbers I enter?',
    a: 'No. All calculators run locally in your browser, so the values you enter are processed on your device and are never sent to or stored on our servers.',
  },
  {
    q: 'Do you sell my data?',
    a: 'No. We do not sell your data or use the numbers you type to build advertising profiles.',
  },
  {
    q: 'Do you use cookies?',
    a: 'We use local storage only to remember preferences such as your unit choices, plus privacy-respecting, aggregate analytics to see which calculators are popular. This data is anonymised.',
  },
  {
    q: 'Is the site safe to use without an account?',
    a: 'Yes. There is no account to create and nothing to sign up for. You can use every calculator anonymously.',
  },
];

const keywords = [
  'try online calculator privacy policy',
  'calculator privacy',
  'data privacy',
  'no data stored',
];
---

<Layout
  title="Privacy Policy — How Try Online Calculator Protects Your Data"
  description="Privacy policy for Try Online Calculator. Your calculator inputs stay on your device — we never send or store your numbers. No account needed, no data sold."
  path="/en/privacy"
  locale="en"
  alternates={staticPageHreflang('privacy')}
  keywords={keywords}
  jsonLd={faqPageSchema(faqs)}
>
  <div class="container-page prose">
    <h1>Privacy Policy</h1>
    <p class="prose-meta">Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>

    <h2>Your calculations stay on your device</h2>
    <p>All calculators run locally in your browser. The numbers you enter are processed on your device and are never sent to or stored on our servers.</p>

    <h2>Analytics</h2>
    <p>We may use privacy-respecting, aggregate analytics to understand which calculators are popular and how the site performs. This data is anonymised and never tied to the values you type into a calculator.</p>

    <h2>Cookies &amp; local storage</h2>
    <p>We use local storage only to remember preferences such as your unit choices. We do not sell your data or use it for advertising profiles.</p>

    <h2>Third-party links</h2>
    <p>Some pages may link to external sites. We are not responsible for the privacy practices of those sites.</p>

    <h2>Contact</h2>
    <p>Questions about privacy? Reach us through the <a class="link" href="/contact">contact page</a>.</p>

    <FaqAccordion items={faqs} title="Privacy FAQ" />

    <SeoInternalLinks locale="en" />
  </div>
</Layout>
