---
import Layout from '../layouts/Layout.astro';
import Search from '../components/Search.astro';
import { categories } from '../lib/categories';
---

<Layout title="Page not found" description="The page you were looking for could not be found." noindex>
  <div class="container-page notfound">
    <span class="eyebrow">404</span>
    <h1>We couldn't find that page</h1>
    <p>The calculator or page you were looking for may have moved. Try searching for it below.</p>
    <div class="notfound-search"><Search variant="hero" /></div>
    <div class="notfound-cats">
      {categories.map((c) => <a href={c.path} class="notfound-pill">{c.name}</a>)}
    </div>
    <a href="/" class="btn btn-primary">Back to home</a>
  </div>
</Layout>

<style>
  .notfound { max-width: 560px; margin: 0 auto; text-align: center; padding: 5rem 0; }
  .notfound h1 { margin: 0.75rem 0 0; font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.03em; }
  .notfound p { margin: 0.75rem 0 0; color: var(--color-body); font-size: 16px; }
  .notfound-search { margin: 1.75rem 0 1.25rem; }
  .notfound-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 2rem; }
  .notfound-pill { padding: 0.375rem 0.75rem; font-size: 13px; border: 1px solid var(--color-hairline); border-radius: var(--radius-pill); color: var(--color-body); }
  .notfound-pill:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); }
</style>
