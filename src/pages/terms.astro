---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { faqPageSchema } from '../lib/seo';
import type { FaqItem } from '../lib/types';

const faqs: FaqItem[] = [
  {
    q: 'Are the calculator results professional advice?',
    a: 'No. The calculators produce estimates for general information only and must not be relied upon as financial, medical, tax, legal or other professional advice. Always confirm important decisions with a qualified professional.',
  },
  {
    q: 'Are the results guaranteed to be correct?',
    a: 'We strive for accuracy and show the formula behind each tool, but the site is provided "as is" without warranties, and we do not guarantee every result is free of error. You use the tools at your own risk.',
  },
  {
    q: 'Can I use these calculators for commercial purposes?',
    a: 'You are welcome to use the tools for everyday and work-related calculations. You agree not to misuse the site, disrupt it, or scrape it in a way that degrades service for others.',
  },
  {
    q: 'Do the terms change?',
    a: 'We may update these terms from time to time. Continued use of the site means you accept the current terms.',
  },
];

const keywords = [
  'try online calculator terms',
  'terms and conditions',
  'calculator disclaimer',
  'terms of use',
];
---

<Layout
  title="Terms & Conditions"
  description="The terms and conditions for using Try Online Calculator's free online tools."
  path="/terms"
  keywords={keywords}
  jsonLd={faqPageSchema(faqs)}
>
  <div class="container-page prose">
    <h1>Terms &amp; Conditions</h1>
    <p class="prose-meta">Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>

    <h2>Estimates only</h2>
    <p>The calculators and content on this site are provided for general informational purposes. They produce estimates and must not be relied upon as financial, medical, tax, legal or other professional advice.</p>

    <h2>No warranty</h2>
    <p>We provide the site "as is" without warranties of any kind. While we strive for accuracy, we do not guarantee that every result is free of error. You use the tools at your own risk.</p>

    <h2>Limitation of liability</h2>
    <p>To the fullest extent permitted by law, Try Online Calculator is not liable for any loss or damage arising from your use of, or reliance on, this site.</p>

    <h2>Acceptable use</h2>
    <p>You agree not to misuse the site, attempt to disrupt it, or scrape it in a way that degrades service for others.</p>

    <h2>Changes</h2>
    <p>We may update these terms from time to time. Continued use of the site means you accept the current terms.</p>

    <FaqAccordion items={faqs} title="Terms FAQ" />
  </div>
</Layout>
