---
import type { Category } from '../lib/types';
import LinkCard from './LinkCard.astro';

interface Props {
  category: Category;
  count?: number;
}
const { category, count } = Astro.props;
---

<LinkCard
  href={category.path}
  title={category.name}
  desc={category.tagline}
  icon={category.icon}
  cta="Explore"
  badge={count}
/>
