---
// Visual fraction calculator: two stacked fractions, an operation selector
// and a live simplified result (fraction, mixed number and decimal).
import CalculateButton from './CalculateButton.astro';

interface Props {
  storeKey?: string;
}
const { storeKey } = Astro.props;
---

<div class="calc-device is-wide fraction" data-fraction data-store={storeKey ? `fraction:${storeKey}` : undefined}>
  <div class="fraction-row">
    <div class="frac-input" aria-label="First fraction">
      <input class="frac-field" data-n1 type="text" inputmode="numeric" placeholder="1" aria-label="Numerator 1" />
      <span class="frac-bar"></span>
      <input class="frac-field" data-d1 type="text" inputmode="numeric" placeholder="2" aria-label="Denominator 1" />
    </div>

    <div class="frac-ops" role="group" aria-label="Operation">
      <button type="button" class="calc-key key-op frac-op" data-op="add" aria-pressed="true">+</button>
      <button type="button" class="calc-key key-op frac-op" data-op="sub" aria-pressed="false">&#8722;</button>
      <button type="button" class="calc-key key-op frac-op" data-op="mul" aria-pressed="false">&#215;</button>
      <button type="button" class="calc-key key-op frac-op" data-op="div" aria-pressed="false">&#247;</button>
    </div>

    <div class="frac-input" aria-label="Second fraction">
      <input class="frac-field" data-n2 type="text" inputmode="numeric" placeholder="1" aria-label="Numerator 2" />
      <span class="frac-bar"></span>
      <input class="frac-field" data-d2 type="text" inputmode="numeric" placeholder="3" aria-label="Denominator 2" />
    </div>

    <span class="frac-equals" aria-hidden="true">=</span>

    <div class="frac-result" data-frac-result aria-live="polite">
      <div class="frac-input frac-output">
        <span class="frac-out-n" data-out-n>&#8212;</span>
        <span class="frac-bar"></span>
        <span class="frac-out-d" data-out-d>&#8212;</span>
      </div>
    </div>
  </div>

  <div class="frac-meta">
    <div class="frac-meta-item"><span class="eyebrow">Decimal</span><span data-out-dec>&#8212;</span></div>
    <div class="frac-meta-item"><span class="eyebrow">Mixed</span><span data-out-mixed>&#8212;</span></div>
  </div>

  <div class="calc-copy-row">
    <button type="button" class="calc-copy-action" data-copy-btn aria-label="Copy result" title="Copy result">
      <span data-copy-ico><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></span>
      <span data-copy-txt>Copy result</span>
    </button>
  </div>

  <p class="frac-error" data-frac-error hidden></p>

  <CalculateButton />

  <div data-history-mount></div>
</div>

<script>
  import { gcd } from '../lib/calculators/_expr';
  import { number } from '../lib/format';
  import { loadState, saveState } from '../lib/storage';
  import { createHistoryUI, copyWithFeedback, wireCalculateButton } from '../lib/history';

  type Saved = { n1: string; d1: string; n2: string; d2: string; op: string };

  function mount(root: HTMLElement): void {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const n1 = q<HTMLInputElement>('[data-n1]');
    const d1 = q<HTMLInputElement>('[data-d1]');
    const n2 = q<HTMLInputElement>('[data-n2]');
    const d2 = q<HTMLInputElement>('[data-d2]');
    const outN = q('[data-out-n]');
    const outD = q('[data-out-d]');
    const outDec = q('[data-out-dec]');
    const outMixed = q('[data-out-mixed]');
    const errEl = q('[data-frac-error]');
    const resultBox = q('[data-frac-result]');
    const store = root.dataset.store;
    let op = 'add';

    const OP_SYMBOL: Record<string, string> = { add: '+', sub: '\u2212', mul: '\u00D7', div: '\u00F7' };

    // History panel + copy control.
    const historyMount = root.querySelector<HTMLElement>('[data-history-mount]');
    const history = historyMount && store ? createHistoryUI({ key: store, mount: historyMount }) : null;
    const copyBtn = root.querySelector<HTMLElement>('[data-copy-btn]');
    let currentResult = '';
    let currentExpr = '';
    copyBtn?.addEventListener('click', () => copyWithFeedback(copyBtn, currentResult));
    // Save the current result to history (only fires on Calculate click).
    const commit = () => (currentResult ? (history?.record(currentExpr, currentResult) ?? false) : false);

    const persist = () => {
      if (store) saveState(store, { n1: n1.value, d1: d1.value, n2: n2.value, d2: d2.value, op } satisfies Saved);
    };

    function activate(value: string): void {
      op = value;
      root.querySelectorAll<HTMLButtonElement>('.frac-op').forEach((b) => {
        const on = b.dataset.op === value;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
    }

    const fields = [n1, d1, n2, d2];

    function update(): void {
      persist();
      const raws = fields.map((el) => el.value.trim());
      // Number() rejects trailing junk (e.g. "3x"), so typos are flagged
      // rather than silently truncated the way parseFloat would.
      const vals = raws.map((r) => (r === '' ? NaN : Number(r)));
      fields.forEach((el, i) => el.classList.toggle('is-invalid', raws[i] !== '' && !Number.isFinite(vals[i])));

      const showError = (msg: string) => {
        currentResult = '';
        errEl.textContent = msg;
        errEl.hidden = false;
        resultBox.style.opacity = '0.35';
      };
      const neutral = () => {
        currentResult = '';
        errEl.hidden = true;
        resultBox.style.opacity = '0.35';
        outN.textContent = '\u2014';
        outD.textContent = '\u2014';
        outDec.textContent = '\u2014';
        outMixed.textContent = '\u2014';
      };

      // Nothing typed yet: prompt without shouting an error.
      if (raws.every((r) => r === '')) return neutral();
      // Some boxes still blank or hold non-numbers.
      if (raws.some((r, i) => r === '' || !Number.isFinite(vals[i]))) {
        return showError('Enter a whole number in every box.');
      }
      const [a, b, c, e] = vals;
      if (vals.some((v) => !Number.isInteger(v))) {
        return showError('Use whole numbers only (no decimals).');
      }
      if (b === 0 || e === 0) return showError('Denominators cannot be zero.');
      if (op === 'div' && c === 0) return showError('Cannot divide by a fraction equal to zero.');

      let num: number, den: number;
      switch (op) {
        case 'sub': num = a * e - c * b; den = b * e; break;
        case 'mul': num = a * c; den = b * e; break;
        case 'div': num = a * e; den = b * c; break;
        default: num = a * e + c * b; den = b * e;
      }
      if (den < 0) { num = -num; den = -den; }
      const g = gcd(num, den);
      const sn = num / g, sd = den / g;

      errEl.hidden = true;
      resultBox.style.opacity = '1';
      outN.textContent = String(sn);
      outD.textContent = String(sd);
      outDec.textContent = number(num / den, 10);
      currentResult = sd === 1 ? String(sn) : `${sn}/${sd}`;
      currentExpr = `${a}/${b} ${OP_SYMBOL[op] ?? '+'} ${c}/${e}`;

      const whole = Math.trunc(sn / sd);
      const rem = Math.abs(sn % sd);
      outMixed.textContent = whole !== 0 && rem !== 0 ? `${whole} ${rem}/${sd}` : '\u2014';
    }

    [n1, d1, n2, d2].forEach((el) => el.addEventListener('input', update));
    root.querySelectorAll<HTMLButtonElement>('.frac-op').forEach((btn) => {
      btn.addEventListener('click', () => {
        activate(btn.dataset.op!);
        update();
      });
    });
    // History is recorded only when the user presses Calculate.
    wireCalculateButton(root, () => {
      update();
      return commit();
    });

    // Restore a previous session, otherwise default to addition.
    const saved = store ? loadState<Saved>(store) : null;
    if (saved) {
      n1.value = saved.n1 ?? '';
      d1.value = saved.d1 ?? '';
      n2.value = saved.n2 ?? '';
      d2.value = saved.d2 ?? '';
      activate(typeof saved.op === 'string' ? saved.op : 'add');
    } else {
      activate('add');
    }
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-fraction]').forEach(mount);
</script>

<style>
  .fraction { gap: 1.5rem; }
  .fraction-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .frac-input {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem;
  }
  .frac-field {
    width: 76px;
    height: 52px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .frac-field:focus { outline: none; box-shadow: inset 0 0 0 2px var(--color-link); }
  .frac-field.is-invalid { box-shadow: inset 0 0 0 2px var(--color-error); }
  .frac-bar { width: 76px; height: 3px; border-radius: 2px; background-color: var(--color-ink); }

  .frac-ops { display: grid; grid-template-columns: 1fr 1fr; gap: 0.375rem; }
  .frac-op { min-height: 40px; min-width: 40px; }

  .frac-equals { font-size: 28px; font-weight: 600; color: var(--color-mute); }

  .frac-output { padding: 0.5rem 1rem; background-color: var(--color-canvas-soft); border-radius: var(--radius-md); }
  .frac-out-n, .frac-out-d {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 700;
    color: var(--color-link-deep);
    min-width: 40px;
    text-align: center;
  }

  .frac-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .frac-meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0.75rem 1rem;
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--color-ink);
    word-break: break-all;
  }

  .frac-error {
    margin: 0;
    padding: 0.75rem 1rem;
    font-size: 14px;
    color: var(--color-error);
    background-color: var(--color-error-soft);
    border-radius: var(--radius-md);
    text-align: center;
  }

  @media (max-width: 520px) {
    .frac-field, .frac-bar { width: 60px; }
    .frac-equals { width: 100%; text-align: center; }
  }
</style>
