---
// SeoInternalLinks — a contextual internal linking block for pages with
// otherwise thin link profiles (static pages, 404, etc.). Displays popular
// calculators and category links to distribute crawl equity and help search
// engines discover deep pages from thin-link surfaces.
import { categories } from '../lib/categories';
import { popularCalculators } from '../lib/calculators';
import { categoryName } from '../lib/i18n/ui-pack';
import { to } from '../lib/i18n/paths';

interface Props {
  locale?: string;
  title?: string;
  maxCalcs?: number;
}

const { locale = 'en', title, maxCalcs = 8 } = Astro.props;
const popular = popularCalculators(maxCalcs);
const heading = title ?? (locale === 'de' ? 'Beliebte Rechner' : 'Popular calculators');
const catHeading = locale === 'de' ? 'Kategorien durchsuchen' : 'Browse by category';
---

<section class="seo-links" aria-label={heading}>
  <div class="seo-links-group">
    <h2 class="seo-links-heading">{heading}</h2>
    <ul class="seo-links-list">
      {popular.map((c) => (
        <li><a href={to(`/${c.category}/${c.slug}`, locale)}>{c.title}</a></li>
      ))}
    </ul>
  </div>
  <div class="seo-links-group">
    <h2 class="seo-links-heading">{catHeading}</h2>
    <div class="seo-links-pills">
      {categories.map((c) => (
        <a href={to(c.path, locale)} class="seo-pill">{categoryName(locale, c.id)}</a>
      ))}
      <a href={to('/unit-converter', locale)} class="seo-pill">{locale === 'de' ? 'Einheitenumrechner' : 'Unit Converter'}</a>
    </div>
  </div>
</section>

<style>
  .seo-links {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-hairline);
  }
  .seo-links-group + .seo-links-group { margin-top: 1.75rem; }
  .seo-links-heading {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }
  .seo-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }
  .seo-links-list a {
    font-size: 14px;
    color: var(--color-link);
    display: block;
    padding: 0.375rem 0;
  }
  .seo-links-list a:hover { text-decoration: underline; }
  .seo-links-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .seo-pill {
    padding: 0.375rem 0.875rem;
    font-size: 13px;
    color: var(--color-body);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .seo-pill:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); }
</style>
