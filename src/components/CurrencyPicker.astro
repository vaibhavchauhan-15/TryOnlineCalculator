---
// Reusable, searchable currency picker.
//
// Renders a trigger button + a floating panel (search box + currency list). The
// controller in src/lib/currency-picker.ts enhances it: filtering, keyboard
// nav, fixed-position floating (so it never gets clipped or overlaps result
// cards), and value events. It is store-agnostic — bind it to the global
// display currency or a local value via the `cur:change` / `cur:set` events.
import { CURRENCIES } from '../lib/currency';

interface Props {
  /** Initial selected currency code. */
  value?: string;
  /** 'chip' = compact pill (calculators); 'field' = full-width control (converter). */
  variant?: 'chip' | 'field';
  /** Accessible label for the trigger. */
  label?: string;
  /** Role marker attribute (e.g. data-uc-from) so hosts can target this picker. */
  role?: string;
}

const { value: val = 'USD', variant: vnt = 'chip', label: lbl = 'Currency', role: roleAttr } = Astro.props;

// Stable id base for aria wiring; unique per instance.
const uid = `curp-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={['curp', `curp--${vnt}`]}
  data-currency-picker
  data-value={val}
  {...(roleAttr ? { [roleAttr]: '' } : {})}
>
  <button
    type="button"
    class="curp-trigger"
    id={`${uid}-btn`}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={lbl}
  >
    <svg class="curp-glyph" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M14.8 9a2.5 2.5 0 0 0-2.3-1.5h-.8a2.2 2.2 0 0 0-.6 4.3l2.6.8a2.2 2.2 0 0 1-.6 4.4h-.8A2.5 2.5 0 0 1 9.2 15"></path>
      <path d="M12 6v1.5"></path><path d="M12 16.5V18"></path>
    </svg>
    <span class="curp-value">{val}</span>
    <svg class="curp-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div class="curp-pop" hidden role="dialog" aria-label={`${lbl} — search`}>
    <div class="curp-pop-head">
      <span class="curp-pop-title">{lbl}</span>
      <span class="curp-pop-note">Changes how results are shown</span>
    </div>
    <div class="curp-search-wrap">
      <svg class="curp-search-ico" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        type="text"
        class="curp-search"
        role="combobox"
        aria-expanded="true"
        aria-autocomplete="list"
        aria-controls={`${uid}-list`}
        placeholder="Search currency or country…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <ul class="curp-list" id={`${uid}-list`} role="listbox" aria-label={lbl}>
      {CURRENCIES.map((c, i) => (
        <li
          class="curp-opt"
          id={`${uid}-opt-${i}`}
          role="option"
          data-code={c.code}
          data-trigger={`${c.code} ${c.symbol}`}
          aria-selected={c.code === val ? 'true' : 'false'}
          style={`order:${i}`}
        >
          <span class="curp-opt-sym" aria-hidden="true">{c.symbol}</span>
          <span class="curp-opt-code">{c.code}</span>
          <span class="curp-opt-name">{c.name}</span>
          <svg class="curp-opt-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </li>
      ))}
    </ul>
    <div class="curp-empty" hidden>No matching currency</div>
  </div>
</div>

<style>
  .curp { position: relative; min-width: 0; }

  /* ---- Trigger ---- */
  .curp-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    font-family: var(--font-sans);
    color: var(--color-ink);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .curp-trigger:hover { border-color: var(--color-hairline-strong); }
  .curp-trigger:focus-visible,
  .curp.is-open .curp-trigger {
    outline: none;
    border-color: var(--color-link);
    box-shadow: 0 0 0 3px var(--color-link-soft);
  }
  .curp-glyph { flex: 0 0 auto; color: var(--color-mute); }
  .curp-value { flex: 1 1 auto; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .curp-arrow { flex: 0 0 auto; color: var(--color-mute); transition: transform 0.18s ease; }
  .curp.is-open .curp-arrow { transform: rotate(180deg); }

  /* Compact pill for calculator headers. */
  .curp--chip .curp-trigger {
    height: 34px;
    padding-inline: 0.6rem 0.5rem;
    font-size: 13px;
    font-weight: 500;
    width: auto;
    background-color: var(--color-canvas-soft-2);
  }
  .curp--chip .curp-value { max-width: 9rem; }

  /* Full-width field for the converter (matches .uc-select height). */
  .curp--field .curp-trigger {
    height: 44px;
    padding-inline: 0.75rem;
    font-size: 14px;
    font-weight: 500;
  }

  /* ---- Floating panel (positioned by the controller: position:fixed) ---- */
  .curp-pop {
    position: fixed;
    z-index: 200;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.375rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
    overscroll-behavior: contain;
  }
  .curp-pop[hidden] { display: none; }

  /* Compact header: names the control and clarifies it only restyles results
     (it doesn't convert amounts with FX) — a common point of confusion. */
  .curp-pop-head {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    padding: 0.25rem 0.375rem 0.5rem;
  }
  .curp-pop-title { font-size: 13px; font-weight: 600; color: var(--color-ink); }
  .curp-pop-note { font-size: 11.5px; line-height: 1.3; color: var(--color-mute); }

  .curp-search-wrap { position: relative; flex: 0 0 auto; margin-bottom: 0.375rem; }
  .curp-search-ico {
    position: absolute;
    left: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-mute);
    pointer-events: none;
  }
  .curp-search {
    width: 100%;
    height: 38px;
    padding-inline: 2rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
  }
  .curp-search::placeholder { color: var(--color-mute); }
  .curp-search:focus { outline: none; border-color: var(--color-link); box-shadow: 0 0 0 3px var(--color-link-soft); }

  .curp-list {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .curp-opt {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.4375rem 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
  }
  .curp-opt[hidden] { display: none; }
  /* Symbol badge — a quick visual anchor so the currency is recognisable at a
     glance without reading the code. */
  .curp-opt-sym {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    font-size: 13px;
    line-height: 1;
    color: var(--color-body);
    background-color: var(--color-canvas-soft-2);
    border-radius: var(--radius-sm);
  }
  .curp-opt-code {
    flex: 0 0 auto;
    width: 2.75rem;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .curp-opt-name {
    flex: 1 1 auto;
    font-size: 13.5px;
    color: var(--color-body);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .curp-opt-check { flex: 0 0 auto; color: var(--color-link); opacity: 0; }

  .curp-opt.is-active { background-color: var(--color-canvas-soft-2); }
  .curp-opt.is-active .curp-opt-name { color: var(--color-ink); }
  .curp-opt.is-active .curp-opt-sym { background-color: var(--color-canvas); }

  /* Selected: a soft tint + a tick, instead of a heavy solid fill — lighter to
     scan and it keeps the row legible while it's also the active (hovered) one. */
  .curp-opt[aria-selected='true'] { background-color: var(--color-link-soft); }
  .curp-opt[aria-selected='true'] .curp-opt-code { color: var(--color-link); }
  .curp-opt[aria-selected='true'] .curp-opt-sym { color: var(--color-link); background-color: var(--color-canvas); }
  .curp-opt[aria-selected='true'] .curp-opt-check { opacity: 1; }
  .curp-opt[aria-selected='true'].is-active {
    background-color: color-mix(in srgb, var(--color-link) 16%, var(--color-canvas));
  }

  .curp-empty { padding: 0.75rem 0.625rem; font-size: 13.5px; color: var(--color-mute); text-align: center; }
  .curp-empty[hidden] { display: none; }

  @media (max-width: 560px) {
    .curp--chip { width: 100%; }
    .curp--chip .curp-trigger { width: 100%; height: 40px; font-size: 14px; }
    .curp--chip .curp-value { max-width: none; }
    .curp-search { height: 42px; font-size: 16px; }
    .curp-opt { padding: 0.625rem; }
  }
</style>
