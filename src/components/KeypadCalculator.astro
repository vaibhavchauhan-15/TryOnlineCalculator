---
// Interactive visual calculator with a tactile keypad.
// variant="basic"      → everyday arithmetic
// variant="scientific" → trig, logs, powers, roots, constants
import type { Calculator } from '../lib/types';

interface Props {
  calculator: Calculator;
  variant?: 'basic' | 'scientific';
  /** Localized calculator title (for the keypad's accessible name). */
  title?: string;
  /** Localized chrome strings (keypad* keys). Falls back to English. */
  chrome?: Record<string, string>;
}
const { calculator, variant = 'basic', title, chrome = {} } = Astro.props;
const scientific = variant === 'scientific';

const label = title ?? calculator.title;
const t = {
  hint: chrome.keypadHint ?? 'Tap any value to edit it, or paste a full expression',
  paste: chrome.keypadPaste ?? 'Paste expression',
  pasteAria: chrome.keypadPasteAria ?? 'Paste an expression',
  pasted: chrome.keypadPasted ?? 'Pasted',
  copy: chrome.keypadCopy ?? 'Copy result',
  copied: chrome.keypadCopied ?? 'Copied result',
  expr: chrome.keypadExpr ?? 'Expression (tap a value to edit it)',
  noscript:
    chrome.keypadNoscript ??
    'This calculator runs entirely in your browser and needs JavaScript to work. Please enable JavaScript, or use one of our other calculators that show a full worked example on the page.',
};

type Key = {
  label: string;
  val?: string;
  cls?: string;
  action?: 'clear' | 'del' | 'equals' | 'ans' | 'shift' | 'deg' | 'hyp';
  second?: { label: string; val: string };
  tip?: string;
};

const basicKeys: Key[] = [
  { label: 'AC', action: 'clear', cls: 'key-danger' },
  { label: 'DEL', action: 'del', cls: 'key-danger' },
  { label: '(', val: '(' },
  { label: ')', val: ')' },
  { label: '7', val: '7' }, { label: '8', val: '8' }, { label: '9', val: '9' }, { label: '\u00F7', val: '\u00F7', cls: 'key-op' },
  { label: '4', val: '4' }, { label: '5', val: '5' }, { label: '6', val: '6' }, { label: '\u00D7', val: '\u00D7', cls: 'key-op' },
  { label: '1', val: '1' }, { label: '2', val: '2' }, { label: '3', val: '3' }, { label: '\u2212', val: '\u2212', cls: 'key-op' },
  { label: '%', val: '%' }, { label: '0', val: '0' }, { label: '.', val: '.' }, { label: '+', val: '+', cls: 'key-op' },
  { label: '=', action: 'equals', cls: 'key-equal span-4' },
];

// ========= SCIENTIFIC CALCULATOR KEY LAYOUT =========
// Organized by function category with shift support (Casio-style).
// Tab: Basic (trig, powers, roots) — always visible
const sciMainKeys: Key[] = [
  { label: 'sin', val: 'sin(', cls: 'key-fn', second: { label: 'sin\u207B\u00B9', val: 'asin(' }, tip: 'Sine' },
  { label: 'cos', val: 'cos(', cls: 'key-fn', second: { label: 'cos\u207B\u00B9', val: 'acos(' }, tip: 'Cosine' },
  { label: 'tan', val: 'tan(', cls: 'key-fn', second: { label: 'tan\u207B\u00B9', val: 'atan(' }, tip: 'Tangent' },
  { label: 'ln', val: 'ln(', cls: 'key-fn', second: { label: 'e\u02E3', val: 'exp(' }, tip: 'Natural log' },
  { label: 'log', val: 'log(', cls: 'key-fn', second: { label: '10\u02E3', val: '10^' }, tip: 'Log base 10' },
  { label: '\u221A', val: '\u221A(', cls: 'key-fn', second: { label: '\u221B', val: 'cbrt(' }, tip: 'Square root' },
  { label: 'x\u00B2', val: '^2', cls: 'key-fn', second: { label: 'x\u00B3', val: '^3' }, tip: 'Square' },
  { label: 'x\u02B8', val: '^', cls: 'key-fn', second: { label: '\u207F\u221A', val: 'nrt(' }, tip: 'Power' },
  { label: '1/x', val: '1/(', cls: 'key-fn', second: { label: '|x|', val: 'abs(' }, tip: 'Reciprocal' },
  { label: 'n!', val: 'fact(', cls: 'key-fn', second: { label: '\u0393', val: 'gamma(' }, tip: 'Factorial' },
  { label: '\u03C0', val: '\u03C0', cls: 'key-const', tip: 'Pi (3.14159...)' },
  { label: 'e', val: 'e', cls: 'key-const', tip: 'Euler\'s number (2.71828...)' },
];

// Tab: Func (hyperbolic, advanced math)
const sciFuncKeys: Key[] = [
  { label: 'sinh', val: 'sinh(', cls: 'key-fn', second: { label: 'sinh\u207B\u00B9', val: 'asinh(' }, tip: 'Hyperbolic sine' },
  { label: 'cosh', val: 'cosh(', cls: 'key-fn', second: { label: 'cosh\u207B\u00B9', val: 'acosh(' }, tip: 'Hyperbolic cosine' },
  { label: 'tanh', val: 'tanh(', cls: 'key-fn', second: { label: 'tanh\u207B\u00B9', val: 'atanh(' }, tip: 'Hyperbolic tangent' },
  { label: 'mod', val: '%', cls: 'key-fn', tip: 'Modulo' },
  { label: 'abs', val: 'abs(', cls: 'key-fn', tip: 'Absolute value' },
  { label: 'floor', val: 'floor(', cls: 'key-fn', second: { label: 'ceil', val: 'ceil(' }, tip: 'Floor' },
  { label: 'round', val: 'round(', cls: 'key-fn', tip: 'Round' },
  { label: 'sign', val: 'sign(', cls: 'key-fn', tip: 'Sign function' },
  { label: 'gcd', val: 'gcd(', cls: 'key-fn', tip: 'Greatest common divisor' },
  { label: 'lcm', val: 'lcm(', cls: 'key-fn', tip: 'Least common multiple' },
  { label: 'nPr', val: 'nPr(', cls: 'key-fn', tip: 'Permutation' },
  { label: 'nCr', val: 'nCr(', cls: 'key-fn', tip: 'Combination' },
];

// Tab: Constants & Engineering
const sciConstKeys: Key[] = [
  { label: '\u03C0', val: '\u03C0', cls: 'key-const', tip: 'Pi' },
  { label: 'e', val: 'e', cls: 'key-const', tip: "Euler's number" },
  { label: '\u03C6', val: '1.618033988749895', cls: 'key-const', tip: 'Golden ratio' },
  { label: 'Rand', val: 'rand()', cls: 'key-fn', tip: 'Random [0,1)' },
  { label: 'EXP', val: 'E', cls: 'key-fn', tip: 'Scientific notation (×10^)' },
  { label: 'Ans', action: 'ans', cls: 'key-fn key-ans', tip: 'Previous answer' },
];

// Memory keys
const sciMemKeys: Key[] = [
  { label: 'MC', action: 'clear' as const, cls: 'key-mem', tip: 'Memory Clear' },
  { label: 'MR', action: 'clear' as const, cls: 'key-mem', tip: 'Memory Recall' },
  { label: 'M+', action: 'clear' as const, cls: 'key-mem', tip: 'Memory Add' },
  { label: 'M\u2212', action: 'clear' as const, cls: 'key-mem', tip: 'Memory Subtract' },
];

// Number pad + operators — always visible, 5 columns
const sciNumKeys: Key[] = [
  { label: '(', val: '(' }, { label: ')', val: ')' },
  { label: 'AC', action: 'clear', cls: 'key-danger' },
  { label: 'DEL', action: 'del', cls: 'key-danger' },
  { label: '\u00F7', val: '\u00F7', cls: 'key-op' },

  { label: '7', val: '7' }, { label: '8', val: '8' }, { label: '9', val: '9' },
  { label: '%', val: '%' }, { label: '\u00D7', val: '\u00D7', cls: 'key-op' },

  { label: '4', val: '4' }, { label: '5', val: '5' }, { label: '6', val: '6' },
  { label: '.', val: '.' }, { label: '\u2212', val: '\u2212', cls: 'key-op' },

  { label: '1', val: '1' }, { label: '2', val: '2' }, { label: '3', val: '3' },
  { label: '0', val: '0' }, { label: '+', val: '+', cls: 'key-op' },

  { label: '=', action: 'equals', cls: 'key-equal span-5' },
];

const keys = scientific ? [...sciMainKeys, ...sciNumKeys] : basicKeys;
---

<div class="calc-device" data-keypad data-mode={scientific ? 'scientific' : 'basic'} data-store={`keypad:${calculator.category}/${calculator.slug}`} tabindex="0" aria-label={label} role="application">
  {/* === DISPLAY === */}
  <div class="calc-screen">
    <div class="calc-status">
      {scientific && <span class="calc-chip" data-angle-chip>DEG</span>}
      {scientific && <span class="calc-chip" data-shift-chip hidden>SHIFT</span>}
      {scientific && <span class="calc-chip" data-mem-chip hidden>M</span>}
    </div>
    <div class="calc-screen-expr is-editable" data-expr aria-live="off" role="textbox" aria-label={t.expr}></div>
    <div class="calc-screen-result" data-result aria-live="polite">0</div>
  </div>

  {/* === TOOLBAR: hint + copy/paste === */}
  <div class="calc-copy-row calc-copy-row-split">
    <span class="calc-hint">{t.hint}</span>
    <div class="calc-copy-actions">
      <button type="button" class="calc-copy-action is-icon" data-paste-btn aria-label={t.pasteAria} data-tip={t.paste} data-tip-done={t.pasted}>
        <span data-copy-ico><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="2" width="8" height="4" rx="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path></svg></span>
      </button>
      <button type="button" class="calc-copy-action is-icon" data-copy-btn aria-label={t.copy} data-tip={t.copy} data-tip-done={t.copied}>
        <span data-copy-ico><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></span>
      </button>
    </div>
  </div>

  {scientific && (
    <>
      {/* === MODE TOGGLES: SHIFT + DEG/RAD === */}
      <div class="calc-mode-row">
        <button type="button" class="calc-mode-btn" data-action="shift" aria-pressed="false">SHIFT</button>
        <button type="button" class="calc-mode-btn" data-action="deg" data-deg-btn>DEG</button>
      </div>

      {/* === TABBED FUNCTION PANEL === */}
      <div class="calc-tabs" data-tabs>
        <div class="calc-tab-bar" role="tablist" aria-label="Function categories">
          <button type="button" class="calc-tab is-active" role="tab" aria-selected="true" data-tab="main">Scientific</button>
          <button type="button" class="calc-tab" role="tab" aria-selected="false" data-tab="func">Functions</button>
          <button type="button" class="calc-tab" role="tab" aria-selected="false" data-tab="const">Constants</button>
        </div>

        <div class="calc-tab-panel is-active" role="tabpanel" data-panel="main">
          <div class="calc-keys cols-sci-fn">
            {sciMainKeys.map((k) => (
              <button
                type="button"
                class={`calc-key ${k.cls ?? ''}`}
                data-val={k.val}
                data-action={k.action}
                data-2nd={k.second?.label}
                data-2nd-val={k.second?.val}
                aria-label={k.tip}
                title={k.tip}
              >{k.label}</button>
            ))}
          </div>
        </div>

        <div class="calc-tab-panel" role="tabpanel" data-panel="func" hidden>
          <div class="calc-keys cols-sci-fn">
            {sciFuncKeys.map((k) => (
              <button
                type="button"
                class={`calc-key ${k.cls ?? ''}`}
                data-val={k.val}
                data-action={k.action}
                data-2nd={k.second?.label}
                data-2nd-val={k.second?.val}
                aria-label={k.tip}
                title={k.tip}
              >{k.label}</button>
            ))}
          </div>
        </div>

        <div class="calc-tab-panel" role="tabpanel" data-panel="const" hidden>
          <div class="calc-keys cols-sci-const">
            {sciConstKeys.map((k) => (
              <button
                type="button"
                class={`calc-key ${k.cls ?? ''}`}
                data-val={k.val}
                data-action={k.action}
                data-2nd={k.second?.label}
                data-2nd-val={k.second?.val}
                aria-label={k.tip}
                title={k.tip}
              >{k.label}</button>
            ))}
          </div>
        </div>
      </div>
    </>
  )}

  {/* === NUMBER PAD + OPERATORS === */}
  {scientific ? (
    <div class="calc-keys cols-sci-num">
      {sciNumKeys.map((k) => (
        <button
          type="button"
          class={`calc-key ${k.cls ?? ''}`}
          data-val={k.val}
          data-action={k.action}
          aria-label={k.tip}
          title={k.tip}
        >{k.label}</button>
      ))}
    </div>
  ) : (
    <div class="calc-keys">
      {basicKeys.map((k) => (
        <button
          type="button"
          class={`calc-key ${k.cls ?? ''}`}
          data-val={k.val}
          data-action={k.action}
          data-2nd={k.second?.label}
          data-2nd-val={k.second?.val}
          aria-label={k.tip}
          title={k.tip}
        >{k.label}</button>
      ))}
    </div>
  )}

  <div data-history-mount></div>
</div>

<noscript>
  <p class="calc-visual-note">{t.noscript}</p>
</noscript>

<script>
  import { evaluate } from '../lib/calculators/_expr';
  import { number } from '../lib/format';
  import { loadState, saveState } from '../lib/storage';
  import { createHistoryUI, copyWithFeedback, CHECK_ICON } from '../lib/history';
  import { haptic } from '../lib/haptics';

  type State = {
    expr: string;
    caret: number;
    sel: { s: number; e: number } | null;
    ans: number;
    justEval: boolean;
    shift: boolean;
    deg: boolean;
    memory: number;
    hasMemory: boolean;
  };
  type Saved = { expr: string; ans: number; deg: boolean; justEval: boolean; memory?: number; hasMemory?: boolean };

  function normalize(s: string): string {
    return s
      .replace(/\u00D7/g, '*')
      .replace(/\u00F7/g, '/')
      .replace(/\u2212/g, '-')
      .replace(/\u03C0/g, 'pi')
      .replace(/\u221A\(/g, 'sqrt(')
      .replace(/\u221B\(/g, 'cbrt(')
      .replace(/(\d+(?:\.\d+)?)%/g, '($1/100)');
  }

  function fmt(n: number): string {
    if (!Number.isFinite(n)) return 'Error';
    if (n !== 0 && (Math.abs(n) >= 1e12 || Math.abs(n) < 1e-9)) return n.toExponential(6);
    return number(n, 10);
  }

  function autofix(expr: string): string {
    let s = expr;
    while (s && /[+\-\u2212\u00D7\u00F7(^.]$/.test(s)) s = s.slice(0, -1);
    if (!s) return '';
    const open = (s.match(/\(/g) || []).length - (s.match(/\)/g) || []).length;
    if (open > 0) s += ')'.repeat(open);
    return s;
  }

  type EvalResult = { ok: true; value: number } | { ok: false; msg: string };

  function evalDetailed(s: string, deg: boolean, sci: boolean): EvalResult {
    if (!s.trim()) return { ok: false, msg: 'Incomplete expression' };
    let value: number;
    try {
      value = evaluate(normalize(s), { scientific: sci, degrees: deg });
    } catch (err) {
      const m = err instanceof Error ? err.message : '';
      if (/parenthes/i.test(m)) return { ok: false, msg: 'Unbalanced brackets' };
      if (/scientific/i.test(m)) return { ok: false, msg: 'Switch to scientific mode' };
      if (/Unknown name/i.test(m)) return { ok: false, msg: 'Unknown symbol' };
      if (/Unexpected character/i.test(m)) return { ok: false, msg: 'Invalid character' };
      if (/Invalid expression/i.test(m)) return { ok: false, msg: 'Incomplete expression' };
      if (/Division by zero/i.test(m)) return { ok: false, msg: "Can\u2019t divide by zero" };
      return { ok: false, msg: 'Invalid expression' };
    }
    if (Number.isNaN(value)) return { ok: false, msg: 'Undefined result' };
    if (!Number.isFinite(value)) return { ok: false, msg: "Can\u2019t divide by zero" };
    return { ok: true, value };
  }

  function preview(expr: string, deg: boolean, sci: boolean): number | null {
    if (!expr) return 0;
    const fixed = autofix(expr);
    if (!fixed) return null;
    const r = evalDetailed(fixed, deg, sci);
    return r.ok ? r.value : null;
  }

  type Tok = { s: number; e: number };
  function tokenize(expr: string): Tok[] {
    const toks: Tok[] = [];
    let i = 0;
    while (i < expr.length) {
      const c = expr[i];
      if (/[0-9.]/.test(c)) {
        let j = i + 1;
        while (j < expr.length && /[0-9.]/.test(expr[j])) j++;
        toks.push({ s: i, e: j });
        i = j;
      } else if (/[a-z\u221A\u221B]/i.test(c)) {
        let j = i + 1;
        while (j < expr.length && /[a-z\u221A\u221B]/i.test(expr[j])) j++;
        if (expr[j] === '(') j++;
        toks.push({ s: i, e: j });
        i = j;
      } else {
        toks.push({ s: i, e: i + 1 });
        i += 1;
      }
    }
    return toks;
  }

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  const CARET = '<span class="calc-caret" aria-hidden="true"></span>';

  function mount(root: HTMLElement): void {
    const sci = root.dataset.mode === 'scientific';
    const exprEl = root.querySelector<HTMLElement>('[data-expr]')!;
    const resultEl = root.querySelector<HTMLElement>('[data-result]')!;
    const angleChip = root.querySelector<HTMLElement>('[data-angle-chip]');
    const shiftChip = root.querySelector<HTMLElement>('[data-shift-chip]');
    const memChip = root.querySelector<HTMLElement>('[data-mem-chip]');
    const degBtn = root.querySelector<HTMLElement>('[data-deg-btn]');
    const shiftBtn = root.querySelector<HTMLElement>('[data-action="shift"]');

    const state: State = { expr: '', caret: 0, sel: null, ans: 0, justEval: false, shift: false, deg: true, memory: 0, hasMemory: false };
    const store = root.dataset.store;

    // === Tab switching ===
    const tabBar = root.querySelector<HTMLElement>('[data-tabs]');
    if (tabBar) {
      const tabs = tabBar.querySelectorAll<HTMLElement>('[role="tab"]');
      const panels = tabBar.querySelectorAll<HTMLElement>('[role="tabpanel"]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.dataset.tab;
          tabs.forEach((t) => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
          panels.forEach((p) => { p.classList.remove('is-active'); p.hidden = true; });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          const panel = tabBar.querySelector<HTMLElement>(`[data-panel="${target}"]`);
          if (panel) { panel.classList.add('is-active'); panel.hidden = false; }
          haptic.tap();
        });
      });
    }

    // History panel + copy control.
    const historyMount = root.querySelector<HTMLElement>('[data-history-mount]');
    const history = historyMount && store ? createHistoryUI({ key: store, mount: historyMount }) : null;
    const copyBtn = root.querySelector<HTMLElement>('[data-copy-btn]');
    copyBtn?.addEventListener('click', () => {
      haptic.tap();
      void copyWithFeedback(copyBtn, resultEl.textContent?.trim() ?? '');
    });
    const pasteBtn = root.querySelector<HTMLElement>('[data-paste-btn]');
    const pasteIco = pasteBtn?.querySelector<HTMLElement>('[data-copy-ico]');
    const pasteIcoHTML = pasteIco?.innerHTML ?? '';
    function flashPaste(): void {
      if (!pasteBtn) return;
      const prev = pasteBtn.getAttribute('data-revert-timer');
      if (prev) clearTimeout(Number(prev));
      pasteBtn.classList.add('is-copied');
      if (pasteIco) pasteIco.innerHTML = CHECK_ICON;
      const timer = window.setTimeout(() => {
        pasteBtn.classList.remove('is-copied');
        if (pasteIco) pasteIco.innerHTML = pasteIcoHTML;
        pasteBtn.removeAttribute('data-revert-timer');
      }, 1200);
      pasteBtn.setAttribute('data-revert-timer', String(timer));
    }
    pasteBtn?.addEventListener('click', () => { void pasteFromClipboard(); root.focus(); });

    const persist = (): void => {
      if (!store) return;
      saveState(store, { expr: state.expr, ans: state.ans, deg: state.deg, justEval: state.justEval, memory: state.memory, hasMemory: state.hasMemory } satisfies Saved);
    };

    const charBefore = () => state.expr[state.caret - 1] ?? '';
    const needsMult = () => /[0-9)%\u03C0e]/.test(charBefore());

    function paintExpr(): void {
      const { expr, caret, sel } = state;
      if (!expr) { exprEl.innerHTML = CARET; return; }
      const toks = tokenize(expr);
      let html = '';
      let caretDone = false;
      for (const t of toks) {
        const selected = !!sel && sel.s <= t.s && t.e <= sel.e;
        const open = selected ? '<span class="tok is-sel">' : '<span class="tok">';
        if (caret >= t.s && caret < t.e) {
          html += open + esc(expr.slice(t.s, caret)) + CARET + esc(expr.slice(caret, t.e)) + '</span>';
          caretDone = true;
        } else {
          html += open + esc(expr.slice(t.s, t.e)) + '</span>';
        }
      }
      if (!caretDone) html += CARET;
      exprEl.innerHTML = html;
      scrollCaretIntoView();
    }

    function scrollCaretIntoView(): void {
      const caret = exprEl.querySelector<HTMLElement>('.calc-caret');
      if (!caret) { exprEl.scrollTop = exprEl.scrollHeight; return; }
      const top = caret.offsetTop;
      const bottom = top + caret.offsetHeight;
      if (top < exprEl.scrollTop) exprEl.scrollTop = top;
      else if (bottom > exprEl.scrollTop + exprEl.clientHeight) {
        exprEl.scrollTop = bottom - exprEl.clientHeight;
      }
    }

    function render(): void {
      resultEl.classList.remove('is-error');
      if (state.justEval) {
        exprEl.textContent = state.expr + ' =';
        persist();
        return;
      }
      paintExpr();
      const p = preview(state.expr, state.deg, sci);
      resultEl.textContent = p === null ? (state.expr ? '' : '0') : fmt(p);
      persist();
    }

    function spliceAtCaret(text: string): void {
      if (state.sel) {
        state.expr = state.expr.slice(0, state.sel.s) + text + state.expr.slice(state.sel.e);
        state.caret = state.sel.s + text.length;
        state.sel = null;
      } else {
        state.expr = state.expr.slice(0, state.caret) + text + state.expr.slice(state.caret);
        state.caret += text.length;
      }
    }

    function insert(val: string): void {
      if (state.justEval) {
        if (/^[+\-\u2212\u00D7\u00F7^%]/.test(val)) {
          state.expr = fmt(state.ans).replace(/,/g, '');
          state.caret = state.expr.length;
        } else {
          state.expr = '';
          state.caret = 0;
        }
        state.sel = null;
        state.justEval = false;
      }
      const isFuncOrConst = /[a-z\u221A\u221B\u03C0(]/i.test(val[0]) || val === '10^';
      if (isFuncOrConst && !state.sel && needsMult() && !/^[\^]/.test(val)) {
        spliceAtCaret('\u00D7');
      }
      spliceAtCaret(val);
      render();
    }

    function sanitizePasted(raw: string): string {
      let s = raw;
      const eq = s.indexOf('=');
      if (eq >= 0) s = s.slice(0, eq);
      s = s
        .replace(/\s+/g, '')
        .replace(/,(?=\d{3}\b)/g, '')
        .replace(/\*\*/g, '^')
        .replace(/[*\u2217\u2715\u2716]/g, '\u00D7')
        .replace(/(\d)[xX](?=[\d(.])/g, '$1\u00D7')
        .replace(/\//g, '\u00F7')
        .replace(/[-\u2010\u2011\u2013\u2014]/g, '\u2212');
      return s.replace(/[^0-9.\u00D7\u00F7\u2212+^%()a-zA-Z\u03C0\u221A\u221B]/g, '');
    }

    function insertPasted(raw: string): void {
      const clean = sanitizePasted(raw);
      if (!clean) return;
      if (state.justEval) {
        state.expr = '';
        state.caret = 0;
        state.sel = null;
        state.justEval = false;
      }
      spliceAtCaret(clean);
      render();
    }

    async function pasteFromClipboard(): Promise<void> {
      try {
        const text = await navigator.clipboard.readText();
        if (text) { insertPasted(text); flashPaste(); }
      } catch { /* Clipboard blocked */ }
    }

    function setShift(on: boolean): void {
      state.shift = on;
      shiftBtn?.classList.toggle('is-active', on);
      shiftChip?.toggleAttribute('hidden', !on);
    }

    function updateMemChip(): void {
      memChip?.toggleAttribute('hidden', !state.hasMemory);
    }

    function equals(): void {
      if (!state.expr.trim()) return;
      let res = evalDetailed(state.expr, state.deg, sci);
      let source = state.expr;
      if (!res.ok) {
        const fixed = autofix(state.expr);
        const res2 = evalDetailed(fixed, state.deg, sci);
        if (res2.ok) { res = res2; source = fixed; }
      }
      if (!res.ok) {
        resultEl.textContent = res.msg;
        resultEl.classList.add('is-error');
        resultEl.classList.remove('is-shake');
        void resultEl.offsetWidth;
        resultEl.classList.add('is-shake');
        haptic.error();
        return;
      }
      state.ans = res.value;
      state.expr = source;
      state.caret = source.length;
      state.sel = null;
      exprEl.textContent = source + ' =';
      resultEl.classList.remove('is-error', 'is-shake');
      resultEl.textContent = fmt(res.value);
      history?.record(source, fmt(res.value));
      state.justEval = true;
      haptic.success();
      persist();
    }

    function clearAll(): void {
      state.expr = '';
      state.caret = 0;
      state.sel = null;
      state.justEval = false;
      render();
    }

    function del(): void {
      if (state.justEval) state.justEval = false;
      if (state.sel) {
        state.expr = state.expr.slice(0, state.sel.s) + state.expr.slice(state.sel.e);
        state.caret = state.sel.s;
        state.sel = null;
      } else if (state.caret > 0) {
        state.expr = state.expr.slice(0, state.caret - 1) + state.expr.slice(state.caret);
        state.caret -= 1;
      }
      render();
    }

    function moveCaret(dir: -1 | 1): void {
      if (state.sel) {
        state.caret = dir < 0 ? state.sel.s : state.sel.e;
        state.sel = null;
      } else {
        state.caret = Math.max(0, Math.min(state.expr.length, state.caret + dir));
      }
      render();
    }

    function offsetFromPoint(x: number, y: number): number {
      const doc = document as Document & {
        caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null;
        caretRangeFromPoint?: (x: number, y: number) => Range | null;
      };
      let node: Node | null = null;
      let nodeOffset = 0;
      if (doc.caretPositionFromPoint) {
        const pos = doc.caretPositionFromPoint(x, y);
        if (pos) { node = pos.offsetNode; nodeOffset = pos.offset; }
      } else if (doc.caretRangeFromPoint) {
        const range = doc.caretRangeFromPoint(x, y);
        if (range) { node = range.startContainer; nodeOffset = range.startOffset; }
      }
      if (!node) return state.expr.length;
      let acc = 0;
      const walker = document.createTreeWalker(exprEl, NodeFilter.SHOW_TEXT);
      let cur = walker.nextNode();
      while (cur) {
        if (cur === node) return acc + Math.min(nodeOffset, cur.textContent?.length ?? 0);
        acc += cur.textContent?.length ?? 0;
        cur = walker.nextNode();
      }
      return Math.min(acc, state.expr.length);
    }

    function selectFromPoint(x: number, y: number): void {
      if (state.justEval) state.justEval = false;
      const offset = offsetFromPoint(x, y);
      const hit = tokenize(state.expr).find((t) => offset >= t.s && offset < t.e);
      if (hit) {
        state.sel = { s: hit.s, e: hit.e };
        state.caret = hit.e;
      } else {
        state.sel = null;
        state.caret = offset;
      }
      render();
      root.focus();
    }

    // Memory operations
    function memoryOp(op: string): void {
      const current = state.justEval ? state.ans : (preview(state.expr, state.deg, sci) ?? 0);
      switch (op) {
        case 'MC': state.memory = 0; state.hasMemory = false; break;
        case 'MR': insert(fmt(state.memory).replace(/,/g, '')); break;
        case 'M+': state.memory += current; state.hasMemory = true; break;
        case 'M\u2212': state.memory -= current; state.hasMemory = true; break;
        case 'MS': state.memory = current; state.hasMemory = true; break;
      }
      updateMemChip();
      persist();
    }

    function handle(action: string | undefined, val: string | undefined, second: string | undefined, label?: string): void {
      if (action === 'clear') {
        // Check if it's a memory button by label
        if (label && /^M[CR+\u2212S]/.test(label)) { memoryOp(label); return; }
        clearAll(); return;
      }
      if (action === 'del') { del(); return; }
      if (action === 'equals') { equals(); return; }
      if (action === 'ans') { insert(fmt(state.ans).replace(/,/g, '')); return; }
      if (action === 'shift') { setShift(!state.shift); return; }
      if (action === 'deg') {
        state.deg = !state.deg;
        const mode = state.deg ? 'DEG' : 'RAD';
        if (degBtn) degBtn.textContent = mode;
        if (angleChip) angleChip.textContent = mode;
        render();
        return;
      }
      if (state.shift && second) { insert(second); setShift(false); return; }
      if (val !== undefined) { insert(val); if (state.shift) setShift(false); }
    }

    root.querySelectorAll<HTMLButtonElement>('.calc-key').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.action !== 'equals') haptic.tap();
        handle(btn.dataset.action, btn.dataset.val, btn.dataset['2ndVal'], btn.textContent?.trim());
      });
      const press = () => btn.classList.add('is-press');
      const release = () => btn.classList.remove('is-press');
      btn.addEventListener('touchstart', press, { passive: true });
      btn.addEventListener('touchend', release);
      btn.addEventListener('touchcancel', release);
    });

    // Mode buttons (SHIFT / DEG) — separate from calc-key
    root.querySelectorAll<HTMLButtonElement>('.calc-mode-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        haptic.tap();
        handle(btn.dataset.action, undefined, undefined);
      });
    });

    // Tap the screen to place cursor / select value.
    exprEl.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      selectFromPoint(e.clientX, e.clientY);
    });

    // Swipe left on display to delete
    let touchStartX = 0;
    exprEl.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    exprEl.addEventListener('touchend', (e) => {
      const dx = (e.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
      if (dx < -40) { del(); haptic.tap(); }
    });

    // Paste event
    root.addEventListener('paste', (e) => {
      const text = e.clipboardData?.getData('text') ?? '';
      if (!text) return;
      e.preventDefault();
      insertPasted(text);
    });

    // Keyboard support
    root.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey) {
        if (e.key === 'v' || e.key === 'V') { e.preventDefault(); void pasteFromClipboard(); }
        if (e.key === 'c' || e.key === 'C') {
          e.preventDefault();
          const val = resultEl.textContent?.trim() ?? '';
          if (val) void navigator.clipboard?.writeText(val);
        }
        return;
      }
      const k = e.key;
      let handled = true;
      if (/^[0-9.]$/.test(k)) insert(k);
      else if (k === '+') insert('+');
      else if (k === '-') insert('\u2212');
      else if (k === '*') insert('\u00D7');
      else if (k === '/') insert('\u00F7');
      else if (k === '(') insert('(');
      else if (k === ')') insert(')');
      else if (k === '%') insert('%');
      else if (k === '^') insert('^');
      else if (k === 'Enter' || k === '=') equals();
      else if (k === 'Backspace') del();
      else if (k === 'Delete') {
        if (state.sel) del();
        else if (state.caret < state.expr.length) {
          state.expr = state.expr.slice(0, state.caret) + state.expr.slice(state.caret + 1);
          render();
        }
      }
      else if (k === 'ArrowLeft') moveCaret(-1);
      else if (k === 'ArrowRight') moveCaret(1);
      else if (k === 'Home') { state.caret = 0; state.sel = null; render(); }
      else if (k === 'End') { state.caret = state.expr.length; state.sel = null; render(); }
      else if (k === 'Escape') clearAll();
      else handled = false;
      if (handled) e.preventDefault();
    });

    // Restore session
    const saved = store ? loadState<Saved>(store) : null;
    if (saved) {
      state.expr = typeof saved.expr === 'string' ? saved.expr : '';
      state.ans = typeof saved.ans === 'number' ? saved.ans : 0;
      state.deg = typeof saved.deg === 'boolean' ? saved.deg : true;
      state.justEval = Boolean(saved.justEval);
      state.memory = typeof saved.memory === 'number' ? saved.memory : 0;
      state.hasMemory = Boolean(saved.hasMemory);
      state.caret = state.expr.length;
    }
    if (sci) {
      const mode = state.deg ? 'DEG' : 'RAD';
      if (degBtn) degBtn.textContent = mode;
      if (angleChip) angleChip.textContent = mode;
    }
    updateMemChip();
    if (state.justEval && state.expr) {
      exprEl.textContent = state.expr + ' =';
      resultEl.textContent = fmt(state.ans);
    } else {
      render();
    }
  }

  function init(): void {
    document.querySelectorAll<HTMLElement>('[data-keypad]').forEach((el) => {
      if (!el.dataset.mounted) {
        el.dataset.mounted = '1';
        mount(el);
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>

<style>
  .calc-device:focus-visible { outline: 2px solid var(--color-link); outline-offset: 3px; }
</style>
