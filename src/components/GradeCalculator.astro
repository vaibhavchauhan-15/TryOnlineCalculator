---
// Guided course-grade calculator. Each assignment is a row: an optional name,
// the score you got, and how much it's worth. Add/remove rows with one tap and
// the weighted grade + letter + gauge update live. The maths + result markup
// come from the shared grade-calculator compute().
import CalculateButton from './CalculateButton.astro';
import { educationCalculators } from '../lib/calculators/education';
import { renderResultsHTML } from '../lib/render';

interface Props {
  storeKey?: string;
}
const { storeKey } = Astro.props;

const seed = [
  { name: 'Homework', score: '95', weight: '20' },
  { name: 'Quizzes', score: '88', weight: '20' },
  { name: 'Midterm', score: '76', weight: '25' },
  { name: 'Final exam', score: '90', weight: '35' },
];

const calc = educationCalculators.find((c) => c.slug === 'grade-calculator')!;
const initial = renderResultsHTML(
  calc.compute({ items: seed.map((r) => `${r.score}, ${r.weight}`).join('\n') }),
);
---

<div class="edu-calc has-visuals" data-grade data-store={storeKey ? `grade:${storeKey}` : undefined}>
  <div class="edu-grid">
    <div class="edu-card">
      <div class="edu-card-head">
        <span class="edu-card-title">Your assignments</span>
        <span class="edu-card-sub">Add each graded item with the score you got and how much it counts.</span>
      </div>

      <div class="edu-rows" data-rows>
        {seed.map((row, i) => (
          <div class="edu-row" data-row>
            <div class="edu-row-body">
              <input class="field grade-name" data-name type="text" value={row.name} placeholder="Assignment name" aria-label={`Assignment ${i + 1} name`} />
              <div class="edu-row-fields grade-fields">
                <label class="edu-field">
                  <span class="edu-field-label">Score</span>
                  <div class="edu-affix-wrap">
                    <input class="field" data-score type="number" inputmode="decimal" min="0" step="0.1" value={row.score} aria-label={`Assignment ${i + 1} score`} />
                    <span class="edu-affix">%</span>
                  </div>
                </label>
                <label class="edu-field">
                  <span class="edu-field-label">Weight</span>
                  <div class="edu-affix-wrap">
                    <input class="field" data-weight type="number" inputmode="decimal" min="0" step="0.1" value={row.weight} aria-label={`Assignment ${i + 1} weight`} />
                    <span class="edu-affix">%</span>
                  </div>
                </label>
              </div>
            </div>
            <button type="button" class="edu-remove" data-remove aria-label="Remove assignment">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
            </button>
          </div>
        ))}
      </div>

      <button type="button" class="edu-add" data-add>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
        Add assignment
      </button>

      <CalculateButton />

      <div class="edu-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-reset>Reset</button>
        <button type="button" class="btn btn-secondary btn-sm" data-copy>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

    <div class="edu-output">
      <div class="edu-output-head">
        <span class="eyebrow">Result</span>
        <span class="edu-live-hint"><span class="edu-live-dot" aria-hidden="true"></span>Updates as you type</span>
      </div>
      <div data-out set:html={initial}></div>
      <div data-history-mount></div>
    </div>
  </div>

  <template data-row-template>
    <div class="edu-row" data-row>
      <div class="edu-row-body">
        <input class="field grade-name" data-name type="text" placeholder="Assignment name" aria-label="Assignment name" />
        <div class="edu-row-fields grade-fields">
          <label class="edu-field">
            <span class="edu-field-label">Score</span>
            <div class="edu-affix-wrap">
              <input class="field" data-score type="number" inputmode="decimal" min="0" step="0.1" value="90" aria-label="Assignment score" />
              <span class="edu-affix">%</span>
            </div>
          </label>
          <label class="edu-field">
            <span class="edu-field-label">Weight</span>
            <div class="edu-affix-wrap">
              <input class="field" data-weight type="number" inputmode="decimal" min="0" step="0.1" value="10" aria-label="Assignment weight" />
              <span class="edu-affix">%</span>
            </div>
          </label>
        </div>
      </div>
      <button type="button" class="edu-remove" data-remove aria-label="Remove assignment">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
      </button>
    </div>
  </template>
</div>

<script>
  import { educationCalculators } from '../lib/calculators/education';
  import { renderResultsHTML } from '../lib/render';
  import { loadState, saveState, clearState } from '../lib/storage';
  import { createHistoryUI, copyWithFeedback, wireCalculateButton } from '../lib/history';

  type Row = { name: string; score: string; weight: string };
  type Saved = { rows: Row[] };

  const calc = educationCalculators.find((c) => c.slug === 'grade-calculator')!;
  const DEFAULTS: Row[] = [
    { name: 'Homework', score: '95', weight: '20' },
    { name: 'Quizzes', score: '88', weight: '20' },
    { name: 'Midterm', score: '76', weight: '25' },
    { name: 'Final exam', score: '90', weight: '35' },
  ];

  function mount(root: HTMLElement): void {
    const rowsWrap = root.querySelector<HTMLElement>('[data-rows]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const tpl = root.querySelector<HTMLTemplateElement>('[data-row-template]')!;
    const store = root.dataset.store;

    const historyMount = root.querySelector<HTMLElement>('[data-history-mount]');
    const history = historyMount && store ? createHistoryUI({ key: store, mount: historyMount }) : null;

    const rowsData = (): Row[] =>
      Array.from(rowsWrap.querySelectorAll<HTMLElement>('[data-row]')).map((r) => ({
        name: r.querySelector<HTMLInputElement>('[data-name]')!.value.trim(),
        score: r.querySelector<HTMLInputElement>('[data-score]')!.value.trim(),
        weight: r.querySelector<HTMLInputElement>('[data-weight]')!.value.trim(),
      }));

    const renumber = () => {
      const removeBtns = rowsWrap.querySelectorAll<HTMLButtonElement>('[data-remove]');
      removeBtns.forEach((b) => (b.disabled = removeBtns.length <= 1));
    };

    const persist = () => {
      if (store) saveState(store, { rows: rowsData() } satisfies Saved);
    };

    const update = () => {
      const items = rowsData()
        .filter((r) => r.score !== '' && r.weight !== '')
        .map((r) => `${r.score}, ${r.weight}`)
        .join('\n');
      out.innerHTML = renderResultsHTML(calc.compute({ items }));
      persist();
    };

    const addRow = (row: Partial<Row> = {}): void => {
      const frag = tpl.content.cloneNode(true) as DocumentFragment;
      const el = frag.querySelector<HTMLElement>('[data-row]')!;
      if (row.name !== undefined) el.querySelector<HTMLInputElement>('[data-name]')!.value = row.name;
      if (row.score !== undefined) el.querySelector<HTMLInputElement>('[data-score]')!.value = row.score;
      if (row.weight !== undefined) el.querySelector<HTMLInputElement>('[data-weight]')!.value = row.weight;
      rowsWrap.appendChild(el);
      renumber();
    };

    rowsWrap.addEventListener('input', update);
    rowsWrap.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-remove]');
      if (!btn) return;
      if (rowsWrap.querySelectorAll('[data-row]').length <= 1) return;
      btn.closest('[data-row]')?.remove();
      renumber();
      update();
    });

    root.querySelector<HTMLButtonElement>('[data-add]')?.addEventListener('click', () => {
      addRow();
      update();
    });

    out.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-result]');
      if (!btn) return;
      void copyWithFeedback(btn, out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '');
    });

    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');
    copyBtn?.addEventListener('click', () => {
      void copyWithFeedback(copyBtn, out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '');
    });

    root.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
      if (store) clearState(store);
      rowsWrap.innerHTML = '';
      DEFAULTS.forEach((r) => addRow(r));
      update();
    });

    const commit = (): boolean => {
      const value = out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '';
      if (!value) return false;
      return history?.record('Course grade', value) ?? false;
    };
    wireCalculateButton(root, () => {
      update();
      return commit();
    });

    const saved = store ? loadState<Saved>(store) : null;
    if (saved && Array.isArray(saved.rows) && saved.rows.length) {
      rowsWrap.innerHTML = '';
      saved.rows.forEach((r) => addRow(r));
    } else {
      renumber();
    }
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-grade]').forEach(mount);
</script>

<style>
  .grade-name { font-weight: 500; }
  .grade-fields { grid-template-columns: 1fr 1fr; }
</style>
