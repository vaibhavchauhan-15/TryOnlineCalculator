---
import { categories } from '../lib/categories';
import Search from './Search.astro';
---

<header class="site-header">
  <div class="container-page header-inner">
    <a href="/" class="brand" aria-label="Try Online Calculator home">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
        <line x1="8" y1="6" x2="16" y2="6"></line>
        <line x1="8" y1="10" x2="8" y2="10"></line>
        <line x1="12" y1="10" x2="12" y2="10"></line>
        <line x1="16" y1="10" x2="16" y2="10"></line>
        <line x1="8" y1="14" x2="8" y2="14"></line>
        <line x1="12" y1="14" x2="12" y2="14"></line>
        <line x1="16" y1="14" x2="16" y2="18"></line>
        <line x1="8" y1="18" x2="12" y2="18"></line>
      </svg>
      <span class="brand-name">Try Online Calculator</span>
    </a>

    <div class="header-search">
      <Search variant="bar" />
    </div>

    <nav class="header-nav" aria-label="Calculator categories" data-menu>
      {categories.map((c) => (
        <a href={c.path} class="nav-link">{c.name}</a>
      ))}
      <a href="/unit-converter" class="nav-link">Converters</a>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Toggle color theme" data-theme-toggle>
      <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path><path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path><path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>

    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" data-menu-toggle>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });

  // Theme toggle — persists the choice, keeps the browser UI colour in sync,
  // and reveals the new theme with a circular View Transition wipe.
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const syncThemeUi = (theme: string) => {
    const isDark = theme === 'dark';
    themeToggle?.setAttribute('aria-pressed', String(isDark));
    if (themeColorMeta) themeColorMeta.content = isDark ? '#000000' : '#ffffff';
  };
  syncThemeUi(root.getAttribute('data-theme') ?? 'dark');

  // The synchronous part of the swap: cheap attribute + storage writes only.
  const commitTheme = (next: string) => {
    root.setAttribute('data-theme', next);
    syncThemeUi(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable (private mode / disabled) — ignore */
    }
  };

  themeToggle?.addEventListener('click', (event) => {
    const current = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    const next = current === 'dark' ? 'light' : 'dark';

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Fallback: no View Transitions support or reduced motion → instant swap.
    if (!('startViewTransition' in document) || prefersReduced) {
      commitTheme(next);
      return;
    }

    // Circle originates from the click point, falling back to the button centre.
    const rect = themeToggle.getBoundingClientRect();
    const x = event.clientX || rect.left + rect.width / 2;
    const y = event.clientY || rect.top + rect.height / 2;
    // Radius that reaches the farthest viewport corner.
    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y),
    );

    const transition = (document as Document & {
      startViewTransition: (cb: () => void) => { ready: Promise<void> };
    }).startViewTransition(() => commitTheme(next));

    transition.ready.then(() => {
      root.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: 300,
          easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
          pseudoElement: '::view-transition-new(root)',
        },
      );
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-canvas) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .header-search { flex: 1; max-width: 380px; }
  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .nav-link {
    padding: 0.375rem 0.625rem;
    font-size: 14px;
    color: var(--color-body);
    border-radius: var(--radius-full, 9999px);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .nav-link:hover { color: var(--color-ink); background-color: var(--color-canvas-soft-2); }
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    background-color: var(--color-canvas);
    color: var(--color-ink);
    cursor: pointer;
  }
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full, 9999px);
    background-color: var(--color-canvas);
    color: var(--color-body);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease,
      border-color 0.15s ease, transform 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border-color: var(--color-hairline-strong);
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }

  /* Both icons stay in the DOM, stacked and centred, and crossfade with a
     rotate + scale. Only the icon for the theme you can switch TO is shown. */
  .theme-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg) scale(0.4);
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  :global(html[data-theme='dark']) .theme-icon-sun,
  :global(html[data-theme='light']) .theme-icon-moon {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-icon { transition: none; }
    .theme-toggle:active { transform: none; }
  }

  @media (max-width: 1024px) {
    .brand-name { display: none; }
  }
  @media (max-width: 860px) {
    .menu-toggle { display: inline-flex; }
    /* Nav collapses into the dropdown, so pin the toggle group to the right. */
    .theme-toggle { margin-left: auto; }
    .header-nav {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem;
      background-color: var(--color-canvas);
      border-bottom: 1px solid var(--color-hairline);
      box-shadow: var(--shadow-soft);
      display: none;
    }
    .header-nav.is-open { display: flex; }
    .nav-link { padding: 0.75rem; border-radius: var(--radius-sm); }
  }
  @media (max-width: 520px) {
    .brand-name { display: inline; }
    .header-search { display: none; }
  }
</style>
