---
// Live currency converter widget.
//
// Rendered with static reference rates (works with no JS and is fully
// crawlable), then enhanced on the client with live rates and an interactive
// exchange-rate history chart, both fetched directly from the Frankfurter API
// in the browser (no backend). Replaces the generic UnitConverter for the
// currency slug so it can offer currency-specific affordances such as the
// rate-history chart. Visitor preferences (currencies, amount, chart range)
// persist across refreshes via localStorage.
import type { ConverterConfig } from '../lib/converters';
import CurrencyPicker from './CurrencyPicker.astro';
import SwapButton from './SwapButton.astro';
import { CURRENCIES } from '../lib/currency';
import { STATIC_USD_PER, LIVE_CODES } from '../lib/rates';

interface Props {
  converter: ConverterConfig;
}
const { converter } = Astro.props;
const { defaultFrom, defaultTo, defaultValue } = converter;

// Static USD-per-unit factors for every currency in the picker (fallback +
// no-JS baseline). Live values overlay these on the client.
const codes = CURRENCIES.map((c) => c.code).filter((c) => STATIC_USD_PER[c] !== undefined);
const usdPer: Record<string, number> = Object.fromEntries(codes.map((c) => [c, STATIC_USD_PER[c]]));

const clientConfig = {
  usdPer,
  live: LIVE_CODES,
  defaultFrom,
  defaultTo,
  defaultValue,
};

// --- Deterministic server-side formatting for the first paint ---------------
const fmtMoney = (n: number, code: string): string => {
  try {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: code,
      maximumFractionDigits: n !== 0 && Math.abs(n) < 1 ? 4 : 2,
    }).format(n);
  } catch {
    return `${n.toFixed(2)} ${code}`;
  }
};

const amt = Number(defaultValue) || 0;
const fFrom = usdPer[defaultFrom] ?? 1;
const fTo = usdPer[defaultTo] ?? 1;
const initResult = fmtMoney((amt * fFrom) / fTo, defaultTo);
const ranges: { id: string; label: string }[] = [
  { id: '1w', label: '1W' },
  { id: '1m', label: '1M' },
  { id: '3m', label: '3M' },
  { id: '6m', label: '6M' },
  { id: '1y', label: '1Y' },
  { id: '5y', label: '5Y' },
];
---

<section class="cc card" data-cc aria-label="Currency converter tool">
  <script type="application/json" data-cc-config set:html={JSON.stringify(clientConfig)} />

  <!-- Amount + from  →  Result + to -->
  <div class="cc-io">
    <div class="cc-field">
      <label class="cc-label" for="cc-amount">Amount</label>
      <input
        id="cc-amount"
        class="cc-input"
        data-cc-amount
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value={defaultValue}
        aria-label="Amount to convert"
      />
      <CurrencyPicker variant="field" value={defaultFrom} role="data-cc-from" label="Convert from currency" />
    </div>

    <SwapButton label="Swap currencies" data-cc-swap />

    <div class="cc-field">
      <label class="cc-label" for="cc-result">Converted amount</label>
      <output id="cc-result" class="cc-output" data-cc-result aria-live="polite">{initResult}</output>
      <CurrencyPicker variant="field" value={defaultTo} role="data-cc-to" label="Convert to currency" />
    </div>
  </div>

  <!-- Freshness + copy -->
  <div class="cc-meta">
    <span class="cc-updated" data-cc-updated>Rates update daily</span>
    <button type="button" class="cc-copy" data-cc-copy aria-label="Copy converted amount" title="Copy result">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      <span>Copy</span>
    </button>
  </div>

  <!-- Exchange-rate history chart -->
  <div class="cc-chart-block">
    <div class="cc-chart-head">
      <div class="cc-chart-heading">
        <span class="eyebrow cc-section-head">Exchange rate history</span>
        <p class="cc-chart-pair" data-cc-chart-title>{defaultFrom} → {defaultTo}</p>
      </div>
      <div class="cc-change" data-cc-change></div>
    </div>

    <div class="cc-ranges" role="group" aria-label="Chart time range" data-cc-ranges>
      {ranges.map((r) => (
        <button type="button" class:list={['cc-range', r.id === '1m' && 'is-active']} data-range={r.id}>{r.label}</button>
      ))}
    </div>

    <div class="cc-chart" data-cc-chart aria-live="polite"></div>
    <p class="cc-chart-note" data-cc-chart-note>Loading exchange-rate history…</p>
  </div>

</section>

<script>
  import { initCurrencyConverter } from '../lib/currency-converter';
  initCurrencyConverter();
</script>

<style>
  .cc {
    padding: clamp(1rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ---- Amount / swap / result ---- */
  .cc-io {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 0.75rem;
  }
  .cc-field { min-width: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .cc-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .cc-input,
  .cc-output {
    width: 100%;
    height: 56px;
    padding-inline: 0.875rem;
    font-family: var(--font-mono);
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 600;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .cc-input:focus { outline: none; box-shadow: inset 0 0 0 2px var(--color-link); }
  .cc-output {
    display: flex;
    align-items: center;
    overflow-x: auto;
    white-space: nowrap;
    background-color: #171717;
    color: #fff;
  }
  .cc-output.is-error { color: #ff8f92; font-size: 16px; }

  /* ---- Meta: freshness + copy ---- */
  .cc-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .cc-updated {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 12px;
    color: var(--color-mute);
  }
  .cc-updated.is-live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success, #22c55e);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success, #22c55e) 60%, transparent);
    animation: cc-pulse 2s infinite;
  }
  @keyframes cc-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success, #22c55e) 55%, transparent); }
    70% { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .cc-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-body);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, transform 0.06s ease;
  }
  .cc-copy:hover { color: var(--color-ink); background-color: var(--color-canvas-soft); }
  .cc-copy:active { transform: scale(0.97); }
  .cc-copy.is-copied { color: var(--color-success); box-shadow: inset 0 0 0 1px var(--color-success); }

  .cc-section-head { color: var(--color-mute); display: block; }

  /* ---- Chart ---- */
  .cc-chart-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
  }
  .cc-chart-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .cc-chart-heading { display: flex; flex-direction: column; gap: 0.25rem; }
  .cc-chart-pair { margin: 0; font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-ink); }
  .cc-change {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-mute);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-canvas-soft);
  }
  .cc-change:empty { display: none; }
  .cc-change.is-up { color: var(--color-success, #22c55e); background-color: color-mix(in srgb, var(--color-success, #22c55e) 12%, transparent); }
  .cc-change.is-down { color: #ef4444; background-color: color-mix(in srgb, #ef4444 12%, transparent); }

  /* Segmented range control — stretches full width for easy tapping. */
  .cc-ranges {
    display: flex;
    gap: 0.2rem;
    padding: 0.25rem;
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .cc-range {
    flex: 1;
    padding: 0.4rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-mute);
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }
  .cc-range:hover { color: var(--color-ink); }
  .cc-range.is-active {
    color: var(--color-ink);
    background-color: var(--color-canvas);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }
  .cc-range:focus-visible { outline: 2px solid var(--color-link); outline-offset: 1px; }

  .cc-chart {
    position: relative;
    width: 100%;
    min-height: 210px;
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    transition: opacity 0.2s ease;
    overflow: hidden;
  }
  .cc-chart.is-loading { opacity: 0.5; }
  .cc-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .cc-svg .cc-axis { fill: var(--color-mute); font-size: 11px; font-family: var(--font-mono); }
  .cc-svg .cc-grid { stroke: var(--color-hairline); stroke-width: 1; }
  .cc-svg .cc-grid-base { stroke: var(--color-hairline-strong); }
  .cc-cross-line { stroke: var(--color-hairline-strong); stroke-width: 1; stroke-dasharray: 3 3; }
  /* Dot is filled with the line's accent colour (set inline in JS) and wrapped
     in a canvas-coloured ring so it stays clearly visible on both themes. */
  .cc-cross-dot { stroke: var(--color-canvas); stroke-width: 2.5; }

  .cc-tip {
    position: absolute;
    /* Anchored to the hovered point (left/top set in JS); floats just above
       the dot, flipping below when the dot is near the top edge. */
    transform: translate(-50%, calc(-100% - 12px));
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0.35rem 0.55rem;
    background-color: var(--color-ink);
    color: var(--color-on-primary, #fff);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    z-index: 2;
  }
  .cc-tip.is-below { transform: translate(-50%, 12px); }
  .cc-tip-val { font-size: 12.5px; font-weight: 600; }
  .cc-tip-date { font-size: 10.5px; opacity: 0.75; }

  .cc-chart-note { margin: 0; font-size: 12px; color: var(--color-mute); text-align: center; }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .cc-io { grid-template-columns: 1fr; }
    .cc-input, .cc-output { height: 52px; font-size: 18px; }
    .cc-chart-head { align-items: center; }
  }
</style>
