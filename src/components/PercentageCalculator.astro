---
// Visual percentage calculator with three modes selected via big pill buttons.
import CalculateButton from './CalculateButton.astro';

interface Props {
  storeKey?: string;
}
const { storeKey } = Astro.props;
---

<div class="calc-device is-wide pct" data-percentage data-store={storeKey ? `percentage:${storeKey}` : undefined}>
  <div class="pct-modes" role="radiogroup" aria-label="Percentage mode">
    <button type="button" class="pct-mode is-active" data-mode="percentOf" aria-pressed="true">X% of Y</button>
    <button type="button" class="pct-mode" data-mode="whatPercent" aria-pressed="false">X is what % of Y</button>
    <button type="button" class="pct-mode" data-mode="change" aria-pressed="false">% change X&#8594;Y</button>
  </div>

  <div class="pct-inputs">
    <label class="pct-field">
      <span class="pct-label" data-label-a>Percentage (X)</span>
      <div class="pct-wrap">
        <input class="pct-input" data-a type="text" inputmode="decimal" placeholder="15" />
        <span class="pct-affix" data-affix-a>%</span>
      </div>
    </label>
    <label class="pct-field">
      <span class="pct-label" data-label-b>Of value (Y)</span>
      <div class="pct-wrap">
        <input class="pct-input" data-b type="text" inputmode="decimal" placeholder="200" />
        <span class="pct-affix" data-affix-b hidden></span>
      </div>
    </label>
  </div>

  <div class="calc-screen pct-screen">
    <div class="calc-screen-expr" data-pct-expr></div>
    <div class="calc-screen-result" data-pct-result>&#8212;</div>
  </div>

  <div class="calc-copy-row">
    <button type="button" class="calc-copy-action" data-copy-btn aria-label="Copy result" title="Copy result">
      <span data-copy-ico><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></span>
      <span data-copy-txt>Copy result</span>
    </button>
  </div>

  <div class="pct-extra" data-pct-extra hidden></div>

  <CalculateButton />

  <div data-history-mount></div>
</div>

<script>
  import { number, percent } from '../lib/format';
  import { loadState, saveState } from '../lib/storage';
  import { createHistoryUI, copyWithFeedback, wireCalculateButton } from '../lib/history';

  type Mode = 'percentOf' | 'whatPercent' | 'change';
  type Saved = { a: string; b: string; mode: Mode };

  const LABELS: Record<Mode, { a: string; b: string; affixA: string; affixB: string }> = {
    percentOf: { a: 'Percentage (X)', b: 'Of value (Y)', affixA: '%', affixB: '' },
    whatPercent: { a: 'Value (X)', b: 'Total (Y)', affixA: '', affixB: '' },
    change: { a: 'From (X)', b: 'To (Y)', affixA: '', affixB: '' },
  };

  function mount(root: HTMLElement): void {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const aEl = q<HTMLInputElement>('[data-a]');
    const bEl = q<HTMLInputElement>('[data-b]');
    const labelA = q('[data-label-a]');
    const labelB = q('[data-label-b]');
    const affixA = q('[data-affix-a]');
    const affixB = q('[data-affix-b]');
    const exprEl = q('[data-pct-expr]');
    const resultEl = q('[data-pct-result]');
    const extraEl = q('[data-pct-extra]');
    const store = root.dataset.store;
    let mode: Mode = 'percentOf';

    // History panel + copy control.
    const historyMount = root.querySelector<HTMLElement>('[data-history-mount]');
    const history = historyMount && store ? createHistoryUI({ key: store, mount: historyMount }) : null;
    const copyBtn = root.querySelector<HTMLElement>('[data-copy-btn]');
    copyBtn?.addEventListener('click', () => copyWithFeedback(copyBtn, resultEl.textContent?.trim() ?? ''));
    // Save the current read-out to history (only fires on Calculate click).
    const commit = () =>
      history?.record(exprEl.textContent?.trim() ?? '', resultEl.textContent?.trim() ?? '') ?? false;

    const persist = () => {
      if (store) saveState(store, { a: aEl.value, b: bEl.value, mode } satisfies Saved);
    };

    function setMode(m: Mode): void {
      mode = m;
      const l = LABELS[m];
      labelA.textContent = l.a;
      labelB.textContent = l.b;
      affixA.textContent = l.affixA;
      affixA.hidden = !l.affixA;
      affixB.textContent = l.affixB;
      affixB.hidden = !l.affixB;
      update();
    }

    // A field is valid only when it is a well-formed finite number. Number()
    // (unlike parseFloat) rejects trailing junk like "12abc", so typos are
    // caught instead of silently truncated.
    const readField = (el: HTMLInputElement) => {
      const raw = el.value.trim();
      const value = raw === '' ? NaN : Number(raw);
      return { raw, value, empty: raw === '', invalid: raw !== '' && !Number.isFinite(value) };
    };

    const fail = (msg: string) => {
      resultEl.textContent = 'Error';
      resultEl.classList.add('is-error');
      exprEl.textContent = msg;
      extraEl.hidden = true;
    };

    function update(): void {
      persist();
      const fa = readField(aEl);
      const fb = readField(bEl);
      const a = fa.value;
      const b = fb.value;
      extraEl.hidden = true;
      resultEl.classList.remove('is-error');
      aEl.classList.toggle('is-invalid', fa.invalid);
      bEl.classList.toggle('is-invalid', fb.invalid);

      // Non-numeric text takes priority so the user sees what to fix.
      if (fa.invalid || fb.invalid) {
        fail('Enter a valid number');
        return;
      }
      // Nothing to compute yet: stay neutral instead of showing an error.
      if (fa.empty || fb.empty) {
        exprEl.textContent = '';
        resultEl.textContent = '\u2014';
        return;
      }

      if (mode === 'percentOf') {
        const r = (a / 100) * b;
        if (!Number.isFinite(r)) { fail('Number is too large'); return; }
        exprEl.textContent = `${number(a, 6)}% \u00D7 ${number(b, 6)}`;
        resultEl.textContent = number(r, 6);
      } else if (mode === 'whatPercent') {
        if (b === 0) { fail('Total (Y) cannot be zero'); return; }
        const r = (a / b) * 100;
        if (!Number.isFinite(r)) { fail('Number is too large'); return; }
        exprEl.textContent = `${number(a, 6)} \u00F7 ${number(b, 6)} \u00D7 100`;
        resultEl.textContent = percent(r, 4);
      } else {
        if (a === 0) { fail('Start value (X) cannot be zero'); return; }
        const change = ((b - a) / Math.abs(a)) * 100;
        if (!Number.isFinite(change)) { fail('Number is too large'); return; }
        exprEl.textContent = `(${number(b, 6)} \u2212 ${number(a, 6)}) \u00F7 |${number(a, 6)}| \u00D7 100`;
        resultEl.textContent = (change >= 0 ? '+' : '') + percent(change, 4);
        extraEl.hidden = false;
        extraEl.innerHTML = `<span class="eyebrow">${change >= 0 ? 'Increase' : 'Decrease'}</span><span>Absolute change ${number(b - a, 6)}</span>`;
      }
    }

    function activateMode(m: Mode): void {
      root.querySelectorAll<HTMLButtonElement>('.pct-mode').forEach((b) => {
        const on = (b.dataset.mode as Mode) === m;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      setMode(m);
    }

    root.querySelectorAll<HTMLButtonElement>('.pct-mode').forEach((btn) => {
      btn.addEventListener('click', () => activateMode(btn.dataset.mode as Mode));
    });
    [aEl, bEl].forEach((el) => el.addEventListener('input', update));
    // History is recorded only when the user presses Calculate.
    wireCalculateButton(root, () => {
      update();
      return commit();
    });

    // Restore a previous session (values + selected mode).
    const saved = store ? loadState<Saved>(store) : null;
    if (saved) {
      aEl.value = saved.a ?? '';
      bEl.value = saved.b ?? '';
      const m: Mode = saved.mode === 'whatPercent' || saved.mode === 'change' ? saved.mode : 'percentOf';
      activateMode(m);
    } else {
      update();
    }
  }

  document.querySelectorAll<HTMLElement>('[data-percentage]').forEach(mount);
</script>

<style>
  .pct { gap: 1.25rem; }
  .pct-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .pct-mode {
    min-height: 46px;
    padding: 0.5rem;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-body);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.06s ease;
  }
  .pct-mode:active { transform: scale(0.97); }
  .pct-mode.is-active { background-color: var(--color-ink); color: var(--color-on-primary); box-shadow: none; }

  .pct-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .pct-field { display: flex; flex-direction: column; gap: 0.375rem; }
  .pct-label { font-size: 13px; color: var(--color-body); font-weight: 500; }
  .pct-wrap { position: relative; display: flex; align-items: center; }
  .pct-input {
    width: 100%;
    height: 54px;
    padding-inline: 0.875rem;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .pct-input:focus { outline: none; box-shadow: inset 0 0 0 2px var(--color-link); }
  .pct-input.is-invalid { box-shadow: inset 0 0 0 2px var(--color-error); }
  .pct-input.is-invalid:focus { box-shadow: inset 0 0 0 2px var(--color-error); }
  .pct-affix { position: absolute; right: 0.875rem; font-size: 18px; color: var(--color-mute); pointer-events: none; }

  .pct-screen { min-height: 88px; }

  .pct-extra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    font-size: 14px;
    color: var(--color-body);
    background-color: var(--color-canvas-soft);
    border-radius: var(--radius-md);
  }

  @media (max-width: 520px) {
    .pct-modes { grid-template-columns: 1fr; }
    .pct-inputs { grid-template-columns: 1fr; }
  }
</style>
