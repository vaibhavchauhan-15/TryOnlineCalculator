---
// Reusable swap button shared across every converter (currency + all unit
// converters) so the swap affordance looks and behaves identically site-wide.
//
// Renders a single <button> that sits in the middle "auto" column of a
// `1fr auto 1fr` converter grid. It carries a full-spin click animation
// (replayed from JS via the `is-swapping` class) and, on mobile, rotates so the
// arrows point down between the stacked from/to fields.
//
// Callers pass their own JS hook attribute (e.g. `data-cc-swap`, `data-uc-swap`)
// plus a context-specific label; extra attributes are spread onto the button.
interface Props {
  label?: string;
  class?: string;
  [key: string]: unknown;
}
const { label = 'Swap', class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class:list={['swap-btn', className]}
  aria-label={label}
  title={label}
  {...rest}
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 16V4M7 4 3 8M7 4l4 4"></path>
    <path d="M17 8v12M17 20l4-4M17 20l-4-4"></path>
  </svg>
</button>

<style>
  .swap-btn {
    --swap-rot: 0deg;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 56px;
    color: var(--color-body);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    cursor: pointer;
    transform: rotate(var(--swap-rot));
    transition: color 0.15s ease, background-color 0.15s ease, transform 0.2s ease, border-color 0.15s ease;
  }
  .swap-btn:hover {
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border-color: var(--color-hairline-strong);
  }
  .swap-btn:focus-visible { outline: 2px solid var(--color-link); outline-offset: 2px; }

  /* Click feedback — a full spin, played via JS so it fires the same on tap and
     mouse click. */
  .swap-btn.is-swapping { animation: swap-spin 0.4s ease; }
  @keyframes swap-spin {
    0%   { transform: rotate(var(--swap-rot)) scale(1); }
    50%  { transform: rotate(calc(var(--swap-rot) + 180deg)) scale(0.9); }
    100% { transform: rotate(calc(var(--swap-rot) + 360deg)) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .swap-btn.is-swapping { animation: none; }
  }

  /* On mobile the from/to fields stack vertically, so rotate the arrows to
     point downward and shrink the control into a centered square. */
  @media (max-width: 640px) {
    .swap-btn {
      --swap-rot: 90deg;
      width: 44px;
      height: 44px;
      justify-self: center;
    }
  }
</style>
