---
import type { FaqItem } from '../lib/types';

interface Props {
  items: FaqItem[];
  title?: string;
  eyebrow?: string;
}

const { items, title = 'Frequently asked questions', eyebrow = 'Answers' } = Astro.props;
---

{items.length > 0 && (
  <section class="faq-block" aria-label={title}>
    <div class="faq-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="faq-title">{title}</h2>
    </div>
    <div class="faq">
      {items.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <div class="faq-answer" set:html={f.a} />
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq-block { margin: 3.5rem 0 2rem; }
  .faq-head { margin-bottom: 1.5rem; }
  .faq-title { margin: 0.375rem 0 0; font-size: clamp(1.375rem, 3vw, 1.75rem); letter-spacing: -0.02em; }

  .faq { display: flex; flex-direction: column; gap: 0.5rem; max-width: 820px; }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer;
    padding: 0.875rem 1rem;
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--color-mute); font-size: 18px; flex: none; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-answer {
    margin: 0;
    padding: 0 1rem 1rem;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-body);
  }
  .faq-answer :global(a) { color: var(--color-link); }
  .faq-answer :global(a:hover) { text-decoration: underline; }
</style>
