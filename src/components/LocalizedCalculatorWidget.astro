---
// Localized calculator widget (Task 6).
//
// Renders a live form for any engine that exposes presentation-neutral field
// descriptors, with every label localized server-side from the calculator's
// MDX label pack. The initial result is computed + resolved on the server (SEO
// + no-JS), and the label packs are serialized into the DOM so the client
// controller (lib/i18n/localized-client.ts) can re-render live as the user
// types and whenever a formatting preference changes.

import type { LabelPack } from '../lib/i18n/resolver';
import { createResolver, lookupText } from '../lib/i18n/resolver';
import type { FormatContext } from '../lib/i18n/format-locale';
import { getEngine } from '../lib/calculator-engine';
import { renderLocalizedResultHTML } from '../lib/i18n/render-localized';
import { STATIC_USD_PER } from '../lib/rates';
import CalculateButton from './CalculateButton.astro';
import CurrencySelect from './CurrencySelect.astro';

interface Props {
  slug: string;
  pack: LabelPack;
  fallback: LabelPack;
  ctx: FormatContext;
  /** Localized chrome strings (reset/copy/etc.) from the UI pack. */
  chrome: Record<string, string>;
}

const { slug, pack, fallback, ctx, chrome } = Astro.props;

const engine = getEngine(slug);
if (!engine || !engine.fields || !engine.parseInput) {
  throw new Error(`LocalizedCalculatorWidget: engine "${slug}" has no field descriptors`);
}

const fields = engine.fields();
const label = (key: string) => lookupText(pack, fallback, key);

// Currency symbol for monetary field prefixes, derived from the seed region's
// currency. The client repaints this when the visitor's currency changes.
function currencySymbol(code: string, locale: string): string {
  try {
    const parts = new Intl.NumberFormat(locale, { style: 'currency', currency: code }).formatToParts(0);
    return parts.find((p) => p.type === 'currency')?.value ?? code;
  } catch {
    return code;
  }
}
const symbol = currencySymbol(ctx.currency, ctx.numberFormat);
const usesCurrency = fields.some((f) => f.currency);

// Default form values → SSR compute seed (formatted for the seed region).
const values: Record<string, string> = {};
for (const f of fields) values[f.name] = f.defaultValue;
const runtime: Record<string, unknown> = slug === 'currency-converter' ? { usdPer: STATIC_USD_PER } : {};
const seedInput = engine.parseInput(values, runtime);
const seedResult = engine.compute(seedInput);
const seedCtx: FormatContext = (values.unitSystem === 'metric' || values.unitSystem === 'imperial')
  ? { ...ctx, unitSystem: values.unitSystem as FormatContext['unitSystem'] }
  : ctx;
const initialHTML = renderLocalizedResultHTML(createResolver(pack, fallback, seedCtx).resolve(seedResult));

const isVisible = (f: (typeof fields)[number]) =>
  !f.showWhen || f.showWhen.equals.includes(values[f.showWhen.field]);

// Serialized packs handed to the client controller.
const packsJSON = JSON.stringify({ pack, fallback });
---

<div class="calc has-visuals" data-localized-calc={slug}>
  <div class="calc-grid">
    <form class="calc-form" data-calc-form autocomplete="off" novalidate>
      <div class="calc-form-head">
        <span class="eyebrow">{chrome.enterDetails ?? 'Enter details'}</span>
        {usesCurrency && <CurrencySelect />}
      </div>

      <div class="field-grid">
        {fields.map((f) => (
          <div
            class={`field-group ${f.span === 2 ? 'span-2' : ''}`}
            hidden={!isVisible(f)}
            data-show-field={f.showWhen?.field}
            data-show-values={f.showWhen?.equals.join('|')}
          >
            <label class="field-label" for={`lf-${slug}-${f.name}`}>{label(f.labelKey)}</label>

            {f.type === 'select' && (
              <select id={`lf-${slug}-${f.name}`} name={f.name} class="field" disabled={!isVisible(f)}>
                {f.options?.map((o) => (
                  <option value={o.value} selected={f.defaultValue === o.value}>{label(o.labelKey)}</option>
                ))}
              </select>
            )}

            {f.type === 'radio' && (
              <div class="radio-group" role="radiogroup" aria-label={label(f.labelKey)}>
                {f.options?.map((o) => (
                  <label class="radio-pill">
                    <input type="radio" name={f.name} value={o.value} checked={f.defaultValue === o.value} disabled={!isVisible(f)} />
                    <span>{label(o.labelKey)}</span>
                  </label>
                ))}
              </div>
            )}

            {(f.type === 'number' || f.type === 'text') && (
              <div class={`field-wrap ${f.currency ? 'has-prefix' : ''} ${f.suffixKey ? 'has-suffix' : ''} ${f.type === 'number' ? 'has-stepper' : ''}`}>
                {f.currency && <span class="field-affix field-prefix" data-currency-prefix>{symbol}</span>}
                <input
                  id={`lf-${slug}-${f.name}`}
                  name={f.name}
                  class="field"
                  type={f.type}
                  value={f.defaultValue}
                  min={f.min}
                  max={f.max}
                  step={f.step}
                  inputmode={f.type === 'number' ? 'decimal' : undefined}
                  disabled={!isVisible(f)}
                />
                {f.suffixKey && <span class="field-affix field-suffix">{label(f.suffixKey)}</span>}
                {f.type === 'number' && (
                  <div class="field-stepper">
                    <button type="button" class="field-step" data-step-up tabindex="-1" aria-label={`+ ${label(f.labelKey)}`}>
                      <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6.5 5 3.5l3 3" /></svg>
                    </button>
                    <button type="button" class="field-step" data-step-down tabindex="-1" aria-label={`- ${label(f.labelKey)}`}>
                      <svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5l3-3" /></svg>
                    </button>
                  </div>
                )}
              </div>
            )}

            {f.helpKey && <span class="field-help">{label(f.helpKey)}</span>}
          </div>
        ))}
      </div>

      <CalculateButton label={chrome.calculate ?? 'Calculate'} />

      <div class="calc-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-calc-reset>{chrome.reset ?? 'Reset'}</button>
      </div>
    </form>

    <div class="calc-output">
      <div class="calc-output-head">
        <span class="eyebrow">{chrome.result ?? 'Result'}</span>
        <span class="calc-live-hint"><span class="calc-live-dot" aria-hidden="true"></span>{chrome.updatesAsYouType ?? 'Updates as you type'}</span>
      </div>
      <div class="calc-output-body" data-calc-output aria-live="polite">
        <Fragment set:html={initialHTML} />
      </div>
    </div>
  </div>

  <script type="application/json" data-packs set:html={packsJSON}></script>
</div>

{usesCurrency && (
  <span class="sr-only" data-currency-note>{chrome.currencyNote ?? ''}</span>
)}

<script>
  import '../lib/i18n/localized-client';
</script>

<style>
  /* Form + layout styles mirror CalculatorWidget (kept in sync); the injected
     .result-* classes are global (styles/global.css). */
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  .calc { min-width: 0; }
  .calc-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 880px) {
    .calc-grid { grid-template-columns: minmax(0, 360px) minmax(0, 1fr); align-items: start; gap: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .calc.has-visuals .calc-grid { grid-template-columns: minmax(300px, 360px) minmax(0, 1fr); gap: 1.75rem; }
  }

  .calc-form { display: flex; flex-direction: column; padding: 1.375rem; background-color: var(--color-canvas); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  @media (min-width: 880px) { .calc-form { position: sticky; top: 80px; } }
  .calc-form-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1rem; }

  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field-group { display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
  .field-group.span-2 { grid-column: 1 / -1; }
  .field-label { font-size: 14px; font-weight: 500; color: var(--color-ink); }
  .field-help { font-size: 12.5px; line-height: 1.45; color: var(--color-mute); }

  .field-wrap { position: relative; display: flex; align-items: center; }
  .field-affix { position: absolute; font-size: 13px; color: var(--color-mute); pointer-events: none; }
  .field-prefix { left: 0.75rem; }
  .field-suffix { right: 0.75rem; }
  .has-prefix .field { padding-left: 1.75rem; }
  .has-suffix .field { padding-right: 3rem; }

  .has-stepper .field { padding-right: 2.25rem; }
  .has-stepper.has-suffix .field { padding-right: 4rem; }
  .has-stepper.has-suffix .field-suffix { right: 2.5rem; }
  .field-wrap :global(input[type='number']::-webkit-outer-spin-button),
  .field-wrap :global(input[type='number']::-webkit-inner-spin-button) { -webkit-appearance: none; margin: 0; }
  .field-wrap :global(input[type='number']) { -moz-appearance: textfield; appearance: textfield; }

  .field-stepper { position: absolute; top: 1px; right: 1px; bottom: 1px; width: 1.75rem; display: flex; flex-direction: column; border-left: 1px solid var(--color-hairline); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; overflow: hidden; }
  .field-step { flex: 1; display: flex; align-items: center; justify-content: center; padding: 0; border: 0; background-color: var(--color-canvas); color: var(--color-mute); cursor: pointer; transition: background-color 0.12s ease, color 0.12s ease; -webkit-user-select: none; user-select: none; touch-action: none; }
  .field-step + .field-step { border-top: 1px solid var(--color-hairline); }
  .field-step:hover { background-color: var(--color-canvas-soft-2); color: var(--color-ink); }
  .field-step:active { background-color: var(--color-hairline); color: var(--color-ink); }
  .field-step svg { display: block; }
  .field:disabled ~ .field-stepper { opacity: 0.5; pointer-events: none; }

  .radio-group { display: flex; gap: 0.375rem; flex-wrap: wrap; }
  .radio-pill { position: relative; flex: 1; min-width: fit-content; }
  .radio-pill input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .radio-pill span { display: flex; align-items: center; justify-content: center; min-height: 40px; padding: 0.5rem 0.75rem; font-size: 14px; text-align: center; border: 1px solid var(--color-hairline); border-radius: var(--radius-sm); color: var(--color-body); transition: all 0.15s ease; white-space: nowrap; }
  .radio-pill input:checked + span { background-color: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); }
  .radio-pill input:focus-visible + span { box-shadow: 0 0 0 3px var(--color-link-soft); }

  .calc-form :global(.calc-calculate-row) { margin-top: 1.25rem; }
  .calc-actions { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .calc-actions .btn { flex: 1; }

  .calc-output { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .calc-output-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding-inline: 0.125rem; }
  .calc-live-hint { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 12px; color: var(--color-mute); }
  .calc-live-dot { width: 7px; height: 7px; border-radius: 50%; background-color: var(--color-success); box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 55%, transparent); animation: lcalc-live-pulse 2s ease-out infinite; }
  @keyframes lcalc-live-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 55%, transparent); }
    70% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-success) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) { .calc-live-dot { animation: none; } }

  @media (max-width: 560px) {
    .calc-form { padding: 1.125rem; }
    .field-grid { grid-template-columns: 1fr; }
    .calc-form-head { flex-direction: column; align-items: stretch; gap: 0.625rem; }
  }
</style>
