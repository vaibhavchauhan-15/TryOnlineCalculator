---
// Guided GPA calculator. Instead of a raw textarea, students pick a letter
// grade from a dropdown and type the credit hours per course, add/remove
// courses with one tap, and watch the weighted GPA update live. The result +
// gauge are produced by the shared gpa-calculator compute() so the maths and
// styling stay identical to the rest of the site.
import CalculateButton from './CalculateButton.astro';
import { educationCalculators } from '../lib/calculators/education';
import { renderResultsHTML } from '../lib/render';

interface Props {
  storeKey?: string;
}
const { storeKey } = Astro.props;

const GRADES = ['A+', 'A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D+', 'D', 'D-', 'F'];
const seed = [
  { grade: 'A', credits: '3' },
  { grade: 'B+', credits: '4' },
  { grade: 'A-', credits: '3' },
  { grade: 'B', credits: '3' },
];

const calc = educationCalculators.find((c) => c.slug === 'gpa-calculator')!;
const initial = renderResultsHTML(
  calc.compute({ courses: seed.map((r) => `${r.grade}, ${r.credits}`).join('\n') }),
);
---

<div class="edu-calc has-visuals" data-gpa data-store={storeKey ? `gpa:${storeKey}` : undefined}>
  <div class="edu-grid">
    <div class="edu-card">
      <div class="edu-card-head">
        <span class="edu-card-title">Your courses</span>
        <span class="edu-card-sub">Pick each grade and type its credit hours. Add a row per course.</span>
      </div>

      <div class="edu-rows" data-rows>
        {seed.map((row, i) => (
          <div class="edu-row" data-row>
            <div class="edu-row-body">
              <span class="edu-row-index">Course {i + 1}</span>
              <div class="edu-row-fields gpa-fields">
                <label class="edu-field">
                  <span class="edu-field-label">Grade</span>
                  <select class="field" data-grade aria-label={`Course ${i + 1} grade`}>
                    {GRADES.map((g) => (
                      <option value={g} selected={g === row.grade}>{g}</option>
                    ))}
                  </select>
                </label>
                <label class="edu-field">
                  <span class="edu-field-label">Credits</span>
                  <input
                    class="field"
                    data-credits
                    type="number"
                    inputmode="decimal"
                    min="0"
                    step="0.5"
                    value={row.credits}
                    aria-label={`Course ${i + 1} credits`}
                  />
                </label>
              </div>
            </div>
            <button type="button" class="edu-remove" data-remove aria-label="Remove course">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
            </button>
          </div>
        ))}
      </div>

      <button type="button" class="edu-add" data-add>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
        Add course
      </button>

      <CalculateButton />

      <div class="edu-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-reset>Reset</button>
        <button type="button" class="btn btn-secondary btn-sm" data-copy>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

    <div class="edu-output">
      <div class="edu-output-head">
        <span class="eyebrow">Result</span>
        <span class="edu-live-hint"><span class="edu-live-dot" aria-hidden="true"></span>Updates as you type</span>
      </div>
      <div data-out set:html={initial}></div>
      <div data-history-mount></div>
    </div>
  </div>

  <template data-row-template>
    <div class="edu-row" data-row>
      <div class="edu-row-body">
        <span class="edu-row-index">Course</span>
        <div class="edu-row-fields gpa-fields">
          <label class="edu-field">
            <span class="edu-field-label">Grade</span>
            <select class="field" data-grade aria-label="Course grade">
              {GRADES.map((g) => (
                <option value={g} selected={g === 'A'}>{g}</option>
              ))}
            </select>
          </label>
          <label class="edu-field">
            <span class="edu-field-label">Credits</span>
            <input class="field" data-credits type="number" inputmode="decimal" min="0" step="0.5" value="3" aria-label="Course credits" />
          </label>
        </div>
      </div>
      <button type="button" class="edu-remove" data-remove aria-label="Remove course">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
      </button>
    </div>
  </template>
</div>

<script>
  import { educationCalculators } from '../lib/calculators/education';
  import { renderResultsHTML } from '../lib/render';
  import { enhanceSelects } from '../lib/dropdown';
  import { loadState, saveState, clearState } from '../lib/storage';
  import { createHistoryUI, copyWithFeedback, wireCalculateButton } from '../lib/history';

  type Saved = { rows: { grade: string; credits: string }[] };

  const calc = educationCalculators.find((c) => c.slug === 'gpa-calculator')!;

  function mount(root: HTMLElement): void {
    const rowsWrap = root.querySelector<HTMLElement>('[data-rows]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const tpl = root.querySelector<HTMLTemplateElement>('[data-row-template]')!;
    const store = root.dataset.store;

    const historyMount = root.querySelector<HTMLElement>('[data-history-mount]');
    const history = historyMount && store ? createHistoryUI({ key: store, mount: historyMount }) : null;

    const rowsData = () =>
      Array.from(rowsWrap.querySelectorAll<HTMLElement>('[data-row]')).map((r) => ({
        grade: r.querySelector<HTMLSelectElement>('[data-grade]')!.value,
        credits: r.querySelector<HTMLInputElement>('[data-credits]')!.value.trim(),
      }));

    const renumber = () => {
      rowsWrap.querySelectorAll<HTMLElement>('[data-row]').forEach((r, i) => {
        const idx = r.querySelector('[data-row-index]') ?? r.querySelector('.edu-row-index');
        if (idx) idx.textContent = `Course ${i + 1}`;
      });
      // Keep at least one row; disable the lone remove button.
      const removeBtns = rowsWrap.querySelectorAll<HTMLButtonElement>('[data-remove]');
      removeBtns.forEach((b) => (b.disabled = removeBtns.length <= 1));
    };

    const persist = () => {
      if (store) saveState(store, { rows: rowsData() } satisfies Saved);
    };

    const update = () => {
      const courses = rowsData()
        .filter((r) => r.grade)
        .map((r) => `${r.grade}, ${r.credits || '0'}`)
        .join('\n');
      out.innerHTML = renderResultsHTML(calc.compute({ courses }));
      persist();
    };

    const addRow = (grade = 'A', credits = '3'): void => {
      const frag = tpl.content.cloneNode(true) as DocumentFragment;
      const row = frag.querySelector<HTMLElement>('[data-row]')!;
      row.querySelector<HTMLSelectElement>('[data-grade]')!.value = grade;
      row.querySelector<HTMLInputElement>('[data-credits]')!.value = credits;
      rowsWrap.appendChild(row);
      enhanceSelects(row);
      renumber();
    };

    // Delegated events on the rows container.
    rowsWrap.addEventListener('input', update);
    rowsWrap.addEventListener('change', update);
    rowsWrap.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-remove]');
      if (!btn) return;
      if (rowsWrap.querySelectorAll('[data-row]').length <= 1) return;
      btn.closest('[data-row]')?.remove();
      renumber();
      update();
    });

    root.querySelector<HTMLButtonElement>('[data-add]')?.addEventListener('click', () => {
      addRow();
      update();
    });

    // Copy the headline result (delegated — the output is re-rendered).
    out.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-result]');
      if (!btn) return;
      void copyWithFeedback(btn, out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '');
    });

    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');
    copyBtn?.addEventListener('click', () => {
      const val = out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '';
      void copyWithFeedback(copyBtn, val);
    });

    root.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
      if (store) clearState(store);
      rowsWrap.innerHTML = '';
      [
        { grade: 'A', credits: '3' },
        { grade: 'B+', credits: '4' },
        { grade: 'A-', credits: '3' },
        { grade: 'B', credits: '3' },
      ].forEach((r) => addRow(r.grade, r.credits));
      update();
    });

    const commit = (): boolean => {
      const value = out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '';
      if (!value) return false;
      const summary = rowsData()
        .filter((r) => r.grade)
        .map((r) => `${r.grade}·${r.credits || '0'}`)
        .join(' ');
      return history?.record(`GPA (${summary})`, value) ?? false;
    };
    wireCalculateButton(root, () => {
      update();
      return commit();
    });

    // Restore a previous session.
    const saved = store ? loadState<Saved>(store) : null;
    if (saved && Array.isArray(saved.rows) && saved.rows.length) {
      rowsWrap.innerHTML = '';
      saved.rows.forEach((r) => addRow(r.grade ?? 'A', r.credits ?? ''));
    } else {
      renumber();
    }
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-gpa]').forEach(mount);
</script>

<style>
  .gpa-fields { grid-template-columns: 1fr 110px; }
  @media (max-width: 380px) {
    .gpa-fields { grid-template-columns: 1fr 90px; }
  }
</style>
