---
// Reusable, dependency-free unit converter widget.
//
// Renders a "from → to" pair plus an "all units" grid, and converts live in the
// browser. Linear types convert through a base factor; temperature converts via
// explicit formulas. The full config is embedded as JSON so the client runs the
// exact same numbers defined in src/lib/converters.ts.
import type { ConverterConfig } from '../lib/converters';

interface Props {
  converter: ConverterConfig;
}
const { converter } = Astro.props;
const { units, defaultFrom, defaultTo, defaultValue, kind, precision, slug } = converter;

// Serialise only what the client needs — keeps the inline payload tiny.
const clientConfig = {
  kind,
  precision,
  units: units.map((u) => ({ id: u.id, name: u.name, symbol: u.symbol, factor: u.factor })),
};
---

<section
  class="uc card"
  data-uc
  data-slug={slug}
  aria-label={`${converter.title} tool`}
>
  <script type="application/json" data-uc-config set:html={JSON.stringify(clientConfig)} />

  <div class="uc-io">
    <!-- FROM -->
    <div class="uc-field">
      <label class="uc-label" for={`uc-from-${slug}`}>From</label>
      <div class="uc-row">
        <input
          id={`uc-from-${slug}`}
          class="uc-input"
          data-uc-value
          type="text"
          inputmode="decimal"
          autocomplete="off"
          value={defaultValue}
          aria-label="Value to convert"
        />
        <div class="uc-select-wrap">
          <select class="uc-select" data-uc-from aria-label="Convert from unit">
            {units.map((u) => (
              <option value={u.id} selected={u.id === defaultFrom}>{u.name} ({u.symbol})</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <!-- SWAP -->
    <button type="button" class="uc-swap" data-uc-swap aria-label="Swap units" title="Swap units">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 16V4M7 4 3 8M7 4l4 4"></path>
        <path d="M17 8v12M17 20l4-4M17 20l-4-4"></path>
      </svg>
    </button>

    <!-- TO -->
    <div class="uc-field">
      <label class="uc-label" for={`uc-to-${slug}`}>To</label>
      <div class="uc-row">
        <output id={`uc-to-${slug}`} class="uc-output" data-uc-result aria-live="polite">—</output>
        <div class="uc-select-wrap">
          <select class="uc-select" data-uc-to aria-label="Convert to unit">
            {units.map((u) => (
              <option value={u.id} selected={u.id === defaultTo}>{u.name} ({u.symbol})</option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Live equation + copy -->
  <div class="uc-eq-row">
    <p class="uc-eq" data-uc-eq></p>
    <button type="button" class="uc-copy" data-uc-copy aria-label="Copy result" title="Copy result">
      <span data-copy-ico><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></span>
      <span data-copy-txt>Copy</span>
    </button>
  </div>

  <!-- All-units grid -->
  <div class="uc-all">
    <span class="eyebrow uc-all-head">All units</span>
    <div class="uc-grid" data-uc-grid>
      {units.map((u) => (
        <button type="button" class="uc-cell" data-uc-cell={u.id} title={`Copy ${u.name}`}>
          <span class="uc-cell-val" data-uc-cell-val>—</span>
          <span class="uc-cell-unit">{u.symbol}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import { copyWithFeedback, copyText } from '../lib/history';

  type Unit = { id: string; name: string; symbol: string; factor?: number };
  type Config = { kind: 'linear' | 'temperature'; precision: number; units: Unit[] };

  // ---- Conversion core --------------------------------------------------
  // Linear: everything routes through a base unit via `factor`.
  // Temperature: Celsius is the base; explicit offset formulas are used.
  function toBase(kind: string, id: string, v: number, factor?: number): number {
    if (kind === 'temperature') {
      switch (id) {
        case 'c': return v;
        case 'f': return (v - 32) * (5 / 9);
        case 'k': return v - 273.15;
        case 'r': return (v - 491.67) * (5 / 9);
        default: return v;
      }
    }
    return v * (factor ?? 1);
  }

  function fromBase(kind: string, id: string, base: number, factor?: number): number {
    if (kind === 'temperature') {
      switch (id) {
        case 'c': return base;
        case 'f': return base * (9 / 5) + 32;
        case 'k': return base + 273.15;
        case 'r': return (base + 273.15) * (9 / 5);
        default: return base;
      }
    }
    return base / (factor ?? 1);
  }

  // Human-friendly formatting: grouped thousands, significant precision, and
  // scientific notation only for extreme magnitudes.
  function fmt(n: number): string {
    if (!Number.isFinite(n)) return '—';
    if (n === 0) return '0';
    const abs = Math.abs(n);
    if (abs < 1e-6 || abs >= 1e15) {
      return n.toExponential(4).replace('e+', '×10^').replace('e', '×10^');
    }
    return n.toLocaleString('en-US', { maximumSignificantDigits: 8 });
  }

  function parseValue(raw: string): number {
    const cleaned = raw.trim().replace(/,/g, '');
    if (cleaned === '' || cleaned === '-' || cleaned === '.') return NaN;
    const n = Number(cleaned);
    return Number.isFinite(n) ? n : NaN;
  }

  function mount(root: HTMLElement): void {
    const cfgEl = root.querySelector<HTMLScriptElement>('[data-uc-config]');
    if (!cfgEl) return;
    const cfg = JSON.parse(cfgEl.textContent || '{}') as Config;
    const byId = new Map(cfg.units.map((u) => [u.id, u]));

    const valueEl = root.querySelector<HTMLInputElement>('[data-uc-value]')!;
    const fromEl = root.querySelector<HTMLSelectElement>('[data-uc-from]')!;
    const toEl = root.querySelector<HTMLSelectElement>('[data-uc-to]')!;
    const resultEl = root.querySelector<HTMLElement>('[data-uc-result]')!;
    const eqEl = root.querySelector<HTMLElement>('[data-uc-eq]')!;
    const copyBtn = root.querySelector<HTMLElement>('[data-uc-copy]')!;
    const swapBtn = root.querySelector<HTMLElement>('[data-uc-swap]')!;
    const cells = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-uc-cell]'));

    const sym = (id: string) => byId.get(id)?.symbol ?? '';

    function update(): void {
      const from = fromEl.value;
      const to = toEl.value;
      const raw = valueEl.value;
      const v = parseValue(raw);

      const fromU = byId.get(from);
      const toU = byId.get(to);
      if (!fromU || !toU) return;

      if (Number.isNaN(v)) {
        resultEl.textContent = '—';
        eqEl.textContent = raw.trim() === '' ? '' : 'Enter a valid number';
        resultEl.classList.toggle('is-error', raw.trim() !== '');
        cells.forEach((c) => (c.querySelector('[data-uc-cell-val]')!.textContent = '—'));
        return;
      }
      resultEl.classList.remove('is-error');

      const base = toBase(cfg.kind, from, v, fromU.factor);
      const out = fromBase(cfg.kind, to, base, toU.factor);
      resultEl.textContent = fmt(out);
      eqEl.textContent = `${fmt(v)} ${sym(from)} = ${fmt(out)} ${sym(to)}`;

      // Fill the all-units grid from the same base value.
      cells.forEach((cell) => {
        const id = cell.getAttribute('data-uc-cell')!;
        const u = byId.get(id);
        if (!u) return;
        const val = fromBase(cfg.kind, id, base, u.factor);
        cell.querySelector('[data-uc-cell-val]')!.textContent = fmt(val);
        cell.classList.toggle('is-active', id === to);
      });
    }

    valueEl.addEventListener('input', update);
    fromEl.addEventListener('change', update);
    toEl.addEventListener('change', update);

    swapBtn.addEventListener('click', () => {
      const f = fromEl.value;
      fromEl.value = toEl.value;
      toEl.value = f;
      // Relabel the custom dropdown triggers after the programmatic swap.
      fromEl.dispatchEvent(new Event('cs:sync', { bubbles: true }));
      toEl.dispatchEvent(new Event('cs:sync', { bubbles: true }));
      // If there's a current numeric result, carry it into the value box so the
      // swap reads like a true reversal.
      const current = resultEl.textContent?.trim();
      if (current && current !== '—' && !resultEl.classList.contains('is-error')) {
        valueEl.value = current.replace(/,/g, '');
      }
      update();
    });

    copyBtn.addEventListener('click', () => {
      const txt = resultEl.textContent?.trim() ?? '';
      if (txt && txt !== '—') void copyWithFeedback(copyBtn, txt);
    });

    // Tapping any grid cell copies that unit's value.
    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        const val = cell.querySelector('[data-uc-cell-val]')!.textContent?.trim() ?? '';
        if (val && val !== '—') {
          void copyText(val);
          cell.classList.add('is-copied');
          window.setTimeout(() => cell.classList.remove('is-copied'), 700);
        }
      });
    });

    update();
  }

  document.querySelectorAll<HTMLElement>('[data-uc]').forEach(mount);
</script>

<style>
  .uc {
    padding: clamp(1rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* From / swap / To layout */
  .uc-io {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 0.75rem;
  }
  .uc-field { min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .uc-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .uc-row { display: flex; flex-direction: column; gap: 0.5rem; }

  .uc-input,
  .uc-output {
    width: 100%;
    height: 56px;
    padding-inline: 0.875rem;
    font-family: var(--font-mono);
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 600;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .uc-input:focus { outline: none; box-shadow: inset 0 0 0 2px var(--color-link); }

  .uc-output {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow-x: auto;
    white-space: nowrap;
    background-color: #171717;
    color: #ffffff;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .uc-output.is-error { color: #ff8f92; font-size: 16px; }

  .uc-select-wrap { position: relative; }
  .uc-select {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 44px;
    padding-inline: 0.75rem 2rem;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .uc-select:hover { border-color: var(--color-hairline-strong); }
  .uc-select:focus { outline: none; border-color: var(--color-link); box-shadow: 0 0 0 3px var(--color-link-soft); }
  .uc-select-wrap::after {
    content: '';
    position: absolute;
    right: 0.75rem;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--color-mute);
    border-bottom: 2px solid var(--color-mute);
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }
  /* Once enhanced into the custom dropdown, drop the native-select chevron —
     the custom trigger draws its own. */
  .uc-select-wrap:has(.cs)::after { display: none; }

  /* Swap button — sits in the middle column, aligned to the inputs' row */
  .uc-swap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 56px;
    color: var(--color-body);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, transform 0.2s ease, border-color 0.15s ease;
  }
  .uc-swap:hover { color: var(--color-ink); background-color: var(--color-canvas-soft-2); border-color: var(--color-hairline-strong); }
  .uc-swap:active { transform: rotate(180deg) scale(0.94); }
  .uc-swap:focus-visible { outline: 2px solid var(--color-link); outline-offset: 2px; }

  /* Equation + copy */
  .uc-eq-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 24px;
  }
  .uc-eq {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-body);
    word-break: break-word;
  }
  .uc-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: 0 0 auto;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-body);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, transform 0.06s ease;
  }
  .uc-copy:hover { color: var(--color-ink); background-color: var(--color-canvas-soft); }
  .uc-copy:active { transform: scale(0.97); }
  .uc-copy.is-copied { color: var(--color-success); box-shadow: inset 0 0 0 1px var(--color-success); }
  .uc-copy svg { display: block; }

  /* All-units grid */
  .uc-all { display: flex; flex-direction: column; gap: 0.625rem; }
  .uc-all-head { color: var(--color-mute); }
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.5rem;
  }
  .uc-cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 0.625rem 0.75rem;
    text-align: left;
    background-color: var(--color-canvas-soft);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    cursor: pointer;
    transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.06s ease;
  }
  .uc-cell:hover { background-color: var(--color-canvas-soft-2); }
  .uc-cell:active { transform: scale(0.98); }
  .uc-cell.is-active { box-shadow: inset 0 0 0 2px var(--color-link); }
  .uc-cell.is-copied { box-shadow: inset 0 0 0 2px var(--color-success); }
  .uc-cell-val {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .uc-cell-unit { font-size: 12px; color: var(--color-mute); }

  /* Responsive: stack the from/to pair and rotate the swap on small screens */
  @media (max-width: 640px) {
    .uc-io { grid-template-columns: 1fr; }
    .uc-swap {
      width: 100%;
      height: 40px;
      transform: rotate(90deg);
      justify-self: center;
      max-width: 120px;
    }
    .uc-swap:active { transform: rotate(270deg) scale(0.94); }
    .uc-input, .uc-output { height: 52px; font-size: 18px; }
  }
</style>
