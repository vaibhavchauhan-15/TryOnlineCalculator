---
// Interactive multi-unit converter: length, weight, temperature, speed,
// volume, area, currency + a BMI tab. One tabbed device, instant bidirectional
// conversion, no dependencies. Tabs are rendered server-side for a fast first
// paint; the converter body is built on mount so switching categories is cheap.
import { convCategories } from '../lib/convert';

interface Props {
  /** Category id to open on first paint (e.g. "length"). Defaults to "length". */
  initial?: string;
}
const { initial } = Astro.props;

const tabs = [
  ...convCategories.map((c) => ({ id: c.id, name: c.name, icon: c.icon })),
  {
    id: 'bmi',
    name: 'BMI',
    icon: 'M12 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z M9 21v-8l-2-3a5 5 0 0 1 10 0l-2 3v8',
  },
];
const activeId = tabs.some((t) => t.id === initial) ? initial : tabs[0].id;
---

<section class="uc card-lg" data-unit-converter data-initial={initial} aria-label="Unit converter">
  <div class="uc-tabs" role="tablist" aria-label="Conversion type" data-uc-tabs>
    {tabs.map((t) => (
      <button
        type="button"
        role="tab"
        class="uc-tab"
        data-cat={t.id}
        id={`uc-tab-${t.id}`}
        aria-selected={t.id === activeId ? 'true' : 'false'}
        tabindex={t.id === activeId ? '0' : '-1'}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon}></path></svg>
        <span>{t.name}</span>
      </button>
    ))}
  </div>

  <div class="uc-body" data-uc-body role="tabpanel" aria-live="polite">
    <div class="uc-skeleton" aria-hidden="true"></div>
  </div>

  <noscript>
    <p class="uc-noscript">This converter needs JavaScript. The reference tables and guides below work without it.</p>
  </noscript>
</section>

<script>
  import {
    convCategories,
    convertUnit,
    convertCurrency,
    formatValue,
    currencies,
    fallbackRates,
    type ConvCategory,
    type Unit,
  } from '../lib/convert';
  import { loadState, saveState } from '../lib/storage';
  import { copyWithFeedback, COPY_ICON } from '../lib/history';

  type Side = 'from' | 'to';

  const SWAP_ICON =
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M7 4 4 7M7 4l3 3"></path><path d="M17 20V4M17 20l3-3M17 20l-3-3"></path></svg>';

  const esc = (s: string) =>
    String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

  // Parse a loosely-typed field (strips commas / stray symbols). '' → NaN.
  const parse = (s: string): number => {
    const cleaned = s.replace(/[^0-9.\-eE]/g, '');
    if (cleaned === '') return NaN;
    const n = Number(cleaned);
    return Number.isFinite(n) ? n : NaN;
  };

  // A compact, editable representation for an <input> (no grouping commas).
  const plain = (n: number): string => {
    if (!Number.isFinite(n)) return '';
    return parseFloat(n.toPrecision(10)).toString();
  };

  const catById = new Map<string, ConvCategory>(convCategories.map((c) => [c.id, c]));

  function mount(root: HTMLElement): void {
    const tabsEl = root.querySelector<HTMLElement>('[data-uc-tabs]')!;
    const bodyEl = root.querySelector<HTMLElement>('[data-uc-body]')!;
    const tabButtons = Array.from(tabsEl.querySelectorAll<HTMLButtonElement>('.uc-tab'));

    // Currency rates — start from the bundled fallback, refresh live on demand.
    const rates: Record<string, number> = { ...fallbackRates };
    let ratesLive = false;
    let ratesDate: Date | null = null;
    let ratesFetched = false;

    async function refreshRates(after?: () => void): Promise<void> {
      if (ratesFetched) return;
      ratesFetched = true;
      try {
        const res = await fetch('https://open.er-api.com/v6/latest/USD', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.rates) {
          for (const c of currencies) {
            const r = data.rates[c.code];
            if (typeof r === 'number' && r > 0) rates[c.code] = r;
          }
          ratesLive = true;
          ratesDate = data.time_last_update_utc ? new Date(data.time_last_update_utc) : new Date();
          after?.();
        }
      } catch {
        /* offline / blocked — keep indicative fallback rates */
      }
    }

    // ---- Standard converter (length/weight/temperature/speed/volume/area/currency) ----
    function buildConverter(cat: ConvCategory): void {
      const isCurrency = cat.id === 'currency';
      const saved = loadState<{ from: string; to: string; val: string; source: Side }>(`convert:${cat.id}`);

      const fromSel = saved?.from ?? cat.defaultFrom;
      const toSel = saved?.to ?? cat.defaultTo;
      const seedVal = saved?.val ?? String(cat.sample);

      const optionsHtml = (selected: string): string => {
        if (isCurrency) {
          return currencies
            .map((c) => `<option value="${c.code}"${c.code === selected ? ' selected' : ''}>${c.code} — ${esc(c.name)}</option>`)
            .join('');
        }
        return cat.units
          .map((u) => `<option value="${u.id}"${u.id === selected ? ' selected' : ''}>${esc(u.name)} (${esc(u.symbol)})</option>`)
          .join('');
      };

      bodyEl.innerHTML = `
        <div class="uc-convert">
          <div class="uc-pair">
            <div class="uc-cell">
              <label class="uc-flabel" for="uc-from-val">From</label>
              <div class="uc-inputrow">
                <input class="uc-input" id="uc-from-val" data-from-val type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="0" />
                <select class="uc-select" data-from-unit aria-label="Convert from unit">${optionsHtml(fromSel)}</select>
              </div>
            </div>
            <button type="button" class="uc-swap" data-swap aria-label="Swap units">${SWAP_ICON}</button>
            <div class="uc-cell">
              <label class="uc-flabel" for="uc-to-val">To</label>
              <div class="uc-inputrow">
                <input class="uc-input" id="uc-to-val" data-to-val type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="0" />
                <select class="uc-select" data-to-unit aria-label="Convert to unit">${optionsHtml(toSel)}</select>
              </div>
            </div>
          </div>

          <div class="uc-readout">
            <span class="uc-readout-eq" data-readout>Enter a value to convert</span>
            <button type="button" class="uc-copy" data-copy aria-label="Copy result" title="Copy result">${COPY_ICON}</button>
          </div>

          ${isCurrency ? '<p class="uc-note" data-note></p>' : ''}

          <div class="uc-common">
            <span class="eyebrow">${isCurrency ? 'Major currencies' : 'Quick conversions'}</span>
            <ul class="uc-chips" data-common></ul>
          </div>
        </div>
      `;

      const fromEl = bodyEl.querySelector<HTMLInputElement>('[data-from-val]')!;
      const toEl = bodyEl.querySelector<HTMLInputElement>('[data-to-val]')!;
      const fromUnitEl = bodyEl.querySelector<HTMLSelectElement>('[data-from-unit]')!;
      const toUnitEl = bodyEl.querySelector<HTMLSelectElement>('[data-to-unit]')!;
      const readoutEl = bodyEl.querySelector<HTMLElement>('[data-readout]')!;
      const commonEl = bodyEl.querySelector<HTMLElement>('[data-common]')!;
      const noteEl = bodyEl.querySelector<HTMLElement>('[data-note]');
      const copyBtn = bodyEl.querySelector<HTMLElement>('[data-copy]')!;

      let source: Side = saved?.source ?? 'from';

      const unit = (id: string): Unit => cat.units.find((u) => u.id === id) ?? cat.units[0];
      const conv = (v: number, from: string, to: string): number =>
        isCurrency ? convertCurrency(v, from, to, rates) : convertUnit(v, unit(from), unit(to));

      const label = (v: number, u: Unit): string => (Math.abs(v) === 1 ? u.name : u.plural);

      function updateReadout(): void {
        const fv = parse(fromEl.value);
        const tv = parse(toEl.value);
        if (!Number.isFinite(fv) || !Number.isFinite(tv)) {
          readoutEl.textContent = 'Enter a value to convert';
          return;
        }
        if (isCurrency) {
          readoutEl.textContent = `${formatValue(fv)} ${fromUnitEl.value} = ${formatValue(tv)} ${toUnitEl.value}`;
        } else {
          const f = unit(fromUnitEl.value);
          const t = unit(toUnitEl.value);
          readoutEl.textContent = `${formatValue(fv)} ${label(fv, f)} = ${formatValue(tv)} ${label(tv, t)}`;
        }
      }

      function updateCommon(): void {
        const v = parse(fromEl.value);
        const fromKey = fromUnitEl.value;
        let targets: { val: string; unit: string; name: string }[];
        if (isCurrency) {
          const majors = ['USD', 'EUR', 'GBP', 'INR', 'JPY', 'CNY', 'AUD', 'CAD'].filter((c) => c !== fromKey).slice(0, 6);
          targets = majors.map((code) => {
            const c = currencies.find((x) => x.code === code)!;
            return { val: Number.isFinite(v) ? formatValue(convertCurrency(v, fromKey, code, rates)) : '—', unit: code, name: c.name };
          });
        } else {
          const from = unit(fromKey);
          targets = cat.units
            .filter((u) => u.id !== from.id)
            .slice(0, 6)
            .map((u) => ({ val: Number.isFinite(v) ? formatValue(convertUnit(v, from, u)) : '—', unit: u.symbol, name: u.name }));
        }
        commonEl.innerHTML = targets
          .map((t) => `<li class="uc-chip" title="${esc(t.name)}"><span class="uc-chip-val">${esc(t.val)}</span><span class="uc-chip-unit">${esc(t.unit)}</span></li>`)
          .join('');
      }

      function updateNote(): void {
        if (!noteEl) return;
        if (ratesLive && ratesDate) {
          noteEl.textContent = `Live mid-market rates · updated ${ratesDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}. For information only.`;
        } else {
          noteEl.textContent = 'Showing indicative rates. Live rates will load if your connection allows.';
        }
      }

      function persist(): void {
        saveState(`convert:${cat.id}`, {
          from: fromUnitEl.value,
          to: toUnitEl.value,
          val: source === 'from' ? fromEl.value : toEl.value,
          source,
        });
      }

      function recompute(): void {
        if (source === 'from') {
          const v = parse(fromEl.value);
          toEl.value = Number.isFinite(v) ? plain(conv(v, fromUnitEl.value, toUnitEl.value)) : '';
        } else {
          const v = parse(toEl.value);
          fromEl.value = Number.isFinite(v) ? plain(conv(v, toUnitEl.value, fromUnitEl.value)) : '';
        }
        updateReadout();
        updateCommon();
        updateNote();
        persist();
      }

      fromEl.addEventListener('input', () => { source = 'from'; recompute(); });
      toEl.addEventListener('input', () => { source = 'to'; recompute(); });
      fromUnitEl.addEventListener('change', recompute);
      toUnitEl.addEventListener('change', recompute);

      bodyEl.querySelector<HTMLButtonElement>('[data-swap]')!.addEventListener('click', () => {
        const uf = fromUnitEl.value;
        fromUnitEl.value = toUnitEl.value;
        toUnitEl.value = uf;
        const vf = fromEl.value;
        fromEl.value = toEl.value;
        toEl.value = vf;
        // The authoritative number moved to the opposite side.
        source = source === 'from' ? 'to' : 'from';
        recompute();
      });

      copyBtn.addEventListener('click', () => copyWithFeedback(copyBtn, toEl.value.trim()));

      // Seed the authoritative field, then derive the other.
      if (source === 'from') fromEl.value = seedVal;
      else toEl.value = seedVal;
      recompute();

      if (isCurrency) {
        updateNote();
        // Once live rates arrive, re-derive the current conversion with them.
        refreshRates(() => recompute());
      }
    }

    // ---- BMI tab --------------------------------------------------------
    function buildBmi(): void {
      const saved = loadState<{ system: string; cm: string; kg: string; ft: string; inch: string; lb: string }>('convert:bmi') ?? {
        system: 'metric', cm: '175', kg: '70', ft: '5', inch: '9', lb: '154',
      };
      let system: 'metric' | 'imperial' = saved.system === 'imperial' ? 'imperial' : 'metric';

      const fieldsHtml = (): string =>
        system === 'metric'
          ? `
            <label class="uc-cell">
              <span class="uc-flabel">Height</span>
              <div class="uc-inputrow uc-inputrow-suffix"><input class="uc-input" data-cm type="text" inputmode="decimal" value="${esc(saved.cm)}" /><span class="uc-suffix">cm</span></div>
            </label>
            <label class="uc-cell">
              <span class="uc-flabel">Weight</span>
              <div class="uc-inputrow uc-inputrow-suffix"><input class="uc-input" data-kg type="text" inputmode="decimal" value="${esc(saved.kg)}" /><span class="uc-suffix">kg</span></div>
            </label>`
          : `
            <label class="uc-cell">
              <span class="uc-flabel">Height</span>
              <div class="uc-inputrow uc-inputrow-split">
                <span class="uc-splitfield"><input class="uc-input" data-ft type="text" inputmode="numeric" value="${esc(saved.ft)}" /><span class="uc-suffix">ft</span></span>
                <span class="uc-splitfield"><input class="uc-input" data-in type="text" inputmode="numeric" value="${esc(saved.inch)}" /><span class="uc-suffix">in</span></span>
              </div>
            </label>
            <label class="uc-cell">
              <span class="uc-flabel">Weight</span>
              <div class="uc-inputrow uc-inputrow-suffix"><input class="uc-input" data-lb type="text" inputmode="decimal" value="${esc(saved.lb)}" /><span class="uc-suffix">lb</span></div>
            </label>`;

      bodyEl.innerHTML = `
        <div class="uc-bmi">
          <div class="uc-seg" role="radiogroup" aria-label="Measurement system">
            <button type="button" class="uc-seg-btn${system === 'metric' ? ' is-active' : ''}" data-sys="metric" aria-pressed="${system === 'metric'}">Metric</button>
            <button type="button" class="uc-seg-btn${system === 'imperial' ? ' is-active' : ''}" data-sys="imperial" aria-pressed="${system === 'imperial'}">Imperial</button>
          </div>
          <div class="uc-pair uc-bmi-fields" data-bmi-fields>${fieldsHtml()}</div>
          <div class="uc-readout uc-bmi-readout">
            <div class="uc-bmi-score"><span data-bmi-value>—</span><span class="uc-bmi-tag">BMI</span></div>
            <span class="uc-bmi-cat" data-bmi-cat>Enter your details</span>
          </div>
          <div class="uc-scale" aria-hidden="true">
            <div class="uc-scale-track">
              <span class="uc-scale-seg" style="flex:3.5;background:var(--color-warning)"></span>
              <span class="uc-scale-seg" style="flex:6.5;background:var(--color-cyan)"></span>
              <span class="uc-scale-seg" style="flex:5;background:var(--color-warning)"></span>
              <span class="uc-scale-seg" style="flex:10;background:var(--color-error)"></span>
              <span class="uc-scale-marker" data-bmi-marker hidden></span>
            </div>
            <div class="uc-scale-labels"><span>15</span><span>18.5</span><span>25</span><span>30</span><span>40</span></div>
          </div>
        </div>
      `;

      const fieldsWrap = bodyEl.querySelector<HTMLElement>('[data-bmi-fields]')!;
      const valueEl = bodyEl.querySelector<HTMLElement>('[data-bmi-value]')!;
      const catEl = bodyEl.querySelector<HTMLElement>('[data-bmi-cat]')!;
      const markerEl = bodyEl.querySelector<HTMLElement>('[data-bmi-marker]')!;

      function readCurrent(): { system: string; cm: string; kg: string; ft: string; inch: string; lb: string } {
        const get = (sel: string) => bodyEl.querySelector<HTMLInputElement>(sel)?.value ?? '';
        return {
          system,
          cm: system === 'metric' ? get('[data-cm]') : saved.cm,
          kg: system === 'metric' ? get('[data-kg]') : saved.kg,
          ft: system === 'imperial' ? get('[data-ft]') : saved.ft,
          inch: system === 'imperial' ? get('[data-in]') : saved.inch,
          lb: system === 'imperial' ? get('[data-lb]') : saved.lb,
        };
      }

      function compute(): void {
        let kg = NaN;
        let m = NaN;
        if (system === 'metric') {
          kg = parse(bodyEl.querySelector<HTMLInputElement>('[data-kg]')!.value);
          m = parse(bodyEl.querySelector<HTMLInputElement>('[data-cm]')!.value) / 100;
        } else {
          kg = parse(bodyEl.querySelector<HTMLInputElement>('[data-lb]')!.value) * 0.45359237;
          const ft = parse(bodyEl.querySelector<HTMLInputElement>('[data-ft]')!.value) || 0;
          const inch = parse(bodyEl.querySelector<HTMLInputElement>('[data-in]')!.value) || 0;
          m = (ft * 12 + inch) * 0.0254;
        }
        Object.assign(saved, readCurrent());
        saveState('convert:bmi', saved);

        const bmi = kg / (m * m);
        if (!Number.isFinite(bmi) || bmi <= 0 || m <= 0) {
          valueEl.textContent = '—';
          catEl.textContent = 'Enter your details';
          catEl.className = 'uc-bmi-cat';
          markerEl.hidden = true;
          return;
        }
        valueEl.textContent = bmi.toFixed(1);
        let tone = 'success';
        let name = 'Normal weight';
        if (bmi < 18.5) { tone = 'warning'; name = 'Underweight'; }
        else if (bmi < 25) { tone = 'success'; name = 'Normal weight'; }
        else if (bmi < 30) { tone = 'warning'; name = 'Overweight'; }
        else { tone = 'error'; name = 'Obese'; }
        catEl.textContent = name;
        catEl.className = `uc-bmi-cat is-${tone}`;
        const clamped = Math.min(40, Math.max(15, bmi));
        markerEl.hidden = false;
        markerEl.style.left = `${((clamped - 15) / 25) * 100}%`;
      }

      fieldsWrap.addEventListener('input', compute);

      bodyEl.querySelectorAll<HTMLButtonElement>('[data-sys]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = btn.dataset.sys as 'metric' | 'imperial';
          if (next === system) return;
          Object.assign(saved, readCurrent());
          system = next;
          bodyEl.querySelectorAll<HTMLButtonElement>('[data-sys]').forEach((b) => {
            const on = b.dataset.sys === system;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', String(on));
          });
          fieldsWrap.innerHTML = fieldsHtml();
          compute();
        });
      });

      compute();
    }

    function activate(catId: string, focusTab = false): void {
      tabButtons.forEach((b) => {
        const on = b.dataset.cat === catId;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focusTab) b.focus();
      });
      bodyEl.setAttribute('aria-labelledby', `uc-tab-${catId}`);
      saveState('convert:active', catId);
      if (catId === 'bmi') buildBmi();
      else buildConverter(catById.get(catId)!);
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => activate(btn.dataset.cat!));
    });

    // Roving-tabindex arrow-key navigation across the tablist.
    tabsEl.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const idx = tabButtons.findIndex((b) => b.getAttribute('aria-selected') === 'true');
      const next = e.key === 'ArrowRight' ? (idx + 1) % tabButtons.length : (idx - 1 + tabButtons.length) % tabButtons.length;
      activate(tabButtons[next].dataset.cat!, true);
    });

    // A page-level `data-initial` (dedicated converter pages) wins over the
    // last-used tab so /unit-converter/weight always opens on Weight.
    const forced = root.dataset.initial;
    const isValid = (id: string | undefined): id is string =>
      typeof id === 'string' && (catById.has(id) || id === 'bmi');
    const stored = loadState<string>('convert:active');
    const startId = isValid(forced) ? forced : isValid(stored ?? undefined) ? (stored as string) : 'length';
    activate(startId);
  }

  document.querySelectorAll<HTMLElement>('[data-unit-converter]').forEach(mount);
</script>

<style>
  .uc {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ---- Tab row ---- */
  .uc-tabs {
    display: flex;
    gap: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
    -webkit-overflow-scrolling: touch;
  }
  .uc-tabs::-webkit-scrollbar { display: none; }
  .uc-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: 0 0 auto;
    padding: 0.5rem 0.875rem;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-body);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.06s ease;
  }
  .uc-tab svg { flex: 0 0 auto; }
  .uc-tab:hover { color: var(--color-ink); }
  .uc-tab:active { transform: scale(0.97); }
  .uc-tab[aria-selected='true'] {
    color: var(--color-on-primary);
    background-color: var(--color-ink);
    box-shadow: none;
  }

  /* ---- Body / skeleton ---- */
  .uc-body { min-height: 260px; }
  .uc-skeleton {
    height: 240px;
    border-radius: var(--radius-md);
    background: linear-gradient(100deg, var(--color-canvas-soft) 30%, var(--color-canvas-soft-2) 50%, var(--color-canvas-soft) 70%);
    background-size: 200% 100%;
    animation: uc-shimmer 1.2s ease-in-out infinite;
  }
  @keyframes uc-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

  .uc-noscript {
    margin: 0;
    padding: 0.875rem 1rem;
    font-size: 14px;
    color: var(--color-body);
    background-color: var(--color-canvas-soft);
    border: 1px dashed var(--color-hairline-strong);
    border-radius: var(--radius-md);
  }

  /* ---- Convert / BMI shared field layout (built at runtime → :global) ---- */
  .uc-body :global(.uc-convert),
  .uc-body :global(.uc-bmi) {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .uc-body :global(.uc-pair) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 0.75rem;
  }
  .uc-body :global(.uc-cell) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .uc-body :global(.uc-flabel) {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-mute);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .uc-body :global(.uc-inputrow) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .uc-body :global(.uc-input) {
    width: 100%;
    height: 52px;
    padding-inline: 0.875rem;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    transition: box-shadow 0.15s ease;
