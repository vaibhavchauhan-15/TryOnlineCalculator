---
// SIP / Lumpsum calculator with sliders, editable value chips and an optional
// annual step-up. Laid out as a compact dashboard — controls beside a live
// result summary, with a projected-growth line chart and an invested-vs-returns
// donut below — so it mirrors the finance form calculators (mortgage, loan,
// investment) and fits on one screen. It reuses the shared SVG chart renderer
// and the global .result-* result styling, so it follows the design system and
// the light / dark theme automatically.
import CalculateButton from './CalculateButton.astro';
import CurrencySelect from './CurrencySelect.astro';

interface Props {
  storeKey?: string;
}
const { storeKey } = Astro.props;
---

<div class="calc-device is-wide sip" data-sip data-store={storeKey ? `sip:${storeKey}` : undefined}>
  <!-- Top bar: mode toggle (left) + currency picker (right) -->
  <div class="sip-head">
    <div class="sip-toggle" role="tablist" aria-label="Investment type">
      <button type="button" class="sip-tab is-active" data-mode="sip" role="tab" aria-selected="true">SIP</button>
      <button type="button" class="sip-tab" data-mode="lumpsum" role="tab" aria-selected="false">Lumpsum</button>
      <span class="sip-toggle-pill" aria-hidden="true"></span>
    </div>
    <CurrencySelect />
  </div>

  <div class="sip-body">
    <!-- Controls column -->
    <div class="sip-controls">
      <!-- Investment amount -->
      <div class="sip-row">
        <div class="sip-row-head">
          <label class="sip-label" data-label-amount for="sip-amount">Monthly investment</label>
          <div class="sip-chip">
            <span class="sip-chip-affix" data-cur-prefix>₹</span>
            <input id="sip-amount" class="sip-chip-input sip-w-amount" data-amount type="text" inputmode="numeric" aria-label="Investment amount" />
          </div>
        </div>
        <input class="sip-slider" data-amount-slider type="range" min="500" max="1000000" step="500" value="25000" aria-label="Investment amount slider" />
      </div>

      <!-- Expected return rate -->
      <div class="sip-row">
        <div class="sip-row-head">
          <label class="sip-label" for="sip-rate">Expected return rate (p.a)</label>
          <div class="sip-chip">
            <input id="sip-rate" class="sip-chip-input sip-w-rate" data-rate type="text" inputmode="decimal" aria-label="Expected return rate" />
            <span class="sip-chip-affix">%</span>
          </div>
        </div>
        <input class="sip-slider" data-rate-slider type="range" min="1" max="30" step="0.5" value="12" aria-label="Expected return rate slider" />
      </div>

      <!-- Time period -->
      <div class="sip-row">
        <div class="sip-row-head">
          <label class="sip-label" for="sip-years">Time period</label>
          <div class="sip-chip">
            <input id="sip-years" class="sip-chip-input sip-w-years" data-years type="text" inputmode="numeric" aria-label="Time period in years" />
            <span class="sip-chip-affix">Yr</span>
          </div>
        </div>
        <input class="sip-slider" data-years-slider type="range" min="1" max="40" step="1" value="10" aria-label="Time period slider" />
      </div>

      <!-- Annual step-up (SIP only) -->
      <div class="sip-row sip-row-stepup" data-stepup-row>
        <div class="sip-row-head">
          <label class="sip-label sip-label-toggle" for="sip-stepup-enable">
            <input id="sip-stepup-enable" type="checkbox" class="sip-check" data-stepup-enable />
            <span>Annual step-up</span>
          </label>
          <div class="sip-chip">
            <input class="sip-chip-input sip-w-step" data-stepup type="text" inputmode="numeric" aria-label="Annual step-up percentage" />
            <span class="sip-chip-affix">%</span>
          </div>
        </div>
        <input class="sip-slider" data-stepup-slider type="range" min="0" max="25" step="1" value="10" aria-label="Annual step-up slider" />
      </div>
    </div>

    <!-- Result summary column (mirrors the finance form calculators) -->
    <div class="sip-summary">
      <div class="result-primary">
        <span class="result-primary-label">Total value</span>
        <span class="result-primary-value" data-total>&#8212;</span>
        <span class="result-primary-hint" data-hint>At the end of the plan</span>
        <button type="button" class="result-copy" data-copy-btn aria-label="Copy result" title="Copy result">
          <span data-copy-ico><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></span>
        </button>
      </div>

      <div class="result-list">
        <div class="result-row">
          <span class="result-label"><span class="sip-dot sip-dot-invested" aria-hidden="true"></span>Invested amount</span>
          <span class="result-value" data-invested>&#8212;</span>
        </div>
        <div class="result-row is-success">
          <span class="result-label"><span class="sip-dot sip-dot-returns" aria-hidden="true"></span>Est. returns</span>
          <span class="result-value" data-returns>&#8212;</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts: projected growth (left) + invested-vs-returns donut (right).
       Both reuse the shared chart renderer used across the finance tools. -->
  <div class="sip-charts">
    <div class="sip-chart sip-chart-line" data-chart-line aria-live="off"></div>
    <div class="sip-chart sip-chart-pie" data-chart aria-live="off"></div>
  </div>

  <CalculateButton />

  <div data-history-mount></div>
</div>

<script>
  import { renderChart } from '../lib/charts';
  import { formatCurrency, subscribeCurrency } from '../lib/currency';
  import { number } from '../lib/format';
  import { loadState, saveState } from '../lib/storage';
  import { createHistoryUI, copyWithFeedback, wireCalculateButton } from '../lib/history';
  import { animateValue } from '../lib/countup';
  import { haptic } from '../lib/haptics';

  type Mode = 'sip' | 'lumpsum';
  interface Saved {
    mode: Mode;
    amount: number;
    rate: number;
    years: number;
    stepUp: number;
    stepUpOn: boolean;
  }

  // Slider bounds differ per mode: a monthly SIP tops out lower than a one-off
  // lumpsum. Kept here so the slider + typed-value clamps stay in sync.
  const AMOUNT_RANGE: Record<Mode, { min: number; max: number; step: number }> = {
    sip: { min: 500, max: 1_000_000, step: 500 },
    lumpsum: { min: 1_000, max: 100_000_000, step: 1_000 },
  };

  const clamp = (n: number, lo: number, hi: number) => Math.min(Math.max(n, lo), hi);

  /** SIP future value. Contributions are made at the start of each month
   *  (annuity-due), matching the standard SIP formula. An optional annual
   *  step-up raises the monthly amount by `stepUp`% after every 12 months. */
  function computeSip(monthly: number, annualRate: number, years: number, stepUp: number) {
    // Effective monthly rate: convert the annual return so that compounding it
    // for 12 months reproduces the annual rate exactly. Using annualRate/12
    // (a nominal rate) over-states the result because it compounds to more than
    // the stated annual return. This matches how Groww and most SIP tools work.
    const i = Math.pow(1 + annualRate / 100, 1 / 12) - 1;
    const months = Math.round(years * 12);
    if (!(monthly > 0) || months <= 0) return { invested: 0, gains: 0, total: 0 };

    if (stepUp > 0) {
      const g = stepUp / 100;
      let fv = 0;
      let invested = 0;
      let amt = monthly;
      for (let y = 0; y < years; y++) {
        for (let m = 0; m < 12; m++) {
          fv = (fv + amt) * (1 + i);
          invested += amt;
        }
        amt *= 1 + g;
      }
      return { invested, gains: fv - invested, total: fv };
    }

    const invested = monthly * months;
    const fv = i === 0 ? invested : monthly * ((Math.pow(1 + i, months) - 1) / i) * (1 + i);
    return { invested, gains: fv - invested, total: fv };
  }

  /** Lumpsum future value: a single sum compounding annually. */
  function computeLumpsum(principal: number, annualRate: number, years: number) {
    if (!(principal > 0) || years <= 0) return { invested: principal || 0, gains: 0, total: principal || 0 };
    const total = principal * Math.pow(1 + annualRate / 100, years);
    return { invested: principal, gains: total - principal, total };
  }

  function mount(root: HTMLElement): void {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.sip-tab'));
    const amountInput = q<HTMLInputElement>('[data-amount]');
    const amountSlider = q<HTMLInputElement>('[data-amount-slider]');
    const rateInput = q<HTMLInputElement>('[data-rate]');
    const rateSlider = q<HTMLInputElement>('[data-rate-slider]');
    const yearsInput = q<HTMLInputElement>('[data-years]');
    const yearsSlider = q<HTMLInputElement>('[data-years-slider]');
    const stepUpInput = q<HTMLInputElement>('[data-stepup]');
    const stepUpSlider = q<HTMLInputElement>('[data-stepup-slider]');
    const stepUpEnable = q<HTMLInputElement>('[data-stepup-enable]');
    const stepUpRow = q<HTMLElement>('[data-stepup-row]');
    const amountLabel = q('[data-label-amount]');
    const hintEl = q('[data-hint]');

    const chartEl = q('[data-chart]');
    const chartLineEl = q('[data-chart-line]');
    const investedEl = q('[data-invested]');
    const returnsEl = q('[data-returns]');
    const totalEl = q('[data-total]');

    const store = root.dataset.store;

    let mode: Mode = 'sip';
    let amount = 25000;
    let rate = 12;
    let years = 10;
    let stepUp = 10;
    let stepUpOn = false;

    // History + copy.
    const historyMount = root.querySelector<HTMLElement>('[data-history-mount]');
    const history = historyMount && store ? createHistoryUI({ key: store, mount: historyMount }) : null;
    const copyBtn = root.querySelector<HTMLElement>('[data-copy-btn]');
    const summaryText = () =>
      `Total ${totalEl.textContent} — invested ${investedEl.textContent}, returns ${returnsEl.textContent}`;
    copyBtn?.addEventListener('click', () => copyWithFeedback(copyBtn, summaryText()));

    const persist = () => {
      if (store) saveState(store, { mode, amount, rate, years, stepUp, stepUpOn } satisfies Saved);
    };

    // Paint a slider's filled portion (left of the thumb) using a CSS var so
    // the track shows progress in the accent colour.
    function paintSlider(el: HTMLInputElement): void {
      const min = Number(el.min);
      const max = Number(el.max);
      const val = Number(el.value);
      const pct = max > min ? ((val - min) / (max - min)) * 100 : 0;
      el.style.setProperty('--fill', `${pct}%`);
    }

    // Show a plain (ungrouped) integer/decimal in the editable chip while it's
    // not focused; the grouped, currency-formatted figures live in the results.
    const setChip = (el: HTMLInputElement, val: number, decimals = 0) => {
      if (document.activeElement === el) return; // don't fight the user's caret
      el.value = decimals > 0 ? String(val) : String(Math.round(val));
    };

    function syncInputsFromState(): void {
      const ar = AMOUNT_RANGE[mode];
      amountSlider.min = String(ar.min);
      amountSlider.max = String(ar.max);
      amountSlider.step = String(ar.step);
      amount = clamp(amount, ar.min, ar.max);

      amountSlider.value = String(amount);
      rateSlider.value = String(rate);
      yearsSlider.value = String(years);
      stepUpSlider.value = String(stepUp);

      setChip(amountInput, amount);
      setChip(rateInput, rate, 1);
      setChip(yearsInput, years);
      setChip(stepUpInput, stepUp);
      stepUpEnable.checked = stepUpOn;

      [amountSlider, rateSlider, yearsSlider, stepUpSlider].forEach(paintSlider);

      amountLabel.textContent = mode === 'sip' ? 'Monthly investment' : 'Total investment';
      hintEl.textContent = mode === 'sip' ? 'At the end of the plan' : 'One-time investment';
      // Step-up only applies to a recurring SIP.
      stepUpRow.hidden = mode !== 'sip';
      stepUpRow.classList.toggle('is-disabled', !stepUpOn);
      stepUpSlider.disabled = !stepUpOn;
      stepUpInput.disabled = !stepUpOn;
    }

    function roll(el: HTMLElement, text: string, animate: boolean): void {
      const prev = el.textContent;
      el.textContent = text;
      if (animate) animateValue(el, prev);
    }

    /** Year-by-year invested capital vs total value, for the growth line chart.
     *  Mirrors the calculator's own compute() so the chart and the headline
     *  figures always agree. */
    function buildSeries(effStepUp: number) {
      const yrs = Math.max(1, Math.round(years));
      const yearLabels: string[] = ['0'];
      const investedPts: number[] = [mode === 'lumpsum' ? amount : 0];
      const valuePts: number[] = [mode === 'lumpsum' ? amount : 0];

      if (mode === 'lumpsum') {
        for (let y = 1; y <= yrs; y++) {
          yearLabels.push(String(y));
          investedPts.push(amount);
          valuePts.push(amount * Math.pow(1 + rate / 100, y));
        }
      } else {
        const i = Math.pow(1 + rate / 100, 1 / 12) - 1;
        const g = effStepUp / 100;
        let fv = 0;
        let put = 0;
        let monthly = amount;
        for (let y = 0; y < yrs; y++) {
          for (let m = 0; m < 12; m++) {
            fv = (fv + monthly) * (1 + i);
            put += monthly;
          }
          monthly *= 1 + g;
          yearLabels.push(String(y + 1));
          investedPts.push(put);
          valuePts.push(fv);
        }
      }
      return { yearLabels, investedPts, valuePts };
    }

    function update(animate = false): void {
      const effectiveStepUp = mode === 'sip' && stepUpOn ? stepUp : 0;
      const r =
        mode === 'sip'
          ? computeSip(amount, rate, years, effectiveStepUp)
          : computeLumpsum(amount, rate, years);

      roll(investedEl, formatCurrency(r.invested, { decimals: 0 }), animate);
      roll(returnsEl, formatCurrency(Math.max(r.gains, 0), { decimals: 0 }), animate);
      roll(totalEl, formatCurrency(r.total, { decimals: 0 }), animate);

      // Both charts reuse the shared renderer used by the mortgage / loan /
      // investment calculators, so they match the rest of the site exactly.
      if (r.total > 0) {
        const s = buildSeries(effectiveStepUp);
        chartLineEl.innerHTML =
          s.valuePts.length > 1
            ? renderChart({
                type: 'line',
                title: 'Projected growth',
                format: 'currency',
                labels: s.yearLabels,
                series: [
                  { label: 'Total value', points: s.valuePts, color: '#50e3c2' },
                  { label: 'Invested', points: s.investedPts, color: '#0070f3' },
                ],
              })
            : '';

        chartEl.innerHTML = renderChart({
          type: 'pie',
          title: 'Invested vs returns',
          format: 'currency',
          slices: [
            { label: 'Invested amount', value: r.invested, color: '#0070f3' },
            { label: 'Est. returns', value: Math.max(r.gains, 0), color: '#50e3c2' },
          ],
        });
      } else {
        chartEl.innerHTML = '';
        chartLineEl.innerHTML = '';
      }

      persist();
    }

    const commit = () => history?.record(sipExpr(), totalEl.textContent?.trim() ?? '') ?? false;
    function sipExpr(): string {
      if (mode === 'lumpsum') return `Lumpsum ${formatCurrency(amount, { decimals: 0 })} @ ${number(rate, 1)}% · ${years}y`;
      const su = stepUpOn && stepUp > 0 ? ` +${stepUp}%/yr` : '';
      return `SIP ${formatCurrency(amount, { decimals: 0 })}/mo${su} @ ${number(rate, 1)}% · ${years}y`;
    }

    // ---- Wiring: sliders drive state (live, no count-up so drags feel fluid).
    const bindSlider = (el: HTMLInputElement, set: (v: number) => void) => {
      el.addEventListener('input', () => {
        set(Number(el.value));
        paintSlider(el);
        // Mirror to the chip unless the user is editing it directly.
        update(false);
        syncChipFrom(el, set);
      });
    };
    // Keep the paired text chip current as the slider moves.
    function syncChipFrom(slider: HTMLInputElement, _set: (v: number) => void): void {
      if (slider === amountSlider) setChip(amountInput, amount);
      else if (slider === rateSlider) setChip(rateInput, rate, 1);
      else if (slider === yearsSlider) setChip(yearsInput, years);
      else if (slider === stepUpSlider) setChip(stepUpInput, stepUp);
    }

    bindSlider(amountSlider, (v) => (amount = v));
    bindSlider(rateSlider, (v) => (rate = v));
    bindSlider(yearsSlider, (v) => (years = v));
    bindSlider(stepUpSlider, (v) => (stepUp = v));

    // Subtle tactile tick on release, like the rest of the calculators.
    [amountSlider, rateSlider, yearsSlider, stepUpSlider].forEach((el) =>
      el.addEventListener('change', () => haptic.tap()),
    );

    // ---- Wiring: editable chips (typed values). Parse loosely while typing,
    // clamp + reflect to the slider on blur so the thumb never lies.
    const bindChip = (
      el: HTMLInputElement,
      slider: HTMLInputElement,
      set: (v: number) => void,
      opts: { decimals?: number } = {},
    ) => {
      el.addEventListener('input', () => {
        const clean = el.value.replace(opts.decimals ? /[^0-9.]/g : /[^0-9]/g, '');
        if (clean !== el.value) el.value = clean;
        const parsed = parseFloat(clean);
        if (Number.isFinite(parsed)) {
          set(clamp(parsed, Number(slider.min), Number(slider.max)));
          slider.value = String(clamp(parsed, Number(slider.min), Number(slider.max)));
          paintSlider(slider);
          update(false);
        }
      });
      el.addEventListener('focus', () => el.select());
      el.addEventListener('blur', () => {
        syncInputsFromState();
        update(false);
      });
    };

    bindChip(amountInput, amountSlider, (v) => (amount = v));
    bindChip(rateInput, rateSlider, (v) => (rate = v), { decimals: 1 });
    bindChip(yearsInput, yearsSlider, (v) => (years = v));
    bindChip(stepUpInput, stepUpSlider, (v) => (stepUp = v));

    // ---- Step-up enable toggle.
    stepUpEnable.addEventListener('change', () => {
      stepUpOn = stepUpEnable.checked;
      haptic.tap();
      syncInputsFromState();
      update(true);
    });

    // ---- Mode toggle (SIP / Lumpsum).
    function activateMode(m: Mode): void {
      mode = m;
      tabs.forEach((t) => {
        const on = (t.dataset.mode as Mode) === m;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      root.dataset.mode = m;
      haptic.tap();
      syncInputsFromState();
      update(true);
    }
    tabs.forEach((t) => t.addEventListener('click', () => activateMode(t.dataset.mode as Mode)));

    // Commit to history on the explicit Calculate press.
    wireCalculateButton(root, () => {
      update(false);
      return commit();
    });

    // Re-format money when the display currency changes anywhere on the page.
    subscribeCurrency(() => update(false));

    // Restore a previous session.
    const saved = store ? loadState<Saved>(store) : null;
    if (saved) {
      mode = saved.mode === 'lumpsum' ? 'lumpsum' : 'sip';
      if (Number.isFinite(saved.amount)) amount = saved.amount;
      if (Number.isFinite(saved.rate)) rate = saved.rate;
      if (Number.isFinite(saved.years)) years = saved.years;
      if (Number.isFinite(saved.stepUp)) stepUp = saved.stepUp;
      stepUpOn = Boolean(saved.stepUpOn);
    }
    tabs.forEach((t) => {
      const on = (t.dataset.mode as Mode) === mode;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
    });
    root.dataset.mode = mode;
    syncInputsFromState();
    update(false);
  }

  document.querySelectorAll<HTMLElement>('[data-sip]').forEach(mount);
</script>

<style>
  .sip { gap: clamp(0.7rem, 1.5vh, 1rem); max-width: 700px; padding: clamp(0.95rem, 1.8vh, 1.2rem); }

  /* ---- Top bar: mode toggle (left) + currency picker (right) ---- */
  .sip-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  /* Keep the currency chip compact and hugging the top-right corner on every
     screen size (the picker otherwise stretches to full width on phones). */
  .sip-head :global(.curp) { flex: 0 0 auto; width: auto; }
  .sip-head :global(.curp--chip .curp-trigger) { width: auto; }

  .sip-toggle {
    position: relative;
    display: inline-flex;
    padding: 4px;
    background-color: var(--color-canvas-soft-2);
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .sip-tab {
    position: relative;
    z-index: 1;
    min-width: 80px;
    padding: 0.4rem 1rem;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-mute);
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  /* The sliding pill is always the brand blue, so its label is always white. */
  .sip-tab.is-active { color: #ffffff; }
  .sip-toggle-pill {
    position: absolute;
    z-index: 0;
    top: 4px;
    left: 4px;
    width: calc(50% - 4px);
    height: calc(100% - 8px);
    background-color: var(--color-link);
    border-radius: var(--radius-pill);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sip[data-mode='lumpsum'] .sip-toggle-pill { transform: translateX(100%); }

  /* ---- Dashboard body: controls beside a live result summary ---- */
  .sip-body { display: grid; grid-template-columns: 1fr; gap: clamp(0.8rem, 1.6vh, 1.1rem); }
  @media (min-width: 560px) {
    .sip-body {
      grid-template-columns: minmax(0, 1fr) minmax(220px, 42%);
      gap: 1rem 1.35rem;
      align-items: start;
    }
  }

  .sip-controls { display: flex; flex-direction: column; gap: clamp(0.65rem, 1.5vh, 0.95rem); min-width: 0; }

  .sip-row { display: flex; flex-direction: column; gap: 0.45rem; }
  .sip-row-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .sip-label { font-size: 13.5px; font-weight: 500; color: var(--color-body); }

  .sip-label-toggle { display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; user-select: none; }
  .sip-check { width: 16px; height: 16px; accent-color: var(--color-link); cursor: pointer; }

  /* Editable value chip — a neutral value box that matches the site's field
     primitive (canvas inset + hairline), tinting to the accent only on focus. */
  .sip-chip {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0.3rem 0.55rem;
    background-color: var(--color-canvas-soft-2);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    transition: box-shadow 0.15s ease;
  }
  .sip-chip:focus-within { box-shadow: inset 0 0 0 1.5px var(--color-link); }
  .sip-chip-affix { font-size: 13px; font-weight: 600; color: var(--color-mute); }
  .sip-chip-input {
    min-width: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
    background: transparent;
    border: none;
    outline: none;
  }
  .sip-w-amount { width: 8ch; }
  .sip-w-rate { width: 3.5ch; }
  .sip-w-years { width: 2.5ch; }
  .sip-w-step { width: 2.5ch; }

