---
import { getHomeFaqSections } from '../lib/faq';
import { uiPack } from '../lib/i18n/ui-pack';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const sections = getHomeFaqSections(locale);
const home = uiPack(locale).home ?? {};
---

<section class="container-page section faq-section">
  <div class="section-head">
    <div>
      <span class="eyebrow">{home.faqEyebrow ?? 'Answers'}</span>
      <h2 class="section-title">{home.faqTitle ?? 'Frequently asked questions'}</h2>
    </div>
  </div>

  <div class="faq-groups">
    {sections.map((group) => (
      <div class="faq-group">
        <h3 class="faq-group-title">{group.title}</h3>
        <div class="faq">
          {group.items.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-answer" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .section { padding-top: 3.5rem; }
  .section-head { margin-bottom: 1.5rem; }
  .section-title { margin: 0.375rem 0 0; font-size: clamp(1.375rem, 3vw, 1.75rem); letter-spacing: -0.02em; }

  .faq-groups { display: flex; flex-direction: column; gap: 2.5rem; }
  .faq-group-title {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .faq { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer;
    padding: 0.875rem 1rem;
    font-size: 15px;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--color-mute); font-size: 18px; flex: none; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-answer {
    margin: 0;
    padding: 0 1rem 1rem;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-body);
  }
  .faq-answer :global(a) { color: var(--color-link); }
  .faq-answer :global(a:hover) { text-decoration: underline; }
</style>
