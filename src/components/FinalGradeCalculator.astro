---
// Guided final-grade calculator. Three plain-language sliders (each paired with
// a number box) plus one-tap target grades. Answers the real question — "what
// do I need on the final?" — with a live score + reachability status. Maths and
// result markup come from the shared final-grade-calculator compute().
import CalculateButton from './CalculateButton.astro';
import { educationCalculators } from '../lib/calculators/education';
import { renderResultsHTML } from '../lib/render';

interface Props {
  storeKey?: string;
}
const { storeKey } = Astro.props;

const defaults = { current: '88', desired: '90', weight: '25' };
const targets = [
  { label: 'A', value: '90' },
  { label: 'B', value: '80' },
  { label: 'C', value: '70' },
  { label: 'D', value: '60' },
];

const calc = educationCalculators.find((c) => c.slug === 'final-grade-calculator')!;
const initial = renderResultsHTML(calc.compute(defaults));
---

<div class="edu-calc has-visuals" data-final data-store={storeKey ? `final:${storeKey}` : undefined}>
  <div class="edu-grid">
    <div class="edu-card">
      <div class="edu-card-head">
        <span class="edu-card-title">Where you stand</span>
        <span class="edu-card-sub">Slide or type three numbers to see the score you need on the final.</span>
      </div>

      <div class="edu-slider-field" data-field="current">
        <div class="edu-slider-top">
          <span class="edu-slider-label">Current grade</span>
          <span class="edu-slider-help">Your grade before the final</span>
        </div>
        <div class="edu-slider-row">
          <input class="edu-range" data-range type="range" min="0" max="100" step="1" value={defaults.current} aria-label="Current grade" />
          <div class="edu-num-wrap">
            <input class="field" data-num type="number" min="0" max="100" step="0.1" value={defaults.current} aria-label="Current grade value" />
            <span class="edu-affix">%</span>
          </div>
        </div>
      </div>

      <div class="edu-slider-field" data-field="desired">
        <div class="edu-slider-top">
          <span class="edu-slider-label">Grade you want</span>
          <span class="edu-slider-help">Your target for the course</span>
        </div>
        <div class="edu-chips" data-targets>
          {targets.map((t) => (
            <button type="button" class={`edu-chip ${t.value === defaults.desired ? 'is-active' : ''}`} data-target={t.value}>{t.label} · {t.value}%</button>
          ))}
        </div>
        <div class="edu-slider-row">
          <input class="edu-range" data-range type="range" min="0" max="100" step="1" value={defaults.desired} aria-label="Desired grade" />
          <div class="edu-num-wrap">
            <input class="field" data-num type="number" min="0" max="100" step="0.1" value={defaults.desired} aria-label="Desired grade value" />
            <span class="edu-affix">%</span>
          </div>
        </div>
      </div>

      <div class="edu-slider-field" data-field="weight">
        <div class="edu-slider-top">
          <span class="edu-slider-label">Final exam weight</span>
          <span class="edu-slider-help">How much the final counts</span>
        </div>
        <div class="edu-slider-row">
          <input class="edu-range" data-range type="range" min="1" max="100" step="1" value={defaults.weight} aria-label="Final exam weight" />
          <div class="edu-num-wrap">
            <input class="field" data-num type="number" min="0.1" max="100" step="0.1" value={defaults.weight} aria-label="Final exam weight value" />
            <span class="edu-affix">%</span>
          </div>
        </div>
      </div>

      <CalculateButton />

      <div class="edu-actions">
        <button type="button" class="btn btn-secondary btn-sm" data-reset>Reset</button>
        <button type="button" class="btn btn-secondary btn-sm" data-copy>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

    <div class="edu-output">
      <div class="edu-output-head">
        <span class="eyebrow">Result</span>
        <span class="edu-live-hint"><span class="edu-live-dot" aria-hidden="true"></span>Updates as you type</span>
      </div>
      <div data-out set:html={initial}></div>
      <div data-history-mount></div>
    </div>
  </div>
</div>

<script>
  import { educationCalculators } from '../lib/calculators/education';
  import { renderResultsHTML } from '../lib/render';
  import { loadState, saveState, clearState } from '../lib/storage';
  import { createHistoryUI, copyWithFeedback, wireCalculateButton } from '../lib/history';

  type Saved = { current: string; desired: string; weight: string };

  const calc = educationCalculators.find((c) => c.slug === 'final-grade-calculator')!;
  const DEFAULTS: Saved = { current: '88', desired: '90', weight: '25' };

  function mount(root: HTMLElement): void {
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const store = root.dataset.store;

    const historyMount = root.querySelector<HTMLElement>('[data-history-mount]');
    const history = historyMount && store ? createHistoryUI({ key: store, mount: historyMount }) : null;

    const fields = ['current', 'desired', 'weight'] as const;
    type Field = (typeof fields)[number];
    const groups = {} as Record<Field, { range: HTMLInputElement; num: HTMLInputElement }>;
    fields.forEach((f) => {
      const g = root.querySelector<HTMLElement>(`[data-field="${f}"]`)!;
      groups[f] = {
        range: g.querySelector<HTMLInputElement>('[data-range]')!,
        num: g.querySelector<HTMLInputElement>('[data-num]')!,
      };
    });
    const targetsWrap = root.querySelector<HTMLElement>('[data-targets]')!;

    const values = (): Saved => ({
      current: groups.current.num.value.trim(),
      desired: groups.desired.num.value.trim(),
      weight: groups.weight.num.value.trim(),
    });

    const syncTargets = () => {
      const d = groups.desired.num.value.trim();
      targetsWrap.querySelectorAll<HTMLButtonElement>('[data-target]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.target === d);
      });
    };

    const update = () => {
      const v = values();
      out.innerHTML = renderResultsHTML(calc.compute(v));
      syncTargets();
      if (store) saveState(store, v satisfies Saved);
    };

    // Keep each range + number box in lock-step.
    fields.forEach((f) => {
      const { range, num } = groups[f];
      range.addEventListener('input', () => {
        num.value = range.value;
        update();
      });
      num.addEventListener('input', () => {
        const n = Number(num.value);
        if (Number.isFinite(n)) range.value = String(Math.min(Number(range.max), Math.max(Number(range.min), n)));
        update();
      });
    });

    targetsWrap.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-target]');
      if (!btn) return;
      groups.desired.num.value = btn.dataset.target!;
      groups.desired.range.value = btn.dataset.target!;
      update();
    });

    out.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-result]');
      if (!btn) return;
      void copyWithFeedback(btn, out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '');
    });

    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');
    copyBtn?.addEventListener('click', () => {
      void copyWithFeedback(copyBtn, out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '');
    });

    const setAll = (v: Saved) => {
      groups.current.num.value = v.current;
      groups.current.range.value = v.current;
      groups.desired.num.value = v.desired;
      groups.desired.range.value = v.desired;
      groups.weight.num.value = v.weight;
      groups.weight.range.value = v.weight;
    };

    root.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
      if (store) clearState(store);
      setAll(DEFAULTS);
      update();
    });

    const commit = (): boolean => {
      const value = out.querySelector('[data-primary-value]')?.textContent?.trim() ?? '';
      if (!value) return false;
      const v = values();
      return history?.record(`Need on final (want ${v.desired}%, worth ${v.weight}%)`, value) ?? false;
    };
    wireCalculateButton(root, () => {
      update();
      return commit();
    });

    const saved = store ? loadState<Saved>(store) : null;
    if (saved && saved.current !== undefined) setAll(saved);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-final]').forEach(mount);
</script>
