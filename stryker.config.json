{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/lib/format.ts",
    "src/lib/storage.ts",
    "src/lib/history.ts",
    "src/lib/analytics.ts",
    "src/lib/charts.ts",
    "src/lib/haptics.ts",
    "src/lib/rates.ts"
  ],
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text", "html"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 80
  }
}
