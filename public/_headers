# Fingerprinted build assets never change — cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts have stable filenames and effectively never change —
# cache them for a year so they're never re-fetched on repeat visits.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Block search engines from indexing pages.dev domains.
# Only the custom domain (tryonlinecalculator.com) should be indexed.
https://tryonlinecalculator.pages.dev/*
  X-Robots-Tag: noindex

https://master.tryonlinecalculator.pages.dev/*
  X-Robots-Tag: noindex

https://try-online-calculator.vercel.app/*
  X-Robots-Tag: noindex

# ── Security headers for every response ──────────────────────────────
#
# Content-Security-Policy: baseline policy that locks down sources while
# allowing the small inline scripts the site depends on (theme-before-
# paint, JSON-LD, Google Analytics loader). A stricter nonce-based CSP
# can be layered via the edge function in a follow-up.
#
# Directives breakdown:
#   default-src 'none'         — deny-by-default
#   script-src  'self' + gtag  — own JS + Google Analytics (inline needed for theme/gtag loaders)
#   style-src   'self'         — own CSS (inline needed for Astro scoped styles)
#   img-src     'self' data:   — own images + inline SVG data-URIs
#   font-src    'self'         — self-hosted Geist fonts
#   connect-src                — Frankfurter API + Google Analytics + self
#   frame-src   'none'         — no iframes allowed
#   object-src  'none'         — no Flash/Java plugins
#   base-uri    'self'         — prevent <base> hijacking
#   form-action 'self'         — forms can only submit to same origin
#   frame-ancestors 'none'     — prevent clickjacking (supersedes X-Frame-Options)
#   upgrade-insecure-requests  — force HTTPS for all sub-resources
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.frankfurter.dev https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
